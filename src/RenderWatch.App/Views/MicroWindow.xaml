<Window x:Class="RenderWatch.App.Views.MicroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RENDER WATCH Micro"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <Geometry x:Key="IconCpu">M 4,4 h 16 v 16 h -16 z M 8,8 h 8 v 8 h -8 z M 7,1 v 3 M 12,1 v 3 M 17,1 v 3 M 7,20 v 3 M 12,20 v 3 M 17,20 v 3 M 1,7 h 3 M 1,12 h 3 M 1,17 h 3 M 20,7 h 3 M 20,12 h 3 M 20,17 h 3</Geometry>
        <Geometry x:Key="IconGpu">M 2,5 h 20 v 14 h -20 z M 2,2 v 18 M 8,9 a 3,3 0 1 0 0.1,0 M 16,9 a 3,3 0 1 0 0.1,0 M 8,12 h 0.01 M 16,12 h 0.01 M 5,19 v 3 h 7 v -3</Geometry>
        <Geometry x:Key="IconRam">M 2,6 h 20 v 11 h -8 v 2 h -2 v -2 h -10 z M 4,8 h 3 v 5 h -3 z M 9,8 h 3 v 5 h -3 z M 14,8 h 3 v 5 h -3 z M 19,8 h 1 v 5 h -1 z M 3,18 h 6 M 13,18 h 7</Geometry>
    </Window.Resources>

    <Border Background="#EB0E0E0E"
            BorderThickness="0"
            CornerRadius="7"
            Padding="9,4"
            Margin="4"
            Cursor="SizeAll"
            MouseLeftButtonDown="OnBorderMouseDown"
            ToolTip="RENDER WATCH — Микро-окно (Двойной клик: развернуть, перетаскивание: переместить)">
        <Border.ContextMenu>
            <ContextMenu Background="#101010" BorderBrush="#262626" BorderThickness="1">
                <MenuItem Header="Открыть RENDER WATCH" FontWeight="Bold" Foreground="#FFFFFF" Click="OnContextMenuRestoreClicked"/>
                <Separator Background="#222222"/>
                <MenuItem Header="Свернуть в трей" Foreground="#D0D0D0" Click="OnContextMenuTrayClicked"/>
                <Separator Background="#222222"/>
                <MenuItem Header="Закрыть RENDER WATCH" Foreground="#FF6B6B" Click="OnContextMenuExitClicked"/>
            </ContextMenu>
        </Border.ContextMenu>
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.55" Color="#000000"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- App Logo Indicator -->
            <Image Source="/Assets/app.png" Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- CPU Block: Temp + Load -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,7,0" ToolTip="Процессор: Температура и Загрузка">
                <TextBlock Text="CPU" Foreground="#757575" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource FontDisplay}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Text="{Binding Dashboard.CpuTempDisplay}" Foreground="#B8B8B8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,3,0"/>
                <TextBlock Text="{Binding Dashboard.CpuUsageDisplay}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Separator -->
            <Rectangle Width="1" Height="11" Fill="#242424" Margin="0,0,7,0" VerticalAlignment="Center"/>

            <!-- GPU Block: Temp + Load -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,7,0" ToolTip="Видеокарта: Температура и Загрузка">
                <TextBlock Text="GPU" Foreground="#757575" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource FontDisplay}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Text="{Binding Dashboard.GpuTempDisplay}" Foreground="#B8B8B8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,3,0"/>
                <TextBlock Text="{Binding Dashboard.GpuUsageDisplay}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Separator -->
            <Rectangle Width="1" Height="11" Fill="#242424" Margin="0,0,7,0" VerticalAlignment="Center"/>

            <!-- RAM Block: Usage -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,7,0" ToolTip="Оперативная память">
                <TextBlock Text="RAM" Foreground="#757575" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource FontDisplay}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Text="{Binding Dashboard.RamCompactDisplay}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Separator -->
            <Rectangle Width="1" Height="11" Fill="#242424" Margin="0,0,5,0" VerticalAlignment="Center"/>

            <!-- Expand / Restore Button -->
            <Button Click="OnRestoreClicked"
                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="3,1" Margin="0,0,2,0"
                    ToolTip="Развернуть в полное окно (или двойной клик)">
                <TextBlock Text="⤢" Foreground="#777777" FontSize="11" FontWeight="Bold"/>
            </Button>

            <!-- Close / Exit Button -->
            <Button Click="OnCloseClicked"
                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="3,1"
                    ToolTip="Закрыть RENDER WATCH">
                <TextBlock Text="✕" Foreground="#555555" FontSize="9"/>
            </Button>
        </StackPanel>
    </Border>
</Window>
