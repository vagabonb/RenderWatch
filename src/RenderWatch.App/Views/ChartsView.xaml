<UserControl x:Class="RenderWatch.App.Views.ChartsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RenderWatch.App.Views">

    <Grid Margin="37,17,37,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Графики" Style="{DynamicResource PageTitle}" Margin="0,0,0,16"/>

        <!-- Polling interval -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,13">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Частота опроса" Foreground="{DynamicResource BrushTextMuted}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>

                <!-- 0.1s Button -->
                <Button Content="0,1 с"
                        Command="{Binding DataContext.SetIntervalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="0.1">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource InlineOption}">

                            <Setter Property="Margin" Value="0,0,6,0"/>


                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsIntervalTenthSec, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource WhiteInk}"/>
                                    <Setter Property="BorderBrush" Value="#F5F2EA"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- 0.5s Button -->
                <Button Content="0,5 с"
                        Command="{Binding DataContext.SetIntervalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="0.5">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource InlineOption}">

                            <Setter Property="Margin" Value="0,0,6,0"/>


                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsIntervalHalfSec, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource WhiteInk}"/>
                                    <Setter Property="BorderBrush" Value="#F5F2EA"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- 1s Button -->
                <Button Content="1 с"
                        Command="{Binding DataContext.SetIntervalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="1">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource InlineOption}">

                            <Setter Property="Margin" Value="0,0,6,0"/>


                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsInterval1Sec, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource WhiteInk}"/>
                                    <Setter Property="BorderBrush" Value="#F5F2EA"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- 3s Button -->
                <Button Content="3 с"
                        Command="{Binding DataContext.SetIntervalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="3">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource InlineOption}">

                            <Setter Property="Margin" Value="0,0,6,0"/>


                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsInterval3Sec, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource WhiteInk}"/>
                                    <Setter Property="BorderBrush" Value="#F5F2EA"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- 5s Button -->
                <Button Content="5 с"
                        Command="{Binding DataContext.SetIntervalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="5">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource InlineOption}">



                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsInterval5Sec, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource WhiteInk}"/>
                                    <Setter Property="BorderBrush" Value="#F5F2EA"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <views:ChartTabs Grid.Row="2"/>
    </Grid>
</UserControl>
