<UserControl x:Class="RenderWatch.App.Views.ChartsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:RenderWatch.App.Controls">

    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Control Bar (Polling Interval & Metric Filters) -->
        <Border Grid.Row="0" Background="{StaticResource BrushSurfaceCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="16,10" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Polling Interval Switcher -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Интервал опроса:" Foreground="{StaticResource BrushTextMuted}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <!-- 0.1s Button -->
                    <Button Content="0.1 сек"
                            Command="{Binding DataContext.SetIntervalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="0.1">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MinimalButton}">
                                <Setter Property="Padding" Value="12,5"/>
                                <Setter Property="Margin" Value="0,0,6,0"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsIntervalTenthSec, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Background" Value="#FFFFFF"/>
                                        <Setter Property="Foreground" Value="#0A0A0A"/>
                                        <Setter Property="BorderBrush" Value="#FFFFFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 0.5s Button -->
                    <Button Content="0.5 сек"
                            Command="{Binding DataContext.SetIntervalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="0.5">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MinimalButton}">
                                <Setter Property="Padding" Value="12,5"/>
                                <Setter Property="Margin" Value="0,0,6,0"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsIntervalHalfSec, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Background" Value="#FFFFFF"/>
                                        <Setter Property="Foreground" Value="#0A0A0A"/>
                                        <Setter Property="BorderBrush" Value="#FFFFFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 1s Button -->
                    <Button Content="1 сек"
                            Command="{Binding DataContext.SetIntervalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="1">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MinimalButton}">
                                <Setter Property="Padding" Value="14,5"/>
                                <Setter Property="Margin" Value="0,0,6,0"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsInterval1Sec, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Background" Value="#FFFFFF"/>
                                        <Setter Property="Foreground" Value="#0A0A0A"/>
                                        <Setter Property="BorderBrush" Value="#FFFFFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 3s Button -->
                    <Button Content="3 сек"
                            Command="{Binding DataContext.SetIntervalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="3">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MinimalButton}">
                                <Setter Property="Padding" Value="14,5"/>
                                <Setter Property="Margin" Value="0,0,6,0"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsInterval3Sec, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Background" Value="#FFFFFF"/>
                                        <Setter Property="Foreground" Value="#0A0A0A"/>
                                        <Setter Property="BorderBrush" Value="#FFFFFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 5s Button -->
                    <Button Content="5 сек"
                            Command="{Binding DataContext.SetIntervalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="5">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MinimalButton}">
                                <Setter Property="Padding" Value="14,5"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsInterval5Sec, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Background" Value="#FFFFFF"/>
                                        <Setter Property="Foreground" Value="#0A0A0A"/>
                                        <Setter Property="BorderBrush" Value="#FFFFFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Right: Graph Visibility Toggles -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <CheckBox Content="CPU %" IsChecked="{Binding ShowCpu}" Margin="0,0,14,0"/>
                    <CheckBox Content="GPU %" IsChecked="{Binding ShowGpu}" Margin="0,0,14,0"/>
                    <CheckBox Content="CPU °C" IsChecked="{Binding ShowCpuTemp}" Margin="0,0,14,0"/>
                    <CheckBox Content="GPU °C" IsChecked="{Binding ShowGpuTemp}" Margin="0,0,14,0"/>
                    <CheckBox Content="RAM %" IsChecked="{Binding ShowRam}" Margin="0,0,14,0"/>
                    <CheckBox Content="VRAM %" IsChecked="{Binding ShowVram}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Charts Grid (Dynamic Reflow: Collapsed cards compact automatically with no holes) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
            <UniformGrid Columns="2">
                <!-- CPU Usage -->
                <ctrl:MetricGraphControl Title="Нагрузка CPU"
                                         Unit="%"
                                         MaxValue="100"
                                         Capacity="{Binding GraphCapacity}"
                                         MinHeight="185"
                                         PointsSource="{Binding CpuHistory}"
                                         Visibility="{Binding ShowCpu, Converter={StaticResource BoolToVis}}"
                                         Margin="6,0,6,12"/>

                <!-- GPU Usage -->
                <ctrl:MetricGraphControl Title="Нагрузка GPU"
                                         Unit="%"
                                         MaxValue="100"
                                         Capacity="{Binding GraphCapacity}"
                                         MinHeight="185"
                                         PointsSource="{Binding GpuHistory}"
                                         Visibility="{Binding ShowGpu, Converter={StaticResource BoolToVis}}"
                                         Margin="6,0,6,12"/>

                <!-- CPU Temp -->
                <ctrl:MetricGraphControl Title="Температура CPU"
                                         Unit="°C"
                                         MaxValue="105"
                                         Capacity="{Binding GraphCapacity}"
                                         MinHeight="185"
                                         PointsSource="{Binding CpuTempHistory}"
                                         Visibility="{Binding ShowCpuTemp, Converter={StaticResource BoolToVis}}"
                                         Margin="6,0,6,12"/>

                <!-- GPU Temp -->
                <ctrl:MetricGraphControl Title="Температура GPU"
                                         Unit="°C"
                                         MaxValue="100"
                                         Capacity="{Binding GraphCapacity}"
                                         MinHeight="185"
                                         PointsSource="{Binding GpuTempHistory}"
                                         Visibility="{Binding ShowGpuTemp, Converter={StaticResource BoolToVis}}"
                                         Margin="6,0,6,12"/>

                <!-- RAM Usage -->
                <ctrl:MetricGraphControl Title="Использование RAM"
                                         Unit="%"
                                         MaxValue="100"
                                         Capacity="{Binding GraphCapacity}"
                                         MinHeight="185"
                                         PointsSource="{Binding RamHistory}"
                                         Visibility="{Binding ShowRam, Converter={StaticResource BoolToVis}}"
                                         Margin="6,0,6,12"/>

                <!-- VRAM Usage -->
                <ctrl:MetricGraphControl Title="Использование VRAM"
                                         Unit="%"
                                         MaxValue="100"
                                         Capacity="{Binding GraphCapacity}"
                                         MinHeight="185"
                                         PointsSource="{Binding VramHistory}"
                                         Visibility="{Binding ShowVram, Converter={StaticResource BoolToVis}}"
                                         Margin="6,0,6,12"/>
            </UniformGrid>
        </ScrollViewer>
    </Grid>
</UserControl>