<UserControl x:Class="RenderWatch.App.Views.NotchHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:RenderWatch.App.Controls"
             xmlns:models="clr-namespace:RenderWatch.Core.Models;assembly=RenderWatch.Core"
             xmlns:views="clr-namespace:RenderWatch.App.Views"
             Focusable="False" IsHitTestVisible="False">
    <UserControl.Resources>
        <Style x:Key="NotchSurface" TargetType="Border">
            <Setter Property="Background" Value="#191919"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBlackStyle}" Value="True">
                    <Setter Property="Background" Value="#101010"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsGraphiteStyle}" Value="True">
                    <Setter Property="Background" Value="{StaticResource GraphiteBackdrop}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Background" Value="#303030"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Background" Value="#3A3A3A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NotchValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border x:Name="RingShape" Width="{x:Static views:NotchHeader.RingWidth}" Height="34" CornerRadius="17">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource NotchSurface}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Constructor.NotchShape}" Value="{x:Static models:NotchLayout.Island}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Constructor.NotchShape}" Value="{x:Static models:NotchLayout.MemoryBar}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <ctrl:UsageRing Margin="1" StrokeThickness="2.5" Value="{Binding PrimaryNotchReading.Fill}">
                    <ctrl:UsageRing.Style>
                        <Style TargetType="ctrl:UsageRing">
                            <Setter Property="AccentBrush" Value="{Binding PrimaryNotchReading.Accent}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBlackStyle}" Value="True">
                                    <Setter Property="AccentBrush" Value="#E7E7E7"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsGraphiteStyle}" Value="True">
                                    <Setter Property="AccentBrush" Value="{StaticResource WhiteInk}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ctrl:UsageRing.Style>
                </ctrl:UsageRing>
                <TextBlock Text="{Binding PrimaryNotchReading.Text}" Style="{StaticResource NotchValue}" FontSize="10"/>
            </Grid>
        </Border>

        <Border x:Name="IslandShape" Width="{x:Static views:NotchHeader.IslandWidth}" Height="22" CornerRadius="0,0,11,11" Padding="11,0">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource NotchSurface}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Constructor.NotchShape}" Value="{x:Static models:NotchLayout.Island}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding PrimaryNotchReading.Text}" FontSize="12"
                           AutomationProperties.Name="{Binding PrimaryNotchReading.Hint}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource NotchValue}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SecondaryNotchReading.IsSet}" Value="False">
                                    <Setter Property="Grid.ColumnSpan" Value="3"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Border Grid.Column="1" Height="8" Background="#404040"
                        Visibility="{Binding SecondaryNotchReading.IsSet, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Grid.Column="2" Text="{Binding SecondaryNotchReading.Text}" Style="{StaticResource NotchValue}" FontSize="12"
                           Visibility="{Binding SecondaryNotchReading.IsSet, Converter={StaticResource BoolToVis}}"
                           AutomationProperties.Name="{Binding SecondaryNotchReading.Hint}"/>
            </Grid>
        </Border>

        <Border x:Name="MemoryBarShape" Width="{x:Static views:NotchHeader.MemoryBarWidth}" Height="11" CornerRadius="5.5" Padding="5,0"
                AutomationProperties.Name="{Binding PrimaryNotchReading.Hint}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource NotchSurface}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Constructor.NotchShape}" Value="{x:Static models:NotchLayout.MemoryBar}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ctrl:MiniBarGauge Height="3" VerticalAlignment="Center" Value="{Binding PrimaryNotchReading.Fill}">
                <ctrl:MiniBarGauge.Style>
                    <Style TargetType="ctrl:MiniBarGauge">
                        <Setter Property="UseLoadColors" Value="True"/>
                        <Setter Property="AccentColor" Value="#E7E7E7"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PrimaryNotchReading.Metric}" Value="{x:Static models:NotchRingMetric.Battery}">
                                <Setter Property="UseLoadColors" Value="False"/>
                                <Setter Property="AccentColor" Value="{Binding PrimaryNotchReading.Accent}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsBlackStyle}" Value="True">
                                <Setter Property="UseLoadColors" Value="False"/>
                                <Setter Property="AccentColor" Value="#E7E7E7"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsGraphiteStyle}" Value="True">
                                <Setter Property="UseLoadColors" Value="False"/>
                                <Setter Property="AccentColor" Value="#E7E7E7"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ctrl:MiniBarGauge.Style>
            </ctrl:MiniBarGauge>
        </Border>
    </Grid>
</UserControl>
