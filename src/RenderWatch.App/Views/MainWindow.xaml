<Window x:Class="RenderWatch.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RenderWatch.App.Views"
        xmlns:black="clr-namespace:RenderWatch.App.Views.Black"
        xmlns:vm="clr-namespace:RenderWatch.App.ViewModels"
        xmlns:ctrl="clr-namespace:RenderWatch.App.Controls"
        Title="RENDER WATCH" Icon="/RenderWatch;component/Assets/app.ico"
        Height="780" Width="1180"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource BrushBg}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- White Miniature Hardware Geometries -->
        <Geometry x:Key="IconCpu">M 4,4 h 16 v 16 h -16 z M 8,8 h 8 v 8 h -8 z M 7,1 v 3 M 12,1 v 3 M 17,1 v 3 M 7,20 v 3 M 12,20 v 3 M 17,20 v 3 M 1,7 h 3 M 1,12 h 3 M 1,17 h 3 M 20,7 h 3 M 20,12 h 3 M 20,17 h 3</Geometry>
        <Geometry x:Key="IconGpu">M 2,5 h 20 v 14 h -20 z M 2,2 v 18 M 8,9 a 3,3 0 1 0 0.1,0 M 16,9 a 3,3 0 1 0 0.1,0 M 8,12 h 0.01 M 16,12 h 0.01 M 5,19 v 3 h 7 v -3</Geometry>
        <Geometry x:Key="IconRam">M 2,6 h 20 v 11 h -8 v 2 h -2 v -2 h -10 z M 4,8 h 3 v 5 h -3 z M 9,8 h 3 v 5 h -3 z M 14,8 h 3 v 5 h -3 z M 19,8 h 1 v 5 h -1 z M 3,18 h 6 M 13,18 h 7</Geometry>
        <Geometry x:Key="IconVram">M 2,4 h 20 v 16 h -20 z M 7,8 L 12,16 L 17,8 M 5,1 h 3 v 3 h -3 z M 11,1 h 3 v 3 h -3 z M 17,1 h 3 v 3 h -3 z M 5,20 h 3 v 3 h -3 z M 11,20 h 3 v 3 h -3 z M 17,20 h 3 v 3 h -3 z</Geometry>

        <!-- Window Caption Button Styles -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#8C8C8C"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E0E0E0"/>
                                <Setter Property="Background" Value="#414243"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#3C3D3E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#F5F2EA"/>
                    <Setter Property="Background" Value="#454647"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Compact Header Button Style with HitTestVisible & Hover States -->
        <Style x:Key="CompactHeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#424344"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#363738"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="BlackInterface" Visibility="{Binding IsBlackStyle, Converter={StaticResource BoolToVis}}">
            <Grid.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RenderWatch;component/Styles/BlackTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>


        <!-- White Miniature Hardware Geometries -->
        <Geometry x:Key="IconCpu">M 4,4 h 16 v 16 h -16 z M 8,8 h 8 v 8 h -8 z M 7,1 v 3 M 12,1 v 3 M 17,1 v 3 M 7,20 v 3 M 12,20 v 3 M 17,20 v 3 M 1,7 h 3 M 1,12 h 3 M 1,17 h 3 M 20,7 h 3 M 20,12 h 3 M 20,17 h 3</Geometry>
        <Geometry x:Key="IconGpu">M 2,5 h 20 v 14 h -20 z M 2,2 v 18 M 8,9 a 3,3 0 1 0 0.1,0 M 16,9 a 3,3 0 1 0 0.1,0 M 8,12 h 0.01 M 16,12 h 0.01 M 5,19 v 3 h 7 v -3</Geometry>
        <Geometry x:Key="IconRam">M 2,6 h 20 v 11 h -8 v 2 h -2 v -2 h -10 z M 4,8 h 3 v 5 h -3 z M 9,8 h 3 v 5 h -3 z M 14,8 h 3 v 5 h -3 z M 19,8 h 1 v 5 h -1 z M 3,18 h 6 M 13,18 h 7</Geometry>
        <Geometry x:Key="IconVram">M 2,4 h 20 v 16 h -20 z M 7,8 L 12,16 L 17,8 M 5,1 h 3 v 3 h -3 z M 11,1 h 3 v 3 h -3 z M 17,1 h 3 v 3 h -3 z M 5,20 h 3 v 3 h -3 z M 11,20 h 3 v 3 h -3 z M 17,20 h 3 v 3 h -3 z</Geometry>

        <!-- Window Caption Button Styles -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#8C8C8C"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E0E0E0"/>
                                <Setter Property="Background" Value="#242424"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1A1A1A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="Background" Value="#2A2A2A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Prominent Compact Mode Button Style -->
        <Style x:Key="CompactModeActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#383838"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMain}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#252525"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#A0A0A0"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#121212"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4A4A4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact Header Button Style with HitTestVisible & Hover States -->
        <Style x:Key="CompactHeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#252525"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#181818"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        </ResourceDictionary>
    </Grid.Resources>        <!-- ========================================== -->
        <!-- 1. FULL NORMAL MODE INTERFACE               -->
        <!-- ========================================== -->
        <Grid x:Name="BlackNormalModeGrid" Background="{StaticResource BrushBg}"
              Visibility="{Binding IsCompactMode, Converter={StaticResource InverseBoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding SidebarWidth}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="2" Background="#0C0C0C"/>

            <Border Grid.Column="1" Grid.Row="0" Background="Transparent">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <views:AppearancePicker Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <Button Click="OnMinimizeToTrayClicked" Style="{StaticResource CaptionButtonStyle}" Width="33"
                                ToolTip="В трей" AutomationProperties.Name="В трей">
                            <Path Data="M 1,9 V 13 H 13 V 9 M 7,2 V 9 M 4,6 L 7,9 L 10,6" Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.15"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button Click="OnMicroModeClicked" Style="{StaticResource CaptionButtonStyle}" Width="33"
                                ToolTip="Микро" AutomationProperties.Name="Микро">
                            <Path Data="M 2,3 H 13 V 12 H 2 Z M 2,6 H 13" Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.15"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button Click="OnMinimizeToPanelClicked" Style="{StaticResource CaptionButtonStyle}" Width="33"
                                ToolTip="На панель задач" AutomationProperties.Name="На панель задач">
                            <Path Data="M 1,11 H 14 M 7,5 H 13 V 8 H 7 Z" Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.15"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button Click="OnCompactModeClicked" Style="{StaticResource CaptionButtonStyle}" Width="33"
                                ToolTip="Компактный режим" AutomationProperties.Name="Компактный режим">
                            <Path Data="M 1,3 H 13 V 11 H 1 Z M 5,4 V 10 M 9,4 V 10" Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.15"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <!-- Minimize -->
                        <Button Click="OnMinimizeClicked" Style="{StaticResource CaptionButtonStyle}" ToolTip="Свернуть">
                            <Path Data="M 0,0 L 10,0"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1"
                                  SnapsToDevicePixels="True"/>
                        </Button>

                        <!-- Maximize / Restore -->
                        <Button Click="OnMaximizeClicked" Style="{StaticResource CaptionButtonStyle}" ToolTip="Развернуть">
                            <Rectangle Width="10" Height="10"
                                       Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                       StrokeThickness="1"
                                       RadiusX="1" RadiusY="1"
                                       SnapsToDevicePixels="True"/>
                        </Button>

                        <!-- Close -->
                        <Button Click="OnCloseClicked" Style="{StaticResource CaptionCloseButtonStyle}" ToolTip="Закрыть">
                            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1"
                                  StrokeStartLineCap="Square"
                                  StrokeEndLineCap="Square"
                                  SnapsToDevicePixels="True"/>
                        </Button>
                </StackPanel>
            </Border>

            <views:SidebarNavigation Grid.Row="1" Grid.Column="0"/>

            <!-- 3. Dynamic Content View -->
            <Grid Grid.Row="1" Grid.Column="1">
                <ContentControl Content="{Binding CurrentView}">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                            <black:BlackDashboardView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:ChartsViewModel}">
                            <black:BlackChartsView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:ConfigurationViewModel}">
                            <black:BlackConfigurationView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:DisplayConstructorViewModel}">
                            <views:DisplayConstructorView/>
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>

                <!-- Toast Notification Overlay -->
                <Border Background="#323334" BorderBrush="#F5F2EA" BorderThickness="2,0,0,0" CornerRadius="6"
                        Padding="16,12" Margin="0,0,24,24"
                        Width="360"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding ToastTitle}" Foreground="#F5F2EA" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ToastMessage}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="1" Content="✕" Command="{Binding DismissToastCommand}" Style="{StaticResource MinimalButton}" Padding="6,2" VerticalAlignment="Top"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ========================================== -->
        <!-- 2. ULTRA-COMPACT FLOATING WIDGET MODE       -->
        <!-- ========================================== -->
        <Grid x:Name="BlackCompactModeGrid"
              Background="#0A0A0A"
              Visibility="{Binding IsCompactMode, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>  <!-- Compact Title Bar with drag & controls -->
                <RowDefinition Height="*"/>   <!-- 4 Compact Hardware Indicator Cards -->
            </Grid.RowDefinitions>

            <!-- Compact Title Bar -->
            <Border Grid.Row="0" Background="#121212" BorderBrush="{StaticResource BlackCardEdge}" BorderThickness="0,0,0,1">
                <Grid Margin="8,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Logo & Title (Draggable) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                Background="Transparent" MouseLeftButtonDown="OnCompactHeaderMouseDown" MouseMove="OnCompactHeaderMouseMove" Cursor="SizeAll">
                        <TextBlock Text="RENDER WATCH" Foreground="#A0A0A0" FontWeight="Bold" FontSize="10" FontFamily="{StaticResource FontDisplay}"/>
                    </StackPanel>

                    <!-- Center: Drag Area -->
                    <Border Grid.Column="1" Background="Transparent" MouseLeftButtonDown="OnCompactHeaderMouseDown" MouseMove="OnCompactHeaderMouseMove" Cursor="SizeAll"/>

                    <!-- Right: Compact Controls (WindowChrome HitTest Visible) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Pin / Always On Top Toggle -->
                        <Button Click="OnToggleTopmostClicked"
                                Style="{StaticResource CompactHeaderBtn}"
                                ToolTip="Закрепить поверх всех окон">
                            <TextBlock Text="📌" FontSize="11"
                                       Foreground="{Binding IsCompactTopmost, Converter={StaticResource HexToBrush}, ConverterParameter='#FFFFFF:#707070'}"/>
                        </Button>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- Compact Content -->
            <Border Grid.Row="1" Padding="5,4" Background="Transparent" MouseLeftButtonDown="OnCompactContentMouseDown">
                <Grid>
                <TextBlock Text="Нет показателей" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A0A0A0" FontSize="12">
                    <TextBlock.Visibility>
                        <MultiBinding Converter="{StaticResource AllHiddenToVisibility}">
                            <Binding Path="Constructor.ShowCompactCpu"/>
                            <Binding Path="Constructor.ShowCompactCpuTemp"/>
                            <Binding Path="Constructor.ShowCompactGpu"/>
                            <Binding Path="Constructor.ShowCompactGpuTemp"/>
                            <Binding Path="Constructor.ShowCompactRam"/>
                            <Binding Path="Constructor.ShowCompactVram"/>
                            <Binding Path="Constructor.ShowCompactDisk"/>
                            <Binding Path="Constructor.ShowCompactNetwork"/>
                            <Binding Path="Constructor.ShowCompactUptime"/>
                        </MultiBinding>
                    </TextBlock.Visibility>
                </TextBlock>
                <UniformGrid Rows="1" ctrl:MetricOrder.Value="{Binding Constructor.MetricOrder}">

                    <!-- 1. CPU Card -->
                    <Border Tag="CPU" Margin="3,0" Background="{StaticResource BlackCardFill}" BorderBrush="{StaticResource BlackCardEdge}" BorderThickness="0" CornerRadius="5" Padding="8,6">
                        <Border.ToolTip><ToolTip Background="{StaticResource BlackCardFill}" BorderBrush="#333333" BorderThickness="1" Padding="10">
    <StackPanel><TextBlock Text="CPU" Foreground="White" FontWeight="Bold"/><TextBlock Foreground="#A0A0A0" FontSize="10" Margin="0,7,0,2">
    <Run Text="Нагрузка · максимум за сессию: "/><Run Text="{Binding SessionMetrics.CpuLoadMax, Mode=OneWay}"/>
</TextBlock>
<ctrl:MetricSparkline Points="{Binding SessionMetrics.CpuLoad}" Height="30" Width="220" HorizontalAlignment="Left"/>
<TextBlock Foreground="#A0A0A0" FontSize="10" Margin="0,7,0,2">
    <Run Text="Температура · максимум за сессию: "/><Run Text="{Binding SessionMetrics.CpuTempMax, Mode=OneWay}"/>
</TextBlock>
<ctrl:MetricSparkline Points="{Binding SessionMetrics.CpuTemp}" Height="30" Width="220" HorizontalAlignment="Left"/>
</StackPanel>
</ToolTip></Border.ToolTip>
                        <Border.Visibility>
                            <MultiBinding Converter="{StaticResource AnyVisible}">
                            <Binding Path="Constructor.ShowCompactCpu"/>
                            <Binding Path="Constructor.ShowCompactCpuTemp"/>
                        </MultiBinding>
                        </Border.Visibility>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconCpu}" Stroke="#FFFFFF" StrokeThickness="1.2" Width="13" Height="13" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="CPU" Foreground="#707070" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Visibility="{Binding Constructor.ShowCompactCpuTemp, Converter={StaticResource BoolToVis}}" Text="{Binding Dashboard.CpuTempDisplay}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Grid.Row="1" Visibility="{Binding Constructor.ShowCompactCpu, Converter={StaticResource BoolToVis}}" Text="{Binding Dashboard.CpuUsageDisplay}" Foreground="#FFFFFF" FontSize="25" FontWeight="Bold" FontFamily="{StaticResource FontDisplay}" Margin="0,1,0,3"/>

                            <ctrl:MiniBarGauge Grid.Row="2" Visibility="{Binding Constructor.ShowCompactCpu, Converter={StaticResource BoolToVis}}" Value="{Binding Dashboard.CpuPercentValue}" MaxValue="100" Height="4" HorizontalAlignment="Stretch" Margin="0,0,0,5"/>

                            <Grid Grid.Row="3" VerticalAlignment="Bottom">
                                <TextBlock Visibility="{Binding Constructor.ShowCompactCpu, Converter={StaticResource BoolToVis}}" Text="{Binding Dashboard.CpuClockDisplay}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Left"/>
                                <TextBlock Visibility="{Binding Constructor.ShowCompactCpu, Converter={StaticResource BoolToVis}}" Text="{Binding Dashboard.CpuPowerDisplay}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>
                    </Border>



                    <!-- 2. GPU Card -->
                    <Border Tag="GPU" Margin="3,0" Background="{StaticResource BlackCardFill}" BorderBrush="{StaticResource BlackCardEdge}" BorderThickness="0" CornerRadius="5" Padding="8,6">
                        <Border.ToolTip><ToolTip Background="{StaticResource BlackCardFill}" BorderBrush="#333333" BorderThickness="1" Padding="10">
    <StackPanel><TextBlock Text="GPU" Foreground="White" FontWeight="Bold"/><TextBlock Foreground="#A0A0A0" FontSize="10" Margin="0,7,0,2">
    <Run Text="Нагрузка · максимум за сессию: "/><Run Text="{Binding SessionMetrics.GpuLoadMax, Mode=OneWay}"/>
</TextBlock>
<ctrl:MetricSparkline Points="{Binding SessionMetrics.GpuLoad}" Height="30" Width="220" HorizontalAlignment="Left"/>
<TextBlock Foreground="#A0A0A0" FontSize="10" Margin="0,7,0,2">
    <Run Text="Температура · максимум за сессию: "/><Run Text="{Binding SessionMetrics.GpuTempMax, Mode=OneWay}"/>
</TextBlock>
<ctrl:MetricSparkline Points="{Binding SessionMetrics.GpuTemp}" Height="30" Width="220" HorizontalAlignment="Left"/>
</StackPanel>
</ToolTip></Border.ToolTip>
                        <Border.Visibility>
                            <MultiBinding Converter="{StaticResource AnyVisible}">
                            <Binding Path="Constructor.ShowCompactGpu"/>
                            <Binding Path="Constructor.ShowCompactGpuTemp"/>
                        </MultiBinding>
                        </Border.Visibility>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconGpu}" Stroke="#FFFFFF" StrokeThickness="1.2" Width="13" Height="13" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="GPU" Foreground="#707070" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Visibility="{Binding Constructor.ShowCompactGpuTemp, Converter={StaticResource BoolToVis}}" Text="{Binding Dashboard.GpuTempDisplay}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Grid.Row="1" Visibility="{Binding Constructor.ShowCompactGpu, Converter={StaticResource BoolToVis}}" Text="{Binding Dashboard.GpuUsageDisplay}" Foreground="#FFFFFF" FontSize="25" FontWeight="Bold" FontFamily="{StaticResource FontDisplay}" Margin="0,1,0,3"/>

                            <ctrl:MiniBarGauge Grid.Row="2" Visibility="{Binding Constructor.ShowCompactGpu, Converter={StaticResource BoolToVis}}" Value="{Binding Dashboard.GpuPercentValue}" MaxValue="100" Height="4" HorizontalAlignment="Stretch" Margin="0,0,0,5"/>

                            <Grid Grid.Row="3" VerticalAlignment="Bottom">
                                <TextBlock Visibility="{Binding Constructor.ShowCompactGpu, Converter={StaticResource BoolToVis}}" Text="{Binding Dashboard.GpuClockDisplay}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Left"/>
