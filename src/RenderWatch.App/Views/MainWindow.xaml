<Window x:Class="RenderWatch.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RenderWatch.App.Views"
        xmlns:black="clr-namespace:RenderWatch.App.Views.Black"
        xmlns:vm="clr-namespace:RenderWatch.App.ViewModels"
        xmlns:ctrl="clr-namespace:RenderWatch.App.Controls"
        Title="PC Watch" Icon="/PCWatch;component/Assets/app.ico"
        Height="780" Width="1180"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource BrushBg}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- White Miniature Hardware Geometries -->

        <SolidColorBrush x:Key="ColorWindowBackground" Color="#191919"/>
        <Style x:Key="BlackWindowSurface" TargetType="Grid">
            <Setter Property="Background" Value="{DynamicResource BrushBg}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsColorStyle}" Value="True">
                    <Setter Property="Background" Value="{StaticResource ColorWindowBackground}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BlackCompactSurface" TargetType="Grid" BasedOn="{StaticResource BlackWindowSurface}">
            <Setter Property="Background" Value="#0A0A0A"/>
        </Style>
        <Style x:Key="MainPage" TargetType="ContentControl">
            <Setter Property="Content" Value="{Binding CurrentView}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompactMode}" Value="True">
                    <Setter Property="Content" Value="{x:Null}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMinimized}" Value="True">
                    <Setter Property="Content" Value="{x:Null}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="CompactStripTemplate" DataType="{x:Type vm:MainViewModel}">
            <views:CompactChartStrip/>
        </DataTemplate>

        <!-- Window Caption Button Styles -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#8C8C8C"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E0E0E0"/>
                                <Setter Property="Background" Value="#414243"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#3C3D3E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#F5F2EA"/>
                    <Setter Property="Background" Value="#454647"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Compact Header Button Style with HitTestVisible & Hover States -->
        <Style x:Key="CompactHeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#424344"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#363738"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="BlackInterface" Visibility="{Binding UsesBlackLayout, Converter={StaticResource BoolToVis}}">
            <Grid.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PCWatch;component/Styles/BlackTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>


        <!-- White Miniature Hardware Geometries -->

        <!-- Window Caption Button Styles -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#8C8C8C"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E0E0E0"/>
                                <Setter Property="Background" Value="#242424"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1A1A1A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="Background" Value="#2A2A2A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Prominent Compact Mode Button Style -->
        <Style x:Key="CompactModeActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#383838"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMain}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#252525"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#A0A0A0"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#121212"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4A4A4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact Header Button Style with HitTestVisible & Hover States -->
        <Style x:Key="CompactHeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#252525"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#181818"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        </ResourceDictionary>
    </Grid.Resources>        <!-- ========================================== -->
        <!-- 1. FULL NORMAL MODE INTERFACE               -->
        <!-- ========================================== -->
        <Grid x:Name="BlackNormalModeGrid" Style="{StaticResource BlackWindowSurface}"
              Visibility="{Binding IsCompactMode, Converter={StaticResource InverseBoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding SidebarWidth}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="2">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#0C0C0C"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsColorStyle}" Value="True">
                                <Setter Property="Background" Value="{StaticResource ColorWindowBackground}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <Border Grid.Column="1" Grid.Row="0" Background="Transparent">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <views:AppearancePicker Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <Button Click="OnMinimizeToTrayClicked" Style="{StaticResource CaptionButtonStyle}" Width="33"
                                ToolTip="В трей" AutomationProperties.Name="В трей">
                            <Path Data="M 1,9 V 13 H 13 V 9 M 7,2 V 9 M 4,6 L 7,9 L 10,6" Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.15"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button Click="OnMicroModeClicked" Style="{StaticResource CaptionButtonStyle}" Width="33"
                                ToolTip="Микро" AutomationProperties.Name="Микро">
                            <Path Data="M 2,3 H 13 V 12 H 2 Z M 2,6 H 13" Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.15"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button Click="OnMinimizeToPanelClicked" Style="{StaticResource CaptionButtonStyle}" Width="33"
                                ToolTip="На панель задач" AutomationProperties.Name="На панель задач">
                            <Path Data="M 1,11 H 14 M 7,5 H 13 V 8 H 7 Z" Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.15"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button Click="OnNotchModeClicked" Style="{StaticResource CaptionButtonStyle}" Width="33"
                                ToolTip="Чёлка" AutomationProperties.Name="Чёлка">
                            <Path Data="M 1,4 H 13 M 3,4 V 6 Q 3,9 6,9 H 8 Q 11,9 11,6 V 4"
                                  Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.15"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button Click="OnCompactModeClicked" Style="{StaticResource CaptionButtonStyle}" Width="33"
                                ToolTip="Компактный режим" AutomationProperties.Name="Компактный режим">
                            <Path Data="M 1,3 H 13 V 11 H 1 Z M 5,4 V 10 M 9,4 V 10" Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.15"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <!-- Minimize -->
                        <Button Click="OnMinimizeClicked" Style="{StaticResource CaptionButtonStyle}" ToolTip="Свернуть">
                            <Path Data="M 0,0 L 10,0"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1"
                                  SnapsToDevicePixels="True"/>
                        </Button>

                        <!-- Maximize / Restore -->
                        <Button Click="OnMaximizeClicked" Style="{StaticResource CaptionButtonStyle}" ToolTip="Развернуть">
                            <Rectangle Width="10" Height="10"
                                       Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                       StrokeThickness="1"
                                       RadiusX="1" RadiusY="1"
                                       SnapsToDevicePixels="True"/>
                        </Button>

                        <!-- Close -->
                        <Button Click="OnCloseClicked" Style="{StaticResource CaptionCloseButtonStyle}" ToolTip="Закрыть">
                            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1"
                                  StrokeStartLineCap="Square"
                                  StrokeEndLineCap="Square"
                                  SnapsToDevicePixels="True"/>
                        </Button>
                </StackPanel>
            </Border>

            <views:SidebarNavigation Grid.RowSpan="2" Grid.Column="0"/>

            <!-- 3. Dynamic Content View -->
            <Grid Grid.Row="1" Grid.Column="1">
                <ContentControl>
                    <ContentControl.Style>
                        <Style TargetType="ContentControl" BasedOn="{StaticResource MainPage}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UsesBlackLayout}" Value="False">
                                    <Setter Property="Content" Value="{x:Null}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                            <black:BlackDashboardView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:ChartsViewModel}">
                            <black:BlackChartsView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:ConfigurationViewModel}">
                            <black:BlackConfigurationView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:DisplayConstructorViewModel}">
                            <views:DisplayConstructorView/>
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>

                <!-- Toast Notification Overlay -->
                <Border Background="#323334" BorderBrush="#F5F2EA" BorderThickness="2,0,0,0" CornerRadius="6"
                        Padding="16,12" Margin="0,0,24,24"
                        Width="360"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding ToastTitle}" Foreground="#F5F2EA" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ToastMessage}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="1" Content="✕" Command="{Binding DismissToastCommand}" Style="{StaticResource MinimalButton}" Padding="6,2" VerticalAlignment="Top"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ========================================== -->
        <!-- 2. ULTRA-COMPACT FLOATING WIDGET MODE       -->
        <!-- ========================================== -->
        <Grid x:Name="BlackCompactModeGrid"
              Style="{StaticResource BlackCompactSurface}"
              Visibility="{Binding IsCompactMode, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>  <!-- Compact Title Bar with drag & controls -->
                <RowDefinition Height="*"/>   <!-- 4 Compact Hardware Indicator Cards -->
            </Grid.RowDefinitions>

            <!-- Compact Title Bar -->
            <Border Grid.Row="0" Background="#121212" BorderBrush="{StaticResource BlackCardEdge}" BorderThickness="0,0,0,1">
                <Grid Margin="8,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Logo & Title (Draggable) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                Background="Transparent" MouseLeftButtonDown="OnCompactHeaderMouseDown" MouseMove="OnCompactHeaderMouseMove" Cursor="SizeAll">
                        <TextBlock Text="PC Watch" Foreground="#A0A0A0" FontWeight="Bold" FontSize="10" FontFamily="{StaticResource FontDisplay}"/>
                    </StackPanel>

                    <!-- Center: Drag Area -->
                    <Border Grid.Column="1" Background="Transparent" MouseLeftButtonDown="OnCompactHeaderMouseDown" MouseMove="OnCompactHeaderMouseMove" Cursor="SizeAll"/>

                    <!-- Right: Compact Controls (WindowChrome HitTest Visible) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Pin / Always On Top Toggle -->
                        <Button Click="OnToggleTopmostClicked"
                                Style="{StaticResource CompactHeaderBtn}"
                                ToolTip="Закрепить поверх всех окон">
                            <TextBlock Text="📌" FontSize="11"
                                       Foreground="{Binding IsCompactTopmost, Converter={StaticResource HexToBrush}, ConverterParameter='#FFFFFF:#707070'}"/>
                        </Button>

                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Padding="5,4" Background="Transparent" MouseLeftButtonDown="OnCompactContentMouseDown">
                <ContentControl>
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding UsesBlackLayout}" Value="True"/>
                                        <Condition Binding="{Binding IsCompactMode}" Value="True"/>
                                        <Condition Binding="{Binding IsMinimized}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Content" Value="{Binding}"/>
                                    <Setter Property="ContentTemplate" Value="{StaticResource CompactStripTemplate}"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Border>
        </Grid>

        </Grid>
        <Grid x:Name="GraphiteInterface" Visibility="{Binding IsGraphiteStyle, Converter={StaticResource BoolToVis}}">
        <!-- ========================================== -->
        <!-- 1. FULL NORMAL MODE INTERFACE               -->
        <!-- ========================================== -->
        <Grid x:Name="NormalModeGrid" Background="{StaticResource GraphiteBackdrop}"
              Visibility="{Binding IsCompactMode, Converter={StaticResource InverseBoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding SidebarWidth}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="2" Background="{StaticResource SidebarBackdrop}"/>
            <Border Grid.RowSpan="2" Grid.ColumnSpan="2" Background="{x:Static ctrl:GraphiteTexture.Grain}"
                    IsHitTestVisible="False"/>

            <Border Grid.Column="1" Grid.Row="0" Background="Transparent">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <views:AppearancePicker Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <Button Click="OnMinimizeToTrayClicked" Style="{StaticResource CaptionButtonStyle}" Width="33"
                                ToolTip="В трей" AutomationProperties.Name="В трей">
                            <Path Data="M 1,9 V 13 H 13 V 9 M 7,2 V 9 M 4,6 L 7,9 L 10,6" Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.15"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button Click="OnMicroModeClicked" Style="{StaticResource CaptionButtonStyle}" Width="33"
                                ToolTip="Микро" AutomationProperties.Name="Микро">
                            <Path Data="M 2,3 H 13 V 12 H 2 Z M 2,6 H 13" Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.15"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button Click="OnMinimizeToPanelClicked" Style="{StaticResource CaptionButtonStyle}" Width="33"
                                ToolTip="На панель задач" AutomationProperties.Name="На панель задач">
                            <Path Data="M 1,11 H 14 M 7,5 H 13 V 8 H 7 Z" Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.15"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button Click="OnNotchModeClicked" Style="{StaticResource CaptionButtonStyle}" Width="33"
                                ToolTip="Чёлка" AutomationProperties.Name="Чёлка">
                            <Path Data="M 1,4 H 13 M 3,4 V 6 Q 3,9 6,9 H 8 Q 11,9 11,6 V 4"
                                  Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.15"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button Click="OnCompactModeClicked" Style="{StaticResource CaptionButtonStyle}" Width="33"
                                ToolTip="Компактный режим" AutomationProperties.Name="Компактный режим">
                            <Path Data="M 1,3 H 13 V 11 H 1 Z M 5,4 V 10 M 9,4 V 10" Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.15"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <!-- Minimize -->
                        <Button Click="OnMinimizeClicked" Style="{StaticResource CaptionButtonStyle}" ToolTip="Свернуть">
                            <Path Data="M 0,0 L 10,0"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1"
                                  SnapsToDevicePixels="True"/>
                        </Button>

                        <!-- Maximize / Restore -->
                        <Button Click="OnMaximizeClicked" Style="{StaticResource CaptionButtonStyle}" ToolTip="Развернуть">
                            <Rectangle Width="10" Height="10"
                                       Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                       StrokeThickness="1"
                                       RadiusX="1" RadiusY="1"
                                       SnapsToDevicePixels="True"/>
                        </Button>

                        <!-- Close -->
                        <Button Click="OnCloseClicked" Style="{StaticResource CaptionCloseButtonStyle}" ToolTip="Закрыть">
                            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1"
                                  StrokeStartLineCap="Square"
                                  StrokeEndLineCap="Square"
                                  SnapsToDevicePixels="True"/>
                        </Button>
                </StackPanel>
            </Border>

            <views:SidebarNavigation Grid.RowSpan="2" Grid.Column="0"/>

            <!-- 3. Dynamic Content View -->
            <Grid Grid.Row="1" Grid.Column="1">
                <ContentControl>
                    <ContentControl.Style>
                        <Style TargetType="ContentControl" BasedOn="{StaticResource MainPage}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGraphiteStyle}" Value="False">
                                    <Setter Property="Content" Value="{x:Null}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                            <views:DashboardView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:ChartsViewModel}">
                            <views:ChartsView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:ConfigurationViewModel}">
                            <views:ConfigurationView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:DisplayConstructorViewModel}">
                            <views:DisplayConstructorView/>
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>

                <!-- Toast Notification Overlay -->
                <Border Background="#323334" BorderBrush="#F5F2EA" BorderThickness="2,0,0,0" CornerRadius="6"
                        Padding="16,12" Margin="0,0,24,24"
                        Width="360"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding ToastTitle}" Foreground="#F5F2EA" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ToastMessage}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="1" Content="✕" Command="{Binding DismissToastCommand}" Style="{StaticResource MinimalButton}" Padding="6,2" VerticalAlignment="Top"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ========================================== -->
        <!-- 2. ULTRA-COMPACT FLOATING WIDGET MODE       -->
        <!-- ========================================== -->
        <Grid x:Name="CompactModeGrid"
              Background="{StaticResource GraphiteBackdrop}"
              Visibility="{Binding IsCompactMode, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="23"/>
                <RowDefinition Height="*"/>   <!-- 4 Compact Hardware Indicator Cards -->
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="2" Background="{x:Static ctrl:GraphiteTexture.Grain}" IsHitTestVisible="False"/>

            <Grid Grid.Row="0" Margin="0,0,6,0">
                <Border Background="Transparent" MouseLeftButtonDown="OnCompactHeaderMouseDown"
                        MouseMove="OnCompactHeaderMouseMove" Cursor="SizeAll"/>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnToggleTopmostClicked"
                        Style="{StaticResource CompactHeaderBtn}" ToolTip="Закрепить поверх всех окон"
                        AutomationProperties.Name="Закрепить поверх всех окон">
                    <Path Width="13" Height="13" Stretch="Uniform" StrokeThickness="1.05"
                          Data="M 9,2 L 14,7 L 11,7 L 8,10 L 8,12 L 4,8 L 6,8 L 9,5 Z M 6,10 L 2,14"
                          Stroke="{Binding IsCompactTopmost, Converter={StaticResource HexToBrush}, ConverterParameter='#F5F2EA:#ABA9A4'}"/>
                </Button>
            </Grid>

            <Border Grid.Row="1" Padding="5,4" Background="Transparent" MouseLeftButtonDown="OnCompactContentMouseDown">
                <ContentControl>
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsGraphiteStyle}" Value="True"/>
                                        <Condition Binding="{Binding IsCompactMode}" Value="True"/>
                                        <Condition Binding="{Binding IsMinimized}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Content" Value="{Binding}"/>
                                    <Setter Property="ContentTemplate" Value="{StaticResource CompactStripTemplate}"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Border>
        </Grid>

        </Grid>
        <Border Background="#303132" BorderBrush="#555657" BorderThickness="1" CornerRadius="6"
                Padding="12,9" Margin="12,0,18,16" MaxWidth="340"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Visibility="{Binding IsUpdatePromptVisible, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0"
                            Visibility="{Binding IsUpdating, Converter={StaticResource InverseBoolToVis}}">
                    <Button Content="Позже" Command="{Binding PostponeUpdateCommand}" Style="{StaticResource MinimalButton}" Padding="8,4" Margin="0,0,5,0"/>
                    <Button Content="Да" Command="{Binding ApplyUpdateCommand}" Style="{StaticResource AccentButton}" Padding="9,4"/>
                </StackPanel>
                <TextBlock Text="{Binding UpdatePromptText}" Foreground="{StaticResource WhiteInk}"
                           FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
