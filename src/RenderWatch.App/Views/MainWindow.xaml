                    </Border>
                    <Border Tag="NET" Visibility="{Binding Constructor.ShowCompactNetwork, Converter={StaticResource BoolToVis}}" Margin="3,0" Padding="8,6">
                        <StackPanel><TextBlock Text="Сеть" Foreground="#B6B4AE" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Dashboard.NetworkCompact}" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <Border Tag="UPTIME" Visibility="{Binding Constructor.ShowCompactUptime, Converter={StaticResource BoolToVis}}" Margin="3,0" Padding="8,6">
                        <StackPanel><TextBlock Text="Время работы" Foreground="#B6B4AE" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Dashboard.Uptime}" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                </Grid>
            </Border>
        </Grid>

        </Grid>
    </Grid>
</Window>
