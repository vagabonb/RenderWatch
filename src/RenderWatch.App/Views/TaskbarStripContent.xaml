<UserControl x:Class="RenderWatch.App.Views.TaskbarStripContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:RenderWatch.App.Controls"
             xmlns:conv="clr-namespace:RenderWatch.App.Converters"
             xmlns:views="clr-namespace:RenderWatch.App.Views"
             Focusable="False">
    <UserControl.Style>
        <Style TargetType="views:TaskbarStripContent">
            <Setter Property="UseDarkInk" Value="{Binding IsTaskbarStripLightMode}"/>
        </Style>
    </UserControl.Style>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RenderWatch;component/Styles/BlackSurfaces.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="TaskbarFlyoutSurface" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GraphiteBackdrop}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding UsesBlackLayout}" Value="True">
                    <Setter Property="Background" Value="{StaticResource BlackCardFill}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BlackCardEdge}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TaskbarSmallTooltip" TargetType="ToolTip">
            <Setter Property="Background" Value="#303132"/>
            <Setter Property="Foreground" Value="#F5F2EA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding UsesBlackLayout}" Value="True">
                    <Setter Property="Background" Value="{StaticResource BlackCardFill}"/>
                    <Setter Property="BorderBrush" Value="#333333"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ToolTip" BasedOn="{StaticResource TaskbarSmallTooltip}"/>

        <Style x:Key="StripLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ABFFFFFF"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding UseDarkInk, RelativeSource={RelativeSource AncestorType=views:TaskbarStripContent}}" Value="True">
                    <Setter Property="Foreground" Value="#4B4B4B"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StripTemperatureStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="20"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding UseDarkInk, RelativeSource={RelativeSource AncestorType=views:TaskbarStripContent}}" Value="True">
                    <Setter Property="Foreground" Value="#0A0A0A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StripValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="24"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding UseDarkInk, RelativeSource={RelativeSource AncestorType=views:TaskbarStripContent}}" Value="True">
                    <Setter Property="Foreground" Value="#0A0A0A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StripSegmentStyle" TargetType="Border">
            <Setter Property="Background" Value="#01000000"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="{Binding Constructor.Taskbar.BlockPadding}"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="60"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="30"/>
            <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
            <Setter Property="ToolTipService.Placement" Value="Top"/>
            <Setter Property="ToolTipService.VerticalOffset" Value="-6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#22FFFFFF"/>
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding UseDarkInk, RelativeSource={RelativeSource AncestorType=views:TaskbarStripContent}}" Value="True"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#1A000000"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <conv:TaskbarInkConverter x:Key="TaskbarInk"/>
        <Style x:Key="TaskbarMetricLabel" TargetType="ContentControl">
            <Setter Property="Margin" Value="{Binding Constructor.Taskbar.LabelPadding}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource TaskbarInk}" ConverterParameter="Label">
                        <Binding Path="Content.LabelBrush" RelativeSource="{RelativeSource Self}"/>
                        <Binding Path="UseDarkInk" RelativeSource="{RelativeSource AncestorType=views:TaskbarStripContent}"/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Path x:Name="Icon" Data="{TemplateBinding Tag}" Style="{StaticResource HardwareSmallIcon}"
                                  Stroke="{TemplateBinding Foreground}" Margin="0"/>
                            <TextBlock x:Name="Caption" Text="{Binding Content.Key, RelativeSource={RelativeSource TemplatedParent}}"
                                       FontSize="10" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Content.UseText, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Caption" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StripLoadWithTemperatureStyle" TargetType="TextBlock" BasedOn="{StaticResource StripValueStyle}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="CPU"/>
                        <Condition Binding="{Binding Constructor.ShowTaskbarCpuTemp}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Margin" Value="{Binding Constructor.Taskbar.ValuePadding}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="GPU"/>
                        <Condition Binding="{Binding Constructor.ShowTaskbarGpuTemp}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Margin" Value="{Binding Constructor.Taskbar.ValuePadding}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        </ResourceDictionary>
    </UserControl.Resources>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch" Margin="{Binding Constructor.Taskbar.OuterPadding}" ctrl:MetricOrder.Value="{Binding Constructor.Taskbar.Order}">

            <Border Tag="CPU" x:Name="CpuSegment" Style="{StaticResource StripSegmentStyle}">
                <Border.Visibility>
                    <MultiBinding Converter="{StaticResource AnyVisible}">
                            <Binding Path="Constructor.ShowTaskbarCpu"/>
                            <Binding Path="Constructor.ShowTaskbarCpuTemp"/>
                        </MultiBinding>
                </Border.Visibility>
                <Border.ToolTip>
                    <ToolTip Background="Transparent" BorderThickness="0" Padding="0" HasDropShadow="True">
                        <Border Style="{StaticResource TaskbarFlyoutSurface}"
                                Padding="14,12"
                                Width="285"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.85"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="ПРОЦЕССОР (CPU)" Foreground="#F5F2EA" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" Margin="0,0,0,8"/>

                                <!-- Full CPU Name -->
                                <TextBlock Text="{Binding Configuration.Config.CpuName}" Foreground="#F5F2EA" FontWeight="Bold" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,9"/>

                                <Rectangle Height="1" Fill="#3C3D3E" Margin="0,0,0,8"/>

                                <!-- Specs & Metrics -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Температура:" Foreground="#B6B4AE" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Dashboard.CpuTempDisplay}" Foreground="#DCDCDC" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Загрузка ядер:" Foreground="#B6B4AE" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Dashboard.CpuUsageDisplay}" Foreground="#F5F2EA" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Текущая частота:" Foreground="#B6B4AE" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Dashboard.CpuClockDisplay}" Foreground="#F5F2EA" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Энергопотребление:" Foreground="#B6B4AE" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Dashboard.CpuPowerDisplay}" Foreground="#DCDCDC" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Ядра и потоки:" Foreground="#B6B4AE" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Configuration.Config.CpuCoresThreads}" Foreground="#F5F2EA" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Сокет платформы:" Foreground="#B6B4AE" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Configuration.Config.CpuSocket}" Foreground="#DCDCDC" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>

                                <Rectangle Height="1" Fill="#3C3D3E" Margin="0,6,0,7"/>
                                <TextBlock Foreground="#C4C1BB" FontSize="10" Margin="0,7,0,2">
    <Run Text="Нагрузка · максимум за сессию: "/><Run Text="{Binding SessionMetrics.CpuLoadMax, Mode=OneWay}"/>
</TextBlock>
<ctrl:MetricSparkline Points="{Binding SessionMetrics.CpuLoad}" Height="30" Width="220" HorizontalAlignment="Left"/>
<TextBlock Foreground="#C4C1BB" FontSize="10" Margin="0,7,0,2">
    <Run Text="Температура · максимум за сессию: "/><Run Text="{Binding SessionMetrics.CpuTempMax, Mode=OneWay}"/>
</TextBlock>
<ctrl:MetricSparkline Points="{Binding SessionMetrics.CpuTemp}" Height="30" Width="220" HorizontalAlignment="Left"/>

                                <TextBlock Text="Клик — развернуть" Foreground="#A5A49F" FontSize="9" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ToolTip>
                </Border.ToolTip>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Content="{Binding Constructor.Taskbar.ByKey[CPU]}" Tag="{StaticResource IconCpu}" Style="{StaticResource TaskbarMetricLabel}" Focusable="False"/>
                    <TextBlock Visibility="{Binding Constructor.ShowTaskbarCpuTemp, Converter={StaticResource BoolToVis}}" Text="{Binding Dashboard.CpuTempMicro}" Style="{StaticResource StripTemperatureStyle}">
                        <TextBlock.Foreground>
                            <MultiBinding Converter="{StaticResource TaskbarInk}">
                                <Binding Path="Constructor.Taskbar.ByKey[CPU].TemperatureBrush"/>
                                <Binding Path="UseDarkInk" RelativeSource="{RelativeSource AncestorType=views:TaskbarStripContent}"/>
                            </MultiBinding>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Visibility="{Binding Constructor.ShowTaskbarCpu, Converter={StaticResource BoolToVis}}" Text="{Binding Dashboard.CpuUsageMicro}" Style="{StaticResource StripLoadWithTemperatureStyle}" Tag="CPU">
                        <TextBlock.Foreground>
                            <MultiBinding Converter="{StaticResource TaskbarInk}">
                                <Binding Path="Constructor.Taskbar.ByKey[CPU].ValueBrush"/>
                                <Binding Path="UseDarkInk" RelativeSource="{RelativeSource AncestorType=views:TaskbarStripContent}"/>
                            </MultiBinding>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>
            </Border>



            <Border Tag="GPU" x:Name="GpuSegment" Style="{StaticResource StripSegmentStyle}">
                <Border.Visibility>
                    <MultiBinding Converter="{StaticResource AnyVisible}">
                            <Binding Path="Constructor.ShowTaskbarGpu"/>
                            <Binding Path="Constructor.ShowTaskbarGpuTemp"/>
                        </MultiBinding>
                </Border.Visibility>
                <Border.ToolTip>
                    <ToolTip Background="Transparent" BorderThickness="0" Padding="0" HasDropShadow="True">
                        <Border Style="{StaticResource TaskbarFlyoutSurface}"
                                Padding="14,12"
                                Width="285"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.85"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="ВИДЕОКАРТА (GPU)" Foreground="#F5F2EA" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" Margin="0,0,0,8"/>

                                <!-- Full GPU Name -->
                                <TextBlock Text="{Binding Dashboard.GpuName}" Foreground="#F5F2EA" FontWeight="Bold" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,9"/>

                                <Rectangle Height="1" Fill="#3C3D3E" Margin="0,0,0,8"/>

                                <!-- Specs & Metrics -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Температура GPU:" Foreground="#B6B4AE" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Dashboard.GpuTempDisplay}" Foreground="#DCDCDC" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Загрузка чипа:" Foreground="#B6B4AE" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Dashboard.GpuUsageDisplay}" Foreground="#F5F2EA" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Частота ядра:" Foreground="#B6B4AE" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Dashboard.GpuClockDisplay}" Foreground="#F5F2EA" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Энергопотребление:" Foreground="#B6B4AE" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Dashboard.GpuPowerDisplay}" Foreground="#DCDCDC" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Видеопамять (VRAM):" Foreground="#B6B4AE" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Dashboard.VramDisplay}" Foreground="#F5F2EA" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Версия драйвера:" Foreground="#B6B4AE" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Configuration.Config.PrimaryGpuDriver}" Foreground="#DCDCDC" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>

                                <Rectangle Height="1" Fill="#3C3D3E" Margin="0,6,0,7"/>
                                <TextBlock Foreground="#C4C1BB" FontSize="10" Margin="0,7,0,2">
    <Run Text="Нагрузка · максимум за сессию: "/><Run Text="{Binding SessionMetrics.GpuLoadMax, Mode=OneWay}"/>
</TextBlock>
<ctrl:MetricSparkline Points="{Binding SessionMetrics.GpuLoad}" Height="30" Width="220" HorizontalAlignment="Left"/>
<TextBlock Foreground="#C4C1BB" FontSize="10" Margin="0,7,0,2">
    <Run Text="Температура · максимум за сессию: "/><Run Text="{Binding SessionMetrics.GpuTempMax, Mode=OneWay}"/>
</TextBlock>
<ctrl:MetricSparkline Points="{Binding SessionMetrics.GpuTemp}" Height="30" Width="220" HorizontalAlignment="Left"/>

                                <TextBlock Text="Клик — развернуть" Foreground="#A5A49F" FontSize="9" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ToolTip>
                </Border.ToolTip>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Content="{Binding Constructor.Taskbar.ByKey[GPU]}" Tag="{StaticResource IconGpu}" Style="{StaticResource TaskbarMetricLabel}" Focusable="False"/>
                    <TextBlock Visibility="{Binding Constructor.ShowTaskbarGpuTemp, Converter={StaticResource BoolToVis}}" Text="{Binding Dashboard.GpuTempMicro}" Style="{StaticResource StripTemperatureStyle}">
                        <TextBlock.Foreground>
                            <MultiBinding Converter="{StaticResource TaskbarInk}">
                                <Binding Path="Constructor.Taskbar.ByKey[GPU].TemperatureBrush"/>
                                <Binding Path="UseDarkInk" RelativeSource="{RelativeSource AncestorType=views:TaskbarStripContent}"/>
                            </MultiBinding>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Visibility="{Binding Constructor.ShowTaskbarGpu, Converter={StaticResource BoolToVis}}" Text="{Binding Dashboard.GpuUsageMicro}" Style="{StaticResource StripLoadWithTemperatureStyle}" Tag="GPU">
                        <TextBlock.Foreground>
                            <MultiBinding Converter="{StaticResource TaskbarInk}">
                                <Binding Path="Constructor.Taskbar.ByKey[GPU].ValueBrush"/>
                                <Binding Path="UseDarkInk" RelativeSource="{RelativeSource AncestorType=views:TaskbarStripContent}"/>
                            </MultiBinding>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>
            </Border>



            <Border Tag="RAM" x:Name="RamSegment" Visibility="{Binding Constructor.ShowTaskbarRam, Converter={StaticResource BoolToVis}}" Style="{StaticResource StripSegmentStyle}">
                <Border.ToolTip>
                    <ToolTip Background="Transparent" BorderThickness="0" Padding="0" HasDropShadow="True">
                        <Border Style="{StaticResource TaskbarFlyoutSurface}"
                                Padding="14,12"
                                Width="285"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.85"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- Header -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="ОПЕРАТИВНАЯ ПАМЯТЬ" Foreground="#F5F2EA" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#353637" BorderBrush="#474849" BorderThickness="1" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Configuration.Config.RamChannelBadge}" Foreground="#C4C1BB" FontSize="9" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>

                                <!-- Total Capacity & Summary -->
                                <TextBlock Text="{Binding Dashboard.RamDisplay}" Foreground="#F5F2EA" FontWeight="Bold" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,9"/>

                                <Rectangle Height="1" Fill="#3C3D3E" Margin="0,0,0,8"/>

                                <!-- Specs & Metrics -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Занято памяти:" Foreground="#B6B4AE" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Dashboard.RamUsedDisplay}" Foreground="#F5F2EA" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Свободно памяти:" Foreground="#B6B4AE" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Dashboard.RamAvailableDisplay}" Foreground="#DCDCDC" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Всего в системе:" Foreground="#B6B4AE" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Dashboard.RamTotalDisplay}" Foreground="#DCDCDC" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Процент нагрузки:" Foreground="#B6B4AE" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Dashboard.RamPercentDisplay}" Foreground="#F5F2EA" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Тип и частота:" Foreground="#B6B4AE" FontSize="11"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Configuration.Config.RamType}" Foreground="#F5F2EA" FontWeight="SemiBold" FontSize="11" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding Configuration.Config.RamSpeed}" Foreground="#DCDCDC" FontSize="11"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Слоты памяти:" Foreground="#B6B4AE" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Configuration.Config.RamSlotsUsed}" Foreground="#DCDCDC" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>

                                <Rectangle Height="1" Fill="#3C3D3E" Margin="0,6,0,7"/>
                                <TextBlock Foreground="#C4C1BB" FontSize="10" Margin="0,7,0,2">
    <Run Text="Загрузка · максимум за сессию: "/><Run Text="{Binding SessionMetrics.RamMax, Mode=OneWay}"/>
</TextBlock>
<ctrl:MetricSparkline Points="{Binding SessionMetrics.Ram}" Height="30" Width="220" HorizontalAlignment="Left"/>

                                <TextBlock Text="Клик — развернуть" Foreground="#A5A49F" FontSize="9" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ToolTip>
                </Border.ToolTip>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Content="{Binding Constructor.Taskbar.ByKey[RAM]}" Tag="{StaticResource IconRam}" Style="{StaticResource TaskbarMetricLabel}" Focusable="False"/>
                    <TextBlock Text="{Binding Dashboard.RamPercentDisplay}" Style="{StaticResource StripValueStyle}">
                        <TextBlock.Foreground>
                            <MultiBinding Converter="{StaticResource TaskbarInk}">
                                <Binding Path="Constructor.Taskbar.ByKey[RAM].ValueBrush"/>
                                <Binding Path="UseDarkInk" RelativeSource="{RelativeSource AncestorType=views:TaskbarStripContent}"/>
                            </MultiBinding>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Tag="VRAM" Style="{StaticResource StripSegmentStyle}" Visibility="{Binding Constructor.ShowTaskbarVram, Converter={StaticResource BoolToVis}}">
                <Border.ToolTip><ToolTip Style="{StaticResource TaskbarSmallTooltip}">
    <StackPanel><TextBlock Text="VRAM" Foreground="White" FontWeight="Bold"/><TextBlock Foreground="#C4C1BB" FontSize="10" Margin="0,7,0,2">
    <Run Text="Загрузка · максимум за сессию: "/><Run Text="{Binding SessionMetrics.VramMax, Mode=OneWay}"/>
</TextBlock>
<ctrl:MetricSparkline Points="{Binding SessionMetrics.Vram}" Height="30" Width="220" HorizontalAlignment="Left"/>
</StackPanel>
</ToolTip></Border.ToolTip>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Content="{Binding Constructor.Taskbar.ByKey[VRAM]}" Tag="{StaticResource IconVram}" Style="{StaticResource TaskbarMetricLabel}" Focusable="False"/>
                    <TextBlock Text="{Binding Dashboard.VramPercentValue, StringFormat={}{0:F0}%}" Style="{StaticResource StripValueStyle}">
                        <TextBlock.Foreground>
                            <MultiBinding Converter="{StaticResource TaskbarInk}">
                                <Binding Path="Constructor.Taskbar.ByKey[VRAM].ValueBrush"/>
                                <Binding Path="UseDarkInk" RelativeSource="{RelativeSource AncestorType=views:TaskbarStripContent}"/>
                            </MultiBinding>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Tag="DISK" Style="{StaticResource StripSegmentStyle}" Visibility="{Binding Constructor.ShowTaskbarDisk, Converter={StaticResource BoolToVis}}">
                <Border.ToolTip>
                    <ToolTip Style="{StaticResource TaskbarSmallTooltip}">
                        <StackPanel>
                            <TextBlock Text="Диски · МБ/с" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding Dashboard.PhysicalDisks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,5">
                                            <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Чтение: " Foreground="#C4C1BB"/>
                                                <TextBlock Text="{Binding Read}" Foreground="White"/>
                                                <TextBlock Text="   Запись: " Foreground="#C4C1BB"/>
                                                <TextBlock Text="{Binding Write}" Foreground="White"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ToolTip>
                </Border.ToolTip>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Content="{Binding Constructor.Taskbar.ByKey[DISK]}" Tag="{StaticResource IconDisk}" Style="{StaticResource TaskbarMetricLabel}" Focusable="False"/>
                    <TextBlock Text="{Binding Dashboard.DiskCompact}" Style="{StaticResource StripValueStyle}">
                        <TextBlock.Foreground>
                            <MultiBinding Converter="{StaticResource TaskbarInk}">
                                <Binding Path="Constructor.Taskbar.ByKey[DISK].ValueBrush"/>
                                <Binding Path="UseDarkInk" RelativeSource="{RelativeSource AncestorType=views:TaskbarStripContent}"/>
                            </MultiBinding>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border ToolTip="Сеть: приём и отправка" Tag="NET" Style="{StaticResource StripSegmentStyle}" Visibility="{Binding Constructor.ShowTaskbarNetwork, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Content="{Binding Constructor.Taskbar.ByKey[NET]}" Tag="{StaticResource IconNetwork}" Style="{StaticResource TaskbarMetricLabel}" Focusable="False"/>
                    <TextBlock Text="{Binding Dashboard.NetworkCompact}" Style="{StaticResource StripValueStyle}" FontWeight="Normal" FontSize="11" MinWidth="0">
                        <TextBlock.Foreground>
                            <MultiBinding Converter="{StaticResource TaskbarInk}">
                                <Binding Path="Constructor.Taskbar.ByKey[NET].ValueBrush"/>
                                <Binding Path="UseDarkInk" RelativeSource="{RelativeSource AncestorType=views:TaskbarStripContent}"/>
                            </MultiBinding>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border ToolTip="Время работы компьютера" Tag="UPTIME" Style="{StaticResource StripSegmentStyle}" Visibility="{Binding Constructor.ShowTaskbarUptime, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Content="{Binding Constructor.Taskbar.ByKey[UPTIME]}" Tag="{StaticResource IconUptime}" Style="{StaticResource TaskbarMetricLabel}" Focusable="False"/>
                    <TextBlock Text="{Binding Dashboard.Uptime}" Style="{StaticResource StripValueStyle}">
                        <TextBlock.Foreground>
                            <MultiBinding Converter="{StaticResource TaskbarInk}">
                                <Binding Path="Constructor.Taskbar.ByKey[UPTIME].ValueBrush"/>
                                <Binding Path="UseDarkInk" RelativeSource="{RelativeSource AncestorType=views:TaskbarStripContent}"/>
                            </MultiBinding>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border x:Name="BatteryRuntimeSegment" Tag="BAT" ToolTip="Примерное время работы от батареи">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StripSegmentStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Constructor.ShowTaskbarBatteryRuntime}" Value="True"/>
                                    <Condition Binding="{Binding Dashboard.Battery.IsOnBattery}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Content="{Binding Constructor.Taskbar.ByKey[BAT]}" Tag="{StaticResource IconBatteryRuntime}"
                                    Style="{StaticResource TaskbarMetricLabel}" Focusable="False"/>
                    <TextBlock Text="{Binding Dashboard.Battery.TaskbarRemainingText}"
                               Style="{StaticResource StripValueStyle}" MinWidth="47">
                        <TextBlock.Foreground>
                            <MultiBinding Converter="{StaticResource TaskbarInk}">
                                <Binding Path="Constructor.Taskbar.ByKey[BAT].ValueBrush"/>
                                <Binding Path="UseDarkInk" RelativeSource="{RelativeSource AncestorType=views:TaskbarStripContent}"/>
                            </MultiBinding>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>
            </Border>
            <TextBlock Text="Нет показателей" Style="{StaticResource StripLabelStyle}" VerticalAlignment="Center" Margin="6,0">
                <TextBlock.Visibility>
                    <MultiBinding Converter="{StaticResource AllHiddenToVisibility}">
                        <Binding Path="Constructor.ShowTaskbarCpu"/>
                        <Binding Path="Constructor.ShowTaskbarCpuTemp"/>
                        <Binding Path="Constructor.ShowTaskbarGpu"/>
                        <Binding Path="Constructor.ShowTaskbarGpuTemp"/>
                        <Binding Path="Constructor.ShowTaskbarRam"/>
                        <Binding Path="Constructor.ShowTaskbarVram"/>
                        <Binding Path="Constructor.ShowTaskbarDisk"/>
                        <Binding Path="Constructor.ShowTaskbarNetwork"/>
                        <Binding Path="Constructor.ShowTaskbarUptime"/>
                        <Binding Path="Visibility" ElementName="BatteryRuntimeSegment"/>
                    </MultiBinding>
                </TextBlock.Visibility>
            </TextBlock>
        </StackPanel>
</UserControl>
