<UserControl x:Class="RenderWatch.App.Views.TaskbarStripContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:RenderWatch.App.Controls"
             xmlns:conv="clr-namespace:RenderWatch.App.Converters"
             xmlns:views="clr-namespace:RenderWatch.App.Views"
             Focusable="False">
    <UserControl.Style>
        <Style TargetType="views:TaskbarStripContent">
            <Setter Property="UseDarkInk" Value="{Binding IsTaskbarStripLightMode}"/>
        </Style>
    </UserControl.Style>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PCWatch;component/Styles/BlackSurfaces.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="TaskbarFlyoutSurface" TargetType="Border" BasedOn="{StaticResource BlackCard}">
            <Setter Property="Width" Value="246"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGraphiteStyle}" Value="True">
                    <Setter Property="Background" Value="{StaticResource GraphiteBackdrop}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TaskbarSmallTooltip" TargetType="ToolTip">
            <Setter Property="Background" Value="#303132"/>
            <Setter Property="Foreground" Value="#F5F2EA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding UsesBlackLayout}" Value="True">
                    <Setter Property="Background" Value="{StaticResource BlackCardFill}"/>
                    <Setter Property="BorderBrush" Value="#333333"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ToolTip" BasedOn="{StaticResource TaskbarSmallTooltip}"/>
        <Style x:Key="TaskbarCardTooltip" TargetType="ToolTip">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HasDropShadow" Value="True"/>
        </Style>

        <Style x:Key="TaskbarFlyoutHeader" TargetType="ContentControl">
            <Setter Property="Foreground" Value="{StaticResource WhiteInk}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource HardwareSmallIcon}" Data="{TemplateBinding Tag}"
                                  Stroke="{TemplateBinding Foreground}" Width="15" Height="15" Margin="0,0,8,0"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TaskbarFlyoutCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SoftInk}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="TaskbarFlyoutReading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGraphiteStyle}" Value="True">
                    <Setter Property="FontWeight" Value="Light"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TaskbarFlyoutTemperature" TargetType="TextBlock" BasedOn="{StaticResource TaskbarFlyoutReading}">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="Недоступно">
                    <Setter Property="FontSize" Value="11"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TaskbarFlyoutThermometer" TargetType="Path" BasedOn="{StaticResource HardwareSmallIcon}">
            <Setter Property="Data" Value="{StaticResource IconTemperature}"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsColorStyle}" Value="True">
                    <Setter Property="Stroke" Value="{x:Static ctrl:TelemetryPalette.Orange}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TaskbarFlyoutDetail" TargetType="TextBlock" BasedOn="{StaticResource TaskbarFlyoutCaption}">
            <Setter Property="Foreground" Value="#F5F2EA"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style x:Key="TaskbarFlyoutChart" TargetType="ctrl:MetricSparkline">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Capacity" Value="40"/>
            <Setter Property="Margin" Value="0,3,0,2"/>
        </Style>
        <Style x:Key="TaskbarFlyoutDivider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Margin" Value="0,7,0,6"/>
        </Style>

        <Style x:Key="StripLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ABFFFFFF"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding UseDarkInk, RelativeSource={RelativeSource AncestorType=views:TaskbarStripContent}}" Value="True">
                    <Setter Property="Foreground" Value="#4B4B4B"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StripTemperatureStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="20"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding UseDarkInk, RelativeSource={RelativeSource AncestorType=views:TaskbarStripContent}}" Value="True">
                    <Setter Property="Foreground" Value="#0A0A0A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StripValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="24"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding UseDarkInk, RelativeSource={RelativeSource AncestorType=views:TaskbarStripContent}}" Value="True">
                    <Setter Property="Foreground" Value="#0A0A0A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StripSegmentStyle" TargetType="Border">
            <Setter Property="Background" Value="#01000000"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="{Binding Constructor.Taskbar.BlockPadding}"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="60"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="30"/>
            <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
            <Setter Property="ToolTipService.Placement" Value="Top"/>
            <Setter Property="ToolTipService.VerticalOffset" Value="-6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#22FFFFFF"/>
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding UseDarkInk, RelativeSource={RelativeSource AncestorType=views:TaskbarStripContent}}" Value="True"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#1A000000"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <conv:TaskbarInkConverter x:Key="TaskbarInk"/>
        <Style x:Key="TaskbarMetricLabel" TargetType="ContentControl">
            <Setter Property="Margin" Value="{Binding Constructor.Taskbar.LabelPadding}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource TaskbarInk}" ConverterParameter="Label">
                        <Binding Path="Content.LabelBrush" RelativeSource="{RelativeSource Self}"/>
                        <Binding Path="UseDarkInk" RelativeSource="{RelativeSource AncestorType=views:TaskbarStripContent}"/>
                        <Binding Path="ShowMetricColors" RelativeSource="{RelativeSource AncestorType=views:TaskbarStripContent}"/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Path x:Name="Icon" Data="{TemplateBinding Tag}" Style="{StaticResource HardwareSmallIcon}"
                                  Stroke="{TemplateBinding Foreground}" Margin="0"/>
                            <TextBlock x:Name="Caption" Text="{Binding Content.Key, RelativeSource={RelativeSource TemplatedParent}}"
                                       FontSize="10" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Content.UseText, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Caption" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StripLoadWithTemperatureStyle" TargetType="TextBlock" BasedOn="{StaticResource StripValueStyle}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="CPU"/>
                        <Condition Binding="{Binding Constructor.ShowTaskbarCpuTemp}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Margin" Value="{Binding Constructor.Taskbar.ValuePadding}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="GPU"/>
                        <Condition Binding="{Binding Constructor.ShowTaskbarGpuTemp}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Margin" Value="{Binding Constructor.Taskbar.ValuePadding}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        </ResourceDictionary>
    </UserControl.Resources>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch" Margin="{Binding Constructor.Taskbar.OuterPadding}" ctrl:MetricOrder.Value="{Binding Constructor.Taskbar.Order}">

            <Border Tag="CPU" x:Name="CpuSegment" Style="{StaticResource StripSegmentStyle}">
                <Border.Visibility>
                    <MultiBinding Converter="{StaticResource AnyVisible}">
                            <Binding Path="Constructor.ShowTaskbarCpu"/>
                            <Binding Path="Constructor.ShowTaskbarCpuTemp"/>
                        </MultiBinding>
                </Border.Visibility>
                <Border.ToolTip>
                    <ToolTip Style="{StaticResource TaskbarCardTooltip}">
                        <Border Style="{StaticResource TaskbarFlyoutSurface}">
                            <StackPanel>
                                <ContentControl Content="CPU" Tag="{StaticResource IconCpu}" Style="{StaticResource TaskbarFlyoutHeader}"/>
                                <TextBlock Text="{Binding Configuration.Config.CpuName}" Style="{StaticResource TaskbarFlyoutCaption}" TextWrapping="Wrap"/>
                                <UniformGrid Columns="2" Margin="0,7,0,0">
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="{Binding Dashboard.CpuUsageMicro}" Style="{StaticResource TaskbarFlyoutReading}" Height="36"/>
                                        <ctrl:MetricSparkline Points="{Binding SessionMetrics.CpuLoad}" Style="{StaticResource TaskbarFlyoutChart}"/>
                                        <TextBlock Style="{StaticResource TaskbarFlyoutCaption}"><Run Text="Пик "/><Run Text="{Binding SessionMetrics.CpuLoadMax, Mode=OneWay}"/></TextBlock>
                                    </StackPanel>
                                    <StackPanel Margin="6,0,0,0">
                                        <StackPanel Height="36" Orientation="Horizontal" ToolTip="Температура">
                                            <Path Style="{StaticResource TaskbarFlyoutThermometer}"/>
                                            <TextBlock Text="{Binding Dashboard.CpuTempDisplay}" Style="{StaticResource TaskbarFlyoutTemperature}"/>
                                        </StackPanel>
                                        <ctrl:MetricSparkline Points="{Binding SessionMetrics.CpuTemp}" Style="{StaticResource TaskbarFlyoutChart}"/>
                                        <TextBlock Style="{StaticResource TaskbarFlyoutCaption}"><Run Text="Пик "/><Run Text="{Binding SessionMetrics.CpuTempMax, Mode=OneWay}"/></TextBlock>
                                    </StackPanel>
                                </UniformGrid>
                                <Border Style="{StaticResource TaskbarFlyoutDivider}"/>
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Частота" Style="{StaticResource TaskbarFlyoutCaption}"/>
                                    <TextBlock Text="{Binding Dashboard.CpuClockDisplay}" Style="{StaticResource TaskbarFlyoutDetail}"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Мощность" Style="{StaticResource TaskbarFlyoutCaption}"/>
                                    <TextBlock Text="{Binding Dashboard.CpuPowerDisplay}" Style="{StaticResource TaskbarFlyoutDetail}"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Ядра и потоки" Style="{StaticResource TaskbarFlyoutCaption}"/>
                                    <TextBlock Text="{Binding Configuration.Config.CpuCoresThreads}" Style="{StaticResource TaskbarFlyoutDetail}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </ToolTip>
                </Border.ToolTip>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Content="{Binding Constructor.Taskbar.ByKey[CPU]}" Tag="{StaticResource IconCpu}" Style="{StaticResource TaskbarMetricLabel}" Focusable="False"/>
                    <TextBlock Visibility="{Binding Constructor.ShowTaskbarCpuTemp, Converter={StaticResource BoolToVis}}" Text="{Binding Dashboard.CpuTempMicro}" Style="{StaticResource StripTemperatureStyle}">
                        <TextBlock.Foreground>
                            <MultiBinding Converter="{StaticResource TaskbarInk}">
                                <Binding Path="Constructor.Taskbar.ByKey[CPU].TemperatureBrush"/>
                                <Binding Path="UseDarkInk" RelativeSource="{RelativeSource AncestorType=views:TaskbarStripContent}"/>
                                <Binding Path="ShowMetricColors" RelativeSource="{RelativeSource AncestorType=views:TaskbarStripContent}"/>
                            </MultiBinding>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Visibility="{Binding Constructor.ShowTaskbarCpu, Converter={StaticResource BoolToVis}}" Text="{Binding Dashboard.CpuUsageMicro}" Style="{StaticResource StripLoadWithTemperatureStyle}" Tag="CPU">
                        <TextBlock.Foreground>
                            <MultiBinding Converter="{StaticResource TaskbarInk}">
                                <Binding Path="Constructor.Taskbar.ByKey[CPU].ValueBrush"/>
                                <Binding Path="UseDarkInk" RelativeSource="{RelativeSource AncestorType=views:TaskbarStripContent}"/>
                                <Binding Path="ShowMetricColors" RelativeSource="{RelativeSource AncestorType=views:TaskbarStripContent}"/>
                            </MultiBinding>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>
            </Border>



            <Border Tag="GPU" x:Name="GpuSegment" Style="{StaticResource StripSegmentStyle}">
                <Border.Visibility>
                    <MultiBinding Converter="{StaticResource AnyVisible}">
                            <Binding Path="Constructor.ShowTaskbarGpu"/>
                            <Binding Path="Constructor.ShowTaskbarGpuTemp"/>
                        </MultiBinding>
                </Border.Visibility>
                <Border.ToolTip>
                    <ToolTip Style="{StaticResource TaskbarCardTooltip}">
                        <Border Style="{StaticResource TaskbarFlyoutSurface}">
                            <StackPanel>
                                <ContentControl Content="GPU" Tag="{StaticResource IconGpu}" Style="{StaticResource TaskbarFlyoutHeader}"/>
                                <TextBlock Text="{Binding Dashboard.GpuName}" Style="{StaticResource TaskbarFlyoutCaption}" TextWrapping="Wrap"/>
                                <UniformGrid Columns="2" Margin="0,7,0,0">
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="{Binding Dashboard.GpuUsageMicro}" Style="{StaticResource TaskbarFlyoutReading}" Height="36"/>
                                        <ctrl:MetricSparkline Points="{Binding SessionMetrics.GpuLoad}" Style="{StaticResource TaskbarFlyoutChart}"/>
                                        <TextBlock Style="{StaticResource TaskbarFlyoutCaption}"><Run Text="Пик "/><Run Text="{Binding SessionMetrics.GpuLoadMax, Mode=OneWay}"/></TextBlock>
                                    </StackPanel>
                                    <StackPanel Margin="6,0,0,0">
                                        <StackPanel Height="36" Orientation="Horizontal" ToolTip="Температура">
                                            <Path Style="{StaticResource TaskbarFlyoutThermometer}"/>
                                            <TextBlock Text="{Binding Dashboard.GpuTempDisplay}" Style="{StaticResource TaskbarFlyoutTemperature}"/>
                                        </StackPanel>
                                        <ctrl:MetricSparkline Points="{Binding SessionMetrics.GpuTemp}" Style="{StaticResource TaskbarFlyoutChart}"/>
                                        <TextBlock Style="{StaticResource TaskbarFlyoutCaption}"><Run Text="Пик "/><Run Text="{Binding SessionMetrics.GpuTempMax, Mode=OneWay}"/></TextBlock>
                                    </StackPanel>
                                </UniformGrid>
                                <Border Style="{StaticResource TaskbarFlyoutDivider}"/>
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Частота" Style="{StaticResource TaskbarFlyoutCaption}"/>
                                    <TextBlock Text="{Binding Dashboard.GpuClockDisplay}" Style="{StaticResource TaskbarFlyoutDetail}"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Мощность" Style="{StaticResource TaskbarFlyoutCaption}"/>
                                    <TextBlock Text="{Binding Dashboard.GpuPowerDisplay}" Style="{StaticResource TaskbarFlyoutDetail}"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Видеопамять" Style="{StaticResource TaskbarFlyoutCaption}"/>
                                    <TextBlock Text="{Binding Dashboard.VramDisplay}" Style="{StaticResource TaskbarFlyoutDetail}"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Драйвер" Style="{StaticResource TaskbarFlyoutCaption}"/>
                                    <TextBlock Text="{Binding Configuration.Config.PrimaryGpuDriver}" Style="{StaticResource TaskbarFlyoutDetail}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </ToolTip>
                </Border.ToolTip>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Content="{Binding Constructor.Taskbar.ByKey[GPU]}" Tag="{StaticResource IconGpu}" Style="{StaticResource TaskbarMetricLabel}" Focusable="False"/>
                    <TextBlock Visibility="{Binding Constructor.ShowTaskbarGpuTemp, Converter={StaticResource BoolToVis}}" Text="{Binding Dashboard.GpuTempMicro}" Style="{StaticResource StripTemperatureStyle}">
                        <TextBlock.Foreground>
                            <MultiBinding Converter="{StaticResource TaskbarInk}">
                                <Binding Path="Constructor.Taskbar.ByKey[GPU].TemperatureBrush"/>
                                <Binding Path="UseDarkInk" RelativeSource="{RelativeSource AncestorType=views:TaskbarStripContent}"/>
                                <Binding Path="ShowMetricColors" RelativeSource="{RelativeSource AncestorType=views:TaskbarStripContent}"/>
                            </MultiBinding>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Visibility="{Binding Constructor.ShowTaskbarGpu, Converter={StaticResource BoolToVis}}" Text="{Binding Dashboard.GpuUsageMicro}" Style="{StaticResource StripLoadWithTemperatureStyle}" Tag="GPU">
                        <TextBlock.Foreground>
                            <MultiBinding Converter="{StaticResource TaskbarInk}">
                                <Binding Path="Constructor.Taskbar.ByKey[GPU].ValueBrush"/>
                                <Binding Path="UseDarkInk" RelativeSource="{RelativeSource AncestorType=views:TaskbarStripContent}"/>
                                <Binding Path="ShowMetricColors" RelativeSource="{RelativeSource AncestorType=views:TaskbarStripContent}"/>
                            </MultiBinding>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>
            </Border>



            <Border Tag="RAM" x:Name="RamSegment" Visibility="{Binding Constructor.ShowTaskbarRam, Converter={StaticResource BoolToVis}}" Style="{StaticResource StripSegmentStyle}">
                <Border.ToolTip>
                    <ToolTip Style="{StaticResource TaskbarCardTooltip}">
                        <Border Style="{StaticResource TaskbarFlyoutSurface}">
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <ContentControl Content="RAM" AutomationProperties.Name="Оперативная память"
                                                    Tag="{StaticResource IconRam}" Style="{StaticResource TaskbarFlyoutHeader}"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Configuration.Config.RamChannelBadge}" Style="{StaticResource TaskbarFlyoutCaption}"/>
                                </DockPanel>
                                <TextBlock Text="{Binding Dashboard.RamPercentDisplay}" Style="{StaticResource TaskbarFlyoutReading}"/>
                                <ctrl:MetricSparkline Points="{Binding SessionMetrics.Ram}" Style="{StaticResource TaskbarFlyoutChart}"/>
                                <TextBlock Style="{StaticResource TaskbarFlyoutCaption}"><Run Text="Пик "/><Run Text="{Binding SessionMetrics.RamMax, Mode=OneWay}"/></TextBlock>
                                <Border Style="{StaticResource TaskbarFlyoutDivider}"/>
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Занято / всего" Style="{StaticResource TaskbarFlyoutCaption}"/>
                                    <TextBlock Text="{Binding Dashboard.RamCapacityDisplay}" Style="{StaticResource TaskbarFlyoutDetail}" FontWeight="SemiBold"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Свободно" Style="{StaticResource TaskbarFlyoutCaption}"/>
                                    <TextBlock Text="{Binding Dashboard.RamAvailableDisplay}" Style="{StaticResource TaskbarFlyoutDetail}"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Тип и частота" Style="{StaticResource TaskbarFlyoutCaption}"/>
                                    <TextBlock Style="{StaticResource TaskbarFlyoutDetail}"><Run Text="{Binding Configuration.Config.RamType, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Configuration.Config.RamSpeed, Mode=OneWay}"/></TextBlock>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </ToolTip>
                </Border.ToolTip>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Content="{Binding Constructor.Taskbar.ByKey[RAM]}" Tag="{StaticResource IconRam}" Style="{StaticResource TaskbarMetricLabel}" Focusable="False"/>
                    <TextBlock Text="{Binding Dashboard.RamPercentDisplay}" Style="{StaticResource StripValueStyle}">
                        <TextBlock.Foreground>
                            <MultiBinding Converter="{StaticResource TaskbarInk}">
                                <Binding Path="Constructor.Taskbar.ByKey[RAM].ValueBrush"/>
                                <Binding Path="UseDarkInk" RelativeSource="{RelativeSource AncestorType=views:TaskbarStripContent}"/>
                                <Binding Path="ShowMetricColors" RelativeSource="{RelativeSource AncestorType=views:TaskbarStripContent}"/>
                            </MultiBinding>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Tag="VRAM" Style="{StaticResource StripSegmentStyle}" Visibility="{Binding Constructor.ShowTaskbarVram, Converter={StaticResource BoolToVis}}">
                <Border.ToolTip>
                    <ToolTip Style="{StaticResource TaskbarCardTooltip}">
                        <Border Style="{StaticResource TaskbarFlyoutSurface}">
                            <StackPanel>
                                <ContentControl Content="Видеопамять" Tag="{StaticResource IconVram}" Style="{StaticResource TaskbarFlyoutHeader}"/>
                                <TextBlock Text="{Binding Dashboard.VramPercentDisplay}" Style="{StaticResource TaskbarFlyoutReading}"/>
                                <ctrl:MetricSparkline Points="{Binding SessionMetrics.Vram}" Style="{StaticResource TaskbarFlyoutChart}"/>
                                <TextBlock Style="{StaticResource TaskbarFlyoutCaption}"><Run Text="Пик "/><Run Text="{Binding SessionMetrics.VramMax, Mode=OneWay}"/></TextBlock>
                                <Border Style="{StaticResource TaskbarFlyoutDivider}"/>
                                <DockPanel>
                                    <TextBlock Text="Занято / всего" Style="{StaticResource TaskbarFlyoutCaption}"/>
                                    <TextBlock Text="{Binding Dashboard.VramCapacityDisplay}" Style="{StaticResource TaskbarFlyoutDetail}" FontWeight="SemiBold"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </ToolTip>
                </Border.ToolTip>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Content="{Binding Constructor.Taskbar.ByKey[VRAM]}" Tag="{StaticResource IconVram}" Style="{StaticResource TaskbarMetricLabel}" Focusable="False"/>
                    <TextBlock Text="{Binding Dashboard.VramPercentValue, StringFormat={}{0:F0}%}" Style="{StaticResource StripValueStyle}">
                        <TextBlock.Foreground>
                            <MultiBinding Converter="{StaticResource TaskbarInk}">
                                <Binding Path="Constructor.Taskbar.ByKey[VRAM].ValueBrush"/>
                                <Binding Path="UseDarkInk" RelativeSource="{RelativeSource AncestorType=views:TaskbarStripContent}"/>
                                <Binding Path="ShowMetricColors" RelativeSource="{RelativeSource AncestorType=views:TaskbarStripContent}"/>
                            </MultiBinding>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Tag="DISK" Style="{StaticResource StripSegmentStyle}" Visibility="{Binding Constructor.ShowTaskbarDisk, Converter={StaticResource BoolToVis}}">
                <Border.ToolTip>
                    <ToolTip Style="{StaticResource TaskbarCardTooltip}">
                        <Border Style="{StaticResource TaskbarFlyoutSurface}">
                            <StackPanel Grid.IsSharedSizeScope="True">
                                <ContentControl Content="Диски" Tag="{StaticResource IconDisk}" Style="{StaticResource TaskbarFlyoutHeader}"/>
                                <Grid Margin="0,1,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="DiskRead"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="DiskWrite"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="Чтение" Style="{StaticResource TaskbarFlyoutCaption}" HorizontalAlignment="Right" Margin="10,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="Запись" Style="{StaticResource TaskbarFlyoutCaption}" HorizontalAlignment="Right" Margin="10,0,0,0"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Dashboard.PhysicalDisks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="DiskRead"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="DiskWrite"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource TaskbarFlyoutCaption}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Read}" Style="{StaticResource TaskbarFlyoutDetail}" Margin="10,0,0,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Write}" Style="{StaticResource TaskbarFlyoutDetail}" Margin="10,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </ToolTip>
                </Border.ToolTip>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Content="{Binding Constructor.Taskbar.ByKey[DISK]}" Tag="{StaticResource IconDisk}" Style="{StaticResource TaskbarMetricLabel}" Focusable="False"/>
                    <TextBlock Text="{Binding Dashboard.DiskCompact}" Style="{StaticResource StripValueStyle}">
                        <TextBlock.Foreground>
                            <MultiBinding Converter="{StaticResource TaskbarInk}">
                                <Binding Path="Constructor.Taskbar.ByKey[DISK].ValueBrush"/>
                                <Binding Path="UseDarkInk" RelativeSource="{RelativeSource AncestorType=views:TaskbarStripContent}"/>
                                <Binding Path="ShowMetricColors" RelativeSource="{RelativeSource AncestorType=views:TaskbarStripContent}"/>
                            </MultiBinding>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border ToolTip="Сеть: приём и отправка" Tag="NET" Style="{StaticResource StripSegmentStyle}" Visibility="{Binding Constructor.ShowTaskbarNetwork, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Content="{Binding Constructor.Taskbar.ByKey[NET]}" Tag="{StaticResource IconNetwork}" Style="{StaticResource TaskbarMetricLabel}" Focusable="False"/>
                    <TextBlock Text="{Binding Dashboard.NetworkCompact}" Style="{StaticResource StripValueStyle}" FontWeight="Normal" FontSize="11" MinWidth="0">
                        <TextBlock.Foreground>
                            <MultiBinding Converter="{StaticResource TaskbarInk}">
                                <Binding Path="Constructor.Taskbar.ByKey[NET].ValueBrush"/>
                                <Binding Path="UseDarkInk" RelativeSource="{RelativeSource AncestorType=views:TaskbarStripContent}"/>
                                <Binding Path="ShowMetricColors" RelativeSource="{RelativeSource AncestorType=views:TaskbarStripContent}"/>
                            </MultiBinding>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border ToolTip="Время работы компьютера" Tag="UPTIME" Style="{StaticResource StripSegmentStyle}" Visibility="{Binding Constructor.ShowTaskbarUptime, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Content="{Binding Constructor.Taskbar.ByKey[UPTIME]}" Tag="{StaticResource IconUptime}" Style="{StaticResource TaskbarMetricLabel}" Focusable="False"/>
                    <TextBlock Text="{Binding Dashboard.Uptime}" Style="{StaticResource StripValueStyle}">
                        <TextBlock.Foreground>
                            <MultiBinding Converter="{StaticResource TaskbarInk}">
                                <Binding Path="Constructor.Taskbar.ByKey[UPTIME].ValueBrush"/>
                                <Binding Path="UseDarkInk" RelativeSource="{RelativeSource AncestorType=views:TaskbarStripContent}"/>
                                <Binding Path="ShowMetricColors" RelativeSource="{RelativeSource AncestorType=views:TaskbarStripContent}"/>
                            </MultiBinding>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border x:Name="BatteryRuntimeSegment" Tag="BAT" ToolTip="Примерное время работы от батареи">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StripSegmentStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Constructor.ShowTaskbarBatteryRuntime}" Value="True"/>
                                    <Condition Binding="{Binding Dashboard.Battery.IsOnBattery}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Content="{Binding Constructor.Taskbar.ByKey[BAT]}" Tag="{StaticResource IconBatteryRuntime}"
                                    Style="{StaticResource TaskbarMetricLabel}" Focusable="False"/>
                    <TextBlock Text="{Binding Dashboard.Battery.TaskbarRemainingText}"
                               Style="{StaticResource StripValueStyle}" MinWidth="47">
                        <TextBlock.Foreground>
                            <MultiBinding Converter="{StaticResource TaskbarInk}">
                                <Binding Path="Constructor.Taskbar.ByKey[BAT].ValueBrush"/>
                                <Binding Path="UseDarkInk" RelativeSource="{RelativeSource AncestorType=views:TaskbarStripContent}"/>
                                <Binding Path="ShowMetricColors" RelativeSource="{RelativeSource AncestorType=views:TaskbarStripContent}"/>
                            </MultiBinding>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Tag="PWR" ToolTip="{Binding Dashboard.SystemPowerHint}" Style="{StaticResource StripSegmentStyle}"
                    Visibility="{Binding Constructor.ShowTaskbarPower, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Content="{Binding Constructor.Taskbar.ByKey[PWR]}" Tag="{StaticResource IconPower}"
                                    Style="{StaticResource TaskbarMetricLabel}" Focusable="False"/>
                    <TextBlock Text="{Binding Dashboard.SystemPowerText}" Style="{StaticResource StripValueStyle}" MinWidth="48">
                        <TextBlock.Foreground>
                            <MultiBinding Converter="{StaticResource TaskbarInk}">
                                <Binding Path="Constructor.Taskbar.ByKey[PWR].ValueBrush"/>
                                <Binding Path="UseDarkInk" RelativeSource="{RelativeSource AncestorType=views:TaskbarStripContent}"/>
                                <Binding Path="ShowMetricColors" RelativeSource="{RelativeSource AncestorType=views:TaskbarStripContent}"/>
                            </MultiBinding>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>
            </Border>
            <TextBlock Text="Нет показателей" Style="{StaticResource StripLabelStyle}" VerticalAlignment="Center" Margin="6,0">
                <TextBlock.Visibility>
                    <MultiBinding Converter="{StaticResource AllHiddenToVisibility}">
                        <Binding Path="Constructor.ShowTaskbarCpu"/>
                        <Binding Path="Constructor.ShowTaskbarCpuTemp"/>
                        <Binding Path="Constructor.ShowTaskbarGpu"/>
                        <Binding Path="Constructor.ShowTaskbarGpuTemp"/>
                        <Binding Path="Constructor.ShowTaskbarRam"/>
                        <Binding Path="Constructor.ShowTaskbarVram"/>
                        <Binding Path="Constructor.ShowTaskbarDisk"/>
                        <Binding Path="Constructor.ShowTaskbarNetwork"/>
                        <Binding Path="Constructor.ShowTaskbarUptime"/>
                        <Binding Path="Constructor.ShowTaskbarPower"/>
                        <Binding Path="Visibility" ElementName="BatteryRuntimeSegment"/>
                    </MultiBinding>
                </TextBlock.Visibility>
            </TextBlock>
        </StackPanel>
</UserControl>
