<UserControl x:Class="RenderWatch.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <!-- Top Filter & Actions Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource BrushSurfaceCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="16,10" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0"/>
                <ComboBox Grid.Column="1" SelectedItem="{Binding StatusFilter}" Margin="0,0,12,0">
                    <ComboBoxItem Content="Все" IsSelected="True"/>
                    <ComboBoxItem Content="Завершён"/>
                    <ComboBoxItem Content="Рендер выполняется"/>
                    <ComboBoxItem Content="Возможно завершён"/>
                    <ComboBoxItem Content="Возможно завис"/>
                </ComboBox>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Экспорт CSV" Command="{Binding ExportCsvCommand}" Style="{StaticResource MinimalButton}" Margin="0,0,8,0"/>
                    <Button Content="Обновить" Command="{Binding RefreshCommand}" Style="{StaticResource MinimalButton}" Margin="0,0,8,0"/>
                    <Button Content="Очистить всё" Command="{Binding ClearAllCommand}" Style="{StaticResource MinimalButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sessions DataGrid -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredSessions}" SelectedItem="{Binding SelectedSession}" Margin="0,0,0,16">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Время запуска" Binding="{Binding FormattedDate}" Width="150"/>
                <DataGridTextColumn Header="Сцена" Binding="{Binding SceneName}" Width="200"/>
                <DataGridTextColumn Header="Программа" Binding="{Binding AppName}" Width="140"/>
                <DataGridTextColumn Header="Длительность" Binding="{Binding FormattedDuration}" Width="110"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding FinalStatus}" Width="120"/>
                <DataGridTextColumn Header="Avg CPU" Binding="{Binding AvgCpuUsage, StringFormat={}{0:F1}%}" Width="80"/>
                <DataGridTextColumn Header="Peak GPU" Binding="{Binding PeakGpuUsage, StringFormat={}{0:F0}%}" Width="80"/>
                <DataGridTextColumn Header="Пик VRAM" Binding="{Binding PeakVramGb, StringFormat={}{0:F1} ГБ}" Width="90"/>
                <DataGridTextColumn Header="Заметки" Binding="{Binding UserNotes}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Bottom Split: Notes & Comparison -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Notes Editor -->
            <Border Grid.Column="0" Background="{StaticResource BrushSurfaceCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="ЗАМЕТКИ К ВЫБРАННОЙ СЕССИИ" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBox Grid.Row="1" Text="{Binding NotesEditorText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Удалить сессию" Command="{Binding DeleteSessionCommand}" Style="{StaticResource MinimalButton}" Margin="0,0,8,0"/>
                        <Button Content="Сохранить заметку" Command="{Binding SaveNotesCommand}" Style="{StaticResource AccentButton}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Comparison Panel -->
            <Border Grid.Column="1" Background="{StaticResource BrushSurfaceCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="ЖУРНАЛ СРАВНЕНИЯ ПРОИЗВОДИТЕЛЬНОСТИ" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="1" Text="{Binding ComparisonSummary}" TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" FontFamily="Consolas, Segoe UI"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Выбрать как А" Command="{Binding SetCompareACommand}" Style="{StaticResource MinimalButton}" Margin="0,0,8,0"/>
                        <Button Content="Выбрать как Б" Command="{Binding SetCompareBCommand}" Style="{StaticResource MinimalButton}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>