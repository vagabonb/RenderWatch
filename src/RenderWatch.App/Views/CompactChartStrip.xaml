<UserControl x:Class="RenderWatch.App.Views.CompactChartStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:RenderWatch.App.Controls"
             xmlns:views="clr-namespace:RenderWatch.App.Views"
             Focusable="False">
    <Grid>
        <TextBlock Text="Добавьте графики в конструкторе" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource BrushTextSecondary}" FontSize="11">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Constructor.ActiveCompactGraphs.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False">
            <ItemsControl ItemsSource="{Binding Constructor.ActiveCompactGraphs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ctrl:MetricGraphControl Height="{x:Static views:CompactChartStrip.ChartHeight}" Margin="0,0,0,5"
                                                 Title="{Binding Title}" AutomationProperties.Name="{Binding Title}"
                                                 PointsSource="{Binding Points}" MaxValue="{Binding Scale}"
                                                 Unit="{Binding Unit}" CurrentValueText="{Binding Reading}"
                                                 IsTransferRate="{Binding IsTransferRate}" Capacity="40" IsMiniature="True"
                                                 IsFlat="{Binding DataContext.IsGraphiteStyle, RelativeSource={RelativeSource AncestorType=views:CompactChartStrip}}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
