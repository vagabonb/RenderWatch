<UserControl x:Class="RenderWatch.App.Views.GraphiteNotchContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:RenderWatch.App.Controls"
             xmlns:views="clr-namespace:RenderWatch.App.Views"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="GraphiteMetricName" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SoftInk}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style x:Key="GraphiteReading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource WhiteInk}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
            <Setter Property="FontSize" Value="29"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="GraphiteDetail" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SoftInk}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="GraphiteRate" TargetType="TextBlock" BasedOn="{StaticResource GraphiteDetail}">
            <Setter Property="Foreground" Value="{StaticResource WhiteInk}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style x:Key="GraphiteThermometer" TargetType="Path">
            <Setter Property="Data" Value="{StaticResource IconTemperature}"/>
            <Setter Property="Stroke" Value="{StaticResource WhiteInk}"/>
            <Setter Property="StrokeThickness" Value="1.15"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="GraphiteHistory" TargetType="ctrl:MetricSparkline">
            <Setter Property="Capacity" Value="40"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style x:Key="GraphiteMetric" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,0,0,7"/>
            <Setter Property="Margin" Value="9,0,9,11"/>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="5,3,5,0">
        <UniformGrid x:Name="MetricGroups" Columns="2" Margin="-9,0" SizeChanged="OnMetricGroupsSizeChanged">
            <Border Style="{StaticResource GraphiteMetric}">
                <StackPanel AutomationProperties.Name="Процессор">
                    <TextBlock Text="CPU" Style="{StaticResource GraphiteMetricName}"/>
                    <DockPanel Margin="0,1,0,0">
                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" ToolTip="Температура процессора">
                                <Path Style="{StaticResource GraphiteThermometer}"/>
                                <TextBlock Text="{Binding Dashboard.CpuTempMicro}" Style="{StaticResource GraphiteRate}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Dashboard.CpuClockDisplay}" Style="{StaticResource GraphiteDetail}" TextAlignment="Right"
                                       ToolTip="{Binding Dashboard.CpuPowerDisplay, StringFormat='Мощность · {0}'}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Dashboard.CpuUsageMicro}" Style="{StaticResource GraphiteReading}"/>
                    </DockPanel>
                    <ctrl:MetricSparkline Points="{Binding SessionMetrics.CpuLoad}" Style="{StaticResource GraphiteHistory}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GraphiteMetric}">
                <StackPanel AutomationProperties.Name="Видеокарта" ToolTip="{Binding Dashboard.GpuName}">
                    <TextBlock Text="GPU" Style="{StaticResource GraphiteMetricName}"/>
                    <DockPanel Margin="0,1,0,0">
                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" ToolTip="Температура видеокарты">
                                <Path Style="{StaticResource GraphiteThermometer}"/>
                                <TextBlock Text="{Binding Dashboard.GpuTempMicro}" Style="{StaticResource GraphiteRate}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Dashboard.GpuClockDisplay}" Style="{StaticResource GraphiteDetail}" TextAlignment="Right"
                                       ToolTip="{Binding Dashboard.GpuPowerDisplay, StringFormat='Мощность · {0}'}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Dashboard.GpuUsageMicro}" Style="{StaticResource GraphiteReading}"/>
                    </DockPanel>
                    <ctrl:MetricSparkline Points="{Binding SessionMetrics.GpuLoad}" Style="{StaticResource GraphiteHistory}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GraphiteMetric}">
                <StackPanel AutomationProperties.Name="Оперативная память">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Dashboard.RamCapacityDisplay}" Style="{StaticResource GraphiteDetail}"
                                   ToolTip="Занято / всего" Margin="7,0,0,0"/>
                        <TextBlock Text="RAM" Style="{StaticResource GraphiteMetricName}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Dashboard.RamPercentDisplay}" Style="{StaticResource GraphiteReading}" Margin="0,1,0,0"/>
                    <ctrl:MetricSparkline Points="{Binding SessionMetrics.Ram}" Style="{StaticResource GraphiteHistory}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GraphiteMetric}">
                <StackPanel AutomationProperties.Name="Видеопамять">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Dashboard.VramCapacityDisplay}" Style="{StaticResource GraphiteDetail}"
                                   ToolTip="Занято / всего" Margin="7,0,0,0"/>
                        <TextBlock Text="VRAM" Style="{StaticResource GraphiteMetricName}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Dashboard.VramPercentValue, StringFormat={}{0:F0}%}" Style="{StaticResource GraphiteReading}" Margin="0,1,0,0"/>
                    <ctrl:MetricSparkline Points="{Binding SessionMetrics.Vram}" Style="{StaticResource GraphiteHistory}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <UniformGrid x:Name="TransferGroups" Columns="2" Margin="-9,0" SizeChanged="OnTransferGroupsSizeChanged">
            <StackPanel Margin="9,0,9,5">
                <TextBlock Text="ДИСКИ" Style="{StaticResource GraphiteMetricName}"/>
                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Dashboard.DiskRead}" Style="{StaticResource GraphiteRate}" Margin="6,0,0,0"/>
                    <TextBlock Text="Чтение" Style="{StaticResource GraphiteDetail}"/>
                </DockPanel>
                <DockPanel Margin="0,4,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Dashboard.DiskWrite}" Style="{StaticResource GraphiteRate}" Margin="6,0,0,0"/>
                    <TextBlock Text="Запись" Style="{StaticResource GraphiteDetail}"/>
                </DockPanel>
            </StackPanel>
            <StackPanel Margin="9,0,9,5">
                <TextBlock Text="СЕТЬ" Style="{StaticResource GraphiteMetricName}"/>
                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Dashboard.NetworkReceive}" Style="{StaticResource GraphiteRate}" Margin="6,0,0,0"/>
                    <TextBlock Text="Приём" Style="{StaticResource GraphiteDetail}"/>
                </DockPanel>
                <DockPanel Margin="0,4,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Dashboard.NetworkSend}" Style="{StaticResource GraphiteRate}" Margin="6,0,0,0"/>
                    <TextBlock Text="Отправка" Style="{StaticResource GraphiteDetail}"/>
                </DockPanel>
            </StackPanel>
        </UniformGrid>

        <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource Hairline}" Margin="0,8,0,0" Padding="0,3,0,0"
                Visibility="{Binding Dashboard.Battery.IsPresent, Converter={StaticResource BoolToVis}}">
            <views:BatteryCard DataContext="{Binding Dashboard.Battery}" Background="Transparent" IsMonochrome="True"/>
        </Border>
    </StackPanel>
</UserControl>
