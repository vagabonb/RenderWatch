<UserControl x:Class="RenderWatch.App.Views.BatteryCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:RenderWatch.App.Controls"
             xmlns:views="clr-namespace:RenderWatch.App.Views"
             Visibility="{Binding Battery.IsPresent, Converter={StaticResource BoolToVis}}"
             Focusable="False" AutomationProperties.Name="Батарея">
    <UserControl.Template>
        <ControlTemplate TargetType="UserControl">
            <ContentPresenter/>
        </ControlTemplate>
    </UserControl.Template>
    <UserControl.Resources>
        <Style x:Key="BatteryLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B4B4B4"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="BatteryValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="BatteryReadout" TargetType="StackPanel">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="3,0"/>
        </Style>
    </UserControl.Resources>
    <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=UserControl}}"
            Padding="10,7" CornerRadius="6">
        <UniformGrid x:Name="BatteryMetrics" Rows="1">
            <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                <Grid Width="35" Height="35" Margin="0,0,5,0" ToolTip="Оставшийся заряд">
                    <ctrl:UsageRing Value="{Binding Battery.RingFill}" StrokeThickness="2.5">
                        <ctrl:UsageRing.Style>
                            <Style TargetType="ctrl:UsageRing">
                                <Setter Property="AccentBrush" Value="{Binding Battery.AccentBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMonochrome, RelativeSource={RelativeSource AncestorType=views:BatteryCard}}" Value="True">
                                        <Setter Property="AccentBrush" Value="#E7E7E7"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ctrl:UsageRing.Style>
                    </ctrl:UsageRing>
                    <TextBlock Text="{Binding Battery.ChargeText}" Style="{StaticResource BatteryValue}" FontSize="10"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Батарея" Style="{StaticResource BatteryValue}"/>
                    <TextBlock Text="{Binding Battery.StateText}" ToolTip="{Binding Battery.StateText}" Style="{StaticResource BatteryLabel}"/>
                </StackPanel>
            </WrapPanel>
            <StackPanel Style="{StaticResource BatteryReadout}" ToolTip="{Binding SystemPowerHint}">
                <TextBlock Text="{Binding SystemPowerCaption}" Style="{StaticResource BatteryLabel}" TextAlignment="Center"/>
                <TextBlock Text="{Binding SystemPowerText}" Style="{StaticResource BatteryValue}" TextAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel x:Name="RemainingReadout" Style="{StaticResource BatteryReadout}" HorizontalAlignment="Right">
                <TextBlock Text="Осталось" Style="{StaticResource BatteryLabel}" TextAlignment="Right"/>
                <TextBlock Text="{Binding Battery.RemainingText}" ToolTip="{Binding Battery.RemainingText}"
                           Style="{StaticResource BatteryValue}" TextAlignment="Right" Margin="0,2,0,0"/>
            </StackPanel>
        </UniformGrid>
    </Border>
</UserControl>
