<UserControl x:Class="RenderWatch.App.Views.BatteryCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:RenderWatch.App.Controls"
             xmlns:views="clr-namespace:RenderWatch.App.Views"
             Visibility="{Binding IsPresent, Converter={StaticResource BoolToVis}}"
             Focusable="False" AutomationProperties.Name="Батарея">
    <UserControl.Template>
        <ControlTemplate TargetType="UserControl">
            <ContentPresenter/>
        </ControlTemplate>
    </UserControl.Template>
    <UserControl.Resources>
        <Style x:Key="BatteryLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B4B4B4"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="BatteryValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>
    <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=UserControl}}"
            Padding="10,7" CornerRadius="6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Margin="0,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="35" Height="35" Margin="0,0,5,0" ToolTip="Оставшийся заряд">
                    <ctrl:UsageRing Value="{Binding RingFill}" StrokeThickness="2.5">
                        <ctrl:UsageRing.Style>
                            <Style TargetType="ctrl:UsageRing">
                                <Setter Property="AccentBrush" Value="{Binding AccentBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMonochrome, RelativeSource={RelativeSource AncestorType=views:BatteryCard}}" Value="True">
                                        <Setter Property="AccentBrush" Value="#E7E7E7"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ctrl:UsageRing.Style>
                    </ctrl:UsageRing>
                    <TextBlock Text="{Binding ChargeText}" Style="{StaticResource BatteryValue}" FontSize="10"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Батарея" Style="{StaticResource BatteryValue}"/>
                    <TextBlock Text="{Binding StateText}" ToolTip="{Binding StateText}" Style="{StaticResource BatteryLabel}"/>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                <TextBlock Text="{Binding PowerCaption}" Style="{StaticResource BatteryLabel}"/>
                <TextBlock Text="{Binding PowerText}" Style="{StaticResource BatteryValue}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,0,0">
                <TextBlock Text="Осталось" Style="{StaticResource BatteryLabel}"/>
                <TextBlock Text="{Binding RemainingText}" ToolTip="{Binding RemainingText}"
                           Style="{StaticResource BatteryValue}" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
