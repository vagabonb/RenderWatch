<UserControl x:Class="RenderWatch.App.Views.AppearancePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Button Click="OnOpenModes" Padding="9,5" Cursor="Hand" Background="Transparent" BorderThickness="0"
            Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" FontWeight="Normal"
            ToolTip="Выбрать режим оформления" AutomationProperties.Name="Режим оформления">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                    <ContentPresenter VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Surface" Property="Background" Value="#18FFFFFF"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="Surface" Property="Background" Value="#28FFFFFF"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding AppearanceName}" VerticalAlignment="Center"/>
            <Path Data="M 1,1 L 4,4 L 7,1" Width="7" Height="4" Margin="8,0,0,0" Stretch="Uniform"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
        </StackPanel>
        <Button.ContextMenu>
            <ContextMenu Background="#252525" Foreground="#EFEFEF" BorderThickness="0" Padding="4">

                <ContextMenu.Template>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </ContextMenu.Template>
                <ContextMenu.Resources>
                    <Style TargetType="MenuItem">
                        <Setter Property="MinWidth" Value="145"/>
                        <Setter Property="Height" Value="32"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="MenuItem">
                                    <Border x:Name="Row" Background="Transparent" Padding="11,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Path x:Name="Check" Visibility="Collapsed" Data="M 1,4 L 4,7 L 10,1"
                                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2"
                                                  Width="10" Height="7" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="#1CFFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ContextMenu.Resources>
                <MenuItem Header="Блэк" IsChecked="{Binding IsBlackStyle, Mode=OneWay}"
                          Command="{Binding SetAppearanceCommand}" CommandParameter="Black"/>
                <MenuItem Header="Графит" IsChecked="{Binding IsGraphiteStyle, Mode=OneWay}"
                          Command="{Binding SetAppearanceCommand}" CommandParameter="Graphite"/>
            </ContextMenu>
        </Button.ContextMenu>
    </Button>
</UserControl>
