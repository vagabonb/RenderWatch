<UserControl x:Class="RenderWatch.App.Views.ConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RenderWatch.App.ViewModels"
             Background="{StaticResource BrushBg}">

    <UserControl.Resources>
        <!-- Pure Monochrome Card Style -->
        <Style x:Key="SpecCard" TargetType="Border">
            <Setter Property="Background" Value="#141414"/>
            <Setter Property="BorderBrush" Value="#252525"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20,18"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Subcard / Detail Box -->
        <Style x:Key="DetailItemBox" TargetType="Border">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>

        <!-- Channel Badge Style -->
        <Style x:Key="ChannelBadge" TargetType="Border">
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Sleek Pure Monochrome ProgressBar -->
        <Style x:Key="MonochromeProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="#262626"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                            <Grid>
                                <Border x:Name="PART_Track"/>
                                <Border x:Name="PART_Indicator" Background="#E0E0E0" CornerRadius="3" HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20,24,24">
        <StackPanel MaxWidth="1140">

            <!-- ============================================== -->
            <!-- 1. HEADER & ACTION BUTTONS                     -->
            <!-- ============================================== -->
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Subtitle -->
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="КОНФИГУРАЦИЯ" Foreground="#FFFFFF" FontWeight="Bold" FontSize="18" FontFamily="{StaticResource FontDisplay}" Margin="0,0,8,0"/>
                        <TextBlock Text="СИСТЕМЫ" Foreground="#A0A0A0" FontWeight="Bold" FontSize="18" FontFamily="{StaticResource FontDisplay}"/>
                    </StackPanel>
                    <TextBlock Text="Аппаратная спецификация, шины памяти, дисковая подсистема и электропитание" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Right: Copy & Refresh Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Copy Confirmation Toast Badge -->
                    <Border Background="#222222" BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="4" Padding="10,5" Margin="0,0,12,0"
                            Visibility="{Binding IsCopyFeedbackVisible, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding CopyFeedbackMessage}" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold"/>
                    </Border>

                    <!-- Copy Button -->
                    <Button Command="{Binding CopySpecsCommand}" Style="{StaticResource MinimalButton}" Margin="0,0,8,0" Padding="12,7" ToolTip="Скопировать всю конфигурацию в текстовом виде">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Text="Скопировать" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <!-- Refresh Button -->
                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource MinimalButton}" Padding="12,7" ToolTip="Заново опросить WMI и системные шины">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↺" FontSize="13" Margin="0,0,6,0" FontWeight="Bold"/>
                            <TextBlock Text="Обновить" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============================================== -->
            <!-- 2. CPU & RAM SPEC CARDS (ROW 1)                -->
            <!-- ============================================== -->
            <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CARD 1: ПРОЦЕССОР (CPU) -->
                <Border Grid.Column="0" Style="{StaticResource SpecCard}">
                    <StackPanel>
                        <!-- Card Header -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" Background="#1E1E1E" CornerRadius="6" Margin="0,0,12,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M 4,4 h 16 v 16 h -16 z M 8,8 h 8 v 8 h -8 z M 7,1 v 3 M 12,1 v 3 M 17,1 v 3 M 7,20 v 3 M 12,20 v 3 M 17,20 v 3 M 1,7 h 3 M 1,12 h 3 M 1,17 h 3 M 20,7 h 3 M 20,12 h 3 M 20,17 h 3"
                                      Stroke="#FFFFFF" StrokeThickness="1.2" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="ПРОЦЕССОР" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Config.CpuName}" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Details Grid -->
                        <Grid Margin="0,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource DetailItemBox}">
                                <StackPanel>
                                    <TextBlock Text="ЯДРА И ПОТОКИ" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Config.CpuCoresThreads}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource DetailItemBox}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="БАЗОВАЯ ЧАСТОТА" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Config.CpuFrequency}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource DetailItemBox}">
                                <StackPanel>
                                    <TextBlock Text="МАКСИМАЛЬНАЯ ЧАСТОТА" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Config.CpuMaxFrequency}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailItemBox}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="СОКЕТ ПРОЦЕССОРА" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Config.CpuSocket}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource DetailItemBox}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="АРХИТЕКТУРА" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Config.CpuArchitecture}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource DetailItemBox}" Margin="0,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="КЭШ-ПАМЯТЬ L2 / L3" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Config.CpuCache}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CARD 2: ОПЕРАТИВНАЯ ПАМЯТЬ (RAM) -->
                <Border Grid.Column="2" Style="{StaticResource SpecCard}">
                    <StackPanel>
                        <!-- Card Header with Channel Badge -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" Background="#1E1E1E" CornerRadius="6" Margin="0,0,12,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M 2,6 h 20 v 11 h -8 v 2 h -2 v -2 h -10 z M 4,8 h 3 v 5 h -3 z M 9,8 h 3 v 5 h -3 z M 14,8 h 3 v 5 h -3 z M 19,8 h 1 v 5 h -1 z M 3,18 h 6 M 13,18 h 7"
                                      Stroke="#FFFFFF" StrokeThickness="1.2" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="ОПЕРАТИВНАЯ ПАМЯТЬ" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Config.RamTotalCapacity, StringFormat='{}{0} Общий объем'}" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <!-- Prominent Channel Mode Badge -->
                            <Border Grid.Column="2" Style="{StaticResource ChannelBadge}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡" FontSize="11" Foreground="#FFFFFF" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding Config.RamChannelBadge}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Details Grid -->
                        <Grid Margin="0,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource DetailItemBox}">
                                <StackPanel>
                                    <TextBlock Text="РЕЖИМ КАНАЛОВ" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Config.RamChannelMode}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource DetailItemBox}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="ТИП И ПОКОЛЕНИЕ" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Config.RamType}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource DetailItemBox}">
                                <StackPanel>
                                    <TextBlock Text="ЧАСТОТА ПАМЯТИ" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Config.RamSpeed}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailItemBox}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="ИСПОЛЬЗУЕМЫЕ СЛОТЫ" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Config.RamSlotsUsed}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource DetailItemBox}" Margin="0,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="КОНФИГУРАЦИЯ МОДУЛЕЙ" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Config.RamModules.Count, StringFormat='{}Установлено физических модулей: {0}'}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============================================== -->
            <!-- 3. MOTHERBOARD & GPU CARDS (ROW 2)             -->
            <!-- ============================================== -->
            <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CARD 3: МАТЕРИНСКАЯ ПЛАТА -->
                <Border Grid.Column="0" Style="{StaticResource SpecCard}">
                    <StackPanel>
                        <!-- Card Header -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" Background="#1E1E1E" CornerRadius="6" Margin="0,0,12,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M 3,3 h 18 v 18 h -18 z M 6,6 h 4 v 4 h -4 z M 14,6 h 4 v 2 h -4 z M 14,10 h 4 v 2 h -4 z M 6,14 h 6 v 4 h -6 z M 15,15 h 3 v 3 h -3 z"
                                      Stroke="#FFFFFF" StrokeThickness="1.2" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="МАТЕРИНСКАЯ ПЛАТА" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Config.MotherboardProduct}" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Details Grid -->
                        <Grid Margin="0,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource DetailItemBox}">
                                <StackPanel>
                                    <TextBlock Text="ПРОИЗВОДИТЕЛЬ" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Config.MotherboardManufacturer}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource DetailItemBox}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="РЕВИЗИЯ ПЛАТЫ" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Config.MotherboardVersion, StringFormat='{}Ревизия: {0}'}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource DetailItemBox}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="ВЕРСИЯ BIOS / UEFI" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Config.BiosVersion}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailItemBox}" Margin="0,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="ДАТА ВЫПУСКА BIOS" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Config.BiosDate}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CARD 4: ВИДЕОКАРТА (GPU) -->
                <Border Grid.Column="2" Style="{StaticResource SpecCard}">
                    <StackPanel>
                        <!-- Card Header -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" Background="#1E1E1E" CornerRadius="6" Margin="0,0,12,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M 2,5 h 20 v 14 h -20 z M 2,2 v 18 M 8,9 a 3,3 0 1 0 0.1,0 M 16,9 a 3,3 0 1 0 0.1,0 M 8,12 h 0.01 M 16,12 h 0.01 M 5,19 v 3 h 7 v -3"
                                      Stroke="#FFFFFF" StrokeThickness="1.2" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="ВИДЕОКАРТА" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Config.PrimaryGpuName}" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Details Grid -->
                        <Grid Margin="0,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource DetailItemBox}">
                                <StackPanel>
                                    <TextBlock Text="ВИДЕОПАМЯТЬ (VRAM)" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Config.PrimaryGpuVram}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource DetailItemBox}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="ВЕРСИЯ ДРАЙВЕРА" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Config.PrimaryGpuDriver}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource DetailItemBox}" Margin="0,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="ВТОРИЧНЫЙ АДАПТЕР / ВСТРОЕННАЯ ГРАФИКА" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Config.SecondaryGpuName, TargetNullValue='Отсутствует / Отключена'}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============================================== -->
            <!-- 4. STORAGE / DISKS CARD (ROW 3 - ENHANCED)     -->
            <!-- ============================================== -->
            <Border Style="{StaticResource SpecCard}">
                <StackPanel>
                    <!-- Card Header -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" Background="#1E1E1E" CornerRadius="6" Margin="0,0,12,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M 3,4 h 18 v 6 h -18 z M 3,14 h 18 v 6 h -18 z M 17,7 h 2 M 17,17 h 2 M 14,7 h 1 M 14,17 h 1"
                                  Stroke="#FFFFFF" StrokeThickness="1.2" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="НАКОПИТЕЛИ И ДИСКИ" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Config.TotalStorageCapacity}" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" Margin="0,2,0,0"/>
                        </StackPanel>
                        <!-- Physical Disks Count Badge -->
                        <Border Grid.Column="2" Style="{StaticResource ChannelBadge}">
                            <TextBlock Text="{Binding Config.PhysicalDisksSummary, TargetNullValue='Накопители'}" Foreground="#A0A0A0" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <!-- Section Header 1: Physical Drive Models -->
                    <TextBlock Text="ФИЗИЧЕСКИЕ НАКОПИТЕЛИ (МОДЕЛИ)" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>

                    <!-- Physical Disks List: Each Model Listed on Its Own Separate Row! -->
                    <ItemsControl ItemsSource="{Binding Config.PhysicalDisks}" Margin="0,0,0,14">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#181818" BorderBrush="#262626" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Index & Interface Badge -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <Border Background="#222222" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding DisplayIndex}" Foreground="#A0A0A0" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                            <Border Background="#282828" CornerRadius="3" Padding="6,2">
                                                <TextBlock Text="{Binding InterfaceType}" Foreground="#FFFFFF" FontSize="10" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Center: Full Model Name (never truncated, clear bold text) -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Model}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Right: Capacity & Partitions -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Capacity}" Foreground="#E0E0E0" FontSize="12" FontWeight="Bold" Margin="0,0,8,0"/>
                                            <Border Background="#202020" BorderBrush="#333333" BorderThickness="1" CornerRadius="3" Padding="6,2">
                                                <TextBlock Text="{Binding PartitionsCount}" Foreground="#888888" FontSize="10" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Section Header 2: Logical Volumes & Partitions -->
                    <TextBlock Text="ЛОГИЧЕСКИЕ РАЗДЕЛЫ И ТОМА" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>

                    <!-- Logical Disks ItemsControl -->
                    <ItemsControl ItemsSource="{Binding Config.Disks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Left: Drive Name & Type -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🖴" FontSize="13" Foreground="#FFFFFF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <Border Background="#252525" CornerRadius="3" Padding="6,1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding FileSystem}" Foreground="#A0A0A0" FontSize="10" FontWeight="SemiBold"/>
                                                </Border>
                                                <TextBlock Text="{Binding DiskType}" Foreground="#707070" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Right: Free & Total Space -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FreeSpace}" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold" Margin="0,0,6,0"/>
                                                <TextBlock Text="из" Foreground="#707070" FontSize="12" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding TotalSpace}" Foreground="#A0A0A0" FontSize="12" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding UsedPercent, StringFormat='{}•  {0:F0}% занято'}" Foreground="#A0A0A0" FontSize="11" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Monochrome Progress Bar -->
                                        <ProgressBar Value="{Binding UsedPercent}" Maximum="100" Style="{StaticResource MonochromeProgressBar}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ============================================== -->
            <!-- 5. POWER SUBSYSTEM CARD (ROW 4 - SIMPLIFIED)   -->
            <!-- ============================================== -->
            <Border Style="{StaticResource SpecCard}">
                <StackPanel>
                    <!-- Card Header -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" Background="#1E1E1E" CornerRadius="6" Margin="0,0,12,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M 11,2 L 3,13 h 7 l -2,9 l 10,-12 h -7 l 3,-8 z"
                                  Fill="#FFFFFF" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="ПОДСИСТЕМА ПИТАНИЯ" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="Электропитание и рекомендации БП" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" Margin="0,2,0,0"/>
                        </StackPanel>
                        <!-- Form Factor Badge -->
                        <Border Grid.Column="2" Style="{StaticResource ChannelBadge}">
                            <TextBlock Text="{Binding Config.SystemType}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" TextWrapping="Wrap"/>
                        </Border>
                    </Grid>

                    <!-- Only: 1) System Type, 2) Power Source, 3) Recommended PSU Capacity -->
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Box 1: Тип устройства (Стационарный ПК / Ноутбук) -->
                        <Border Grid.Column="0" Style="{StaticResource DetailItemBox}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="ТИП УСТРОЙСТВА" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Config.SystemType}" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Box 2: Питание от электричества (Источник питания) -->
                        <Border Grid.Column="1" Style="{StaticResource DetailItemBox}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="ИСТОЧНИК ПИТАНИЯ" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding PowerSource}" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Box 3: Рекомендуемый объем / мощность БП -->
                        <Border Grid.Column="2" Style="{StaticResource DetailItemBox}" Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock Text="РЕКОМЕНДУЕМЫЙ ОБЪЕМ БП" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Config.RecommendedPsu}" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============================================== -->
            <!-- 6. RAM MODULES BREAKDOWN TABLE (ROW 5)         -->
            <!-- ============================================== -->
            <Border Style="{StaticResource SpecCard}" Margin="0,0,0,0">
                <StackPanel>
                    <TextBlock Text="УСТАНОВЛЕННЫЕ ПЛАНКИ ОПЕРАТИВНОЙ ПАМЯТИ" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,12"/>

                    <!-- Table Header -->
                    <Border Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="СЛОТ" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="ОБЪЕМ" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Grid.Column="2" Text="ЧАСТОТА" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Grid.Column="3" Text="ТИП" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Grid.Column="4" Text="ПРОИЗВОДИТЕЛЬ" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Grid.Column="5" Text="АРТИКУЛ / КАНАЛ" Foreground="{StaticResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <!-- Modules ItemsControl -->
                    <ItemsControl ItemsSource="{Binding Config.RamModules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#141414" BorderBrush="#222222" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Slot}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Slot}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Capacity}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Speed}" Foreground="#E0E0E0" FontSize="12"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Type}" Foreground="#A0A0A0" FontSize="12"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Manufacturer}" Foreground="#D0D0D0" FontSize="12"/>
                                        <StackPanel Grid.Column="5" Orientation="Horizontal">
                                            <TextBlock Text="{Binding PartNumber}" Foreground="#A0A0A0" FontSize="11" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                            <Border Background="#222222" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ChannelBank}" Foreground="#D0D0D0" FontSize="10"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
