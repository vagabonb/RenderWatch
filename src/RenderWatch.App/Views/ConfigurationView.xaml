<UserControl x:Class="RenderWatch.App.Views.ConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:RenderWatch.App.Controls"
             xmlns:vm="clr-namespace:RenderWatch.App.ViewModels"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="SpecCard" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="0,15,0,4"/>
            <Setter Property="Margin" Value="0,0,0,23"/>
        </Style>
        <Style x:Key="DetailItemBox" TargetType="Border">
            <Setter Property="Padding" Value="0,4,12,4"/>
            <Setter Property="Margin" Value="0,0,10,6"/>
        </Style>
        <Style x:Key="ChannelBadge" TargetType="Border">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Sleek Pure Monochrome ProgressBar -->

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="37,17,37,25">
        <StackPanel MaxWidth="1140">

            <!-- ============================================== -->
            <!-- 1. HEADER & ACTION BUTTONS                     -->
            <!-- ============================================== -->
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Subtitle -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Конфигурация" Style="{DynamicResource PageTitle}"/>
                </StackPanel>

                <!-- Right: Copy & Refresh Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Copy Confirmation Toast Badge -->
                    <Border Padding="10,5" Margin="0,0,12,0"
                            Visibility="{Binding IsCopyFeedbackVisible, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding CopyFeedbackMessage}" Foreground="{DynamicResource WhiteInk}" FontSize="11" FontWeight="SemiBold"/>
                    </Border>

                    <!-- Copy Button -->
                    <Button Command="{Binding CopySpecsCommand}" Style="{StaticResource MinimalButton}" Margin="0,0,8,0" Padding="12,7" ToolTip="Скопировать всю конфигурацию в текстовом виде">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Скопировать" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <!-- Refresh Button -->
                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource MinimalButton}" Padding="12,7" ToolTip="Заново опросить WMI и системные шины">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↺" FontSize="13" Margin="0,0,6,0" FontWeight="Bold"/>
                            <TextBlock Text="Обновить" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============================================== -->
            <!-- 2. CPU & RAM SPEC CARDS (ROW 1)                -->
            <!-- ============================================== -->
            <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CARD 1: ПРОЦЕССОР (CPU) -->
                <Border Grid.Column="0" Style="{StaticResource SpecCard}">
                    <StackPanel>
                        <!-- Card Header -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="23" Height="23" Margin="0,0,8,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M 4,4 h 16 v 16 h -16 z M 8,8 h 8 v 8 h -8 z M 7,1 v 3 M 12,1 v 3 M 17,1 v 3 M 7,20 v 3 M 12,20 v 3 M 17,20 v 3 M 1,7 h 3 M 1,12 h 3 M 1,17 h 3 M 20,7 h 3 M 20,12 h 3 M 20,17 h 3"
                                      Stroke="#F5F2EA" StrokeThickness="1.2" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="ПРОЦЕССОР" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Config.CpuName}" Foreground="{DynamicResource WhiteInk}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Details Grid -->
                        <Grid Margin="0,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource DetailItemBox}">
                                <StackPanel>
                                    <TextBlock Text="ЯДРА И ПОТОКИ" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Config.CpuCoresThreads}" Foreground="{DynamicResource WhiteInk}" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource DetailItemBox}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="БАЗОВАЯ ЧАСТОТА" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Config.CpuFrequency}" Foreground="{DynamicResource WhiteInk}" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource DetailItemBox}">
                                <StackPanel>
                                    <TextBlock Text="МАКСИМАЛЬНАЯ ЧАСТОТА" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Config.CpuMaxFrequency}" Foreground="{DynamicResource WhiteInk}" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailItemBox}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="СОКЕТ ПРОЦЕССОРА" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Config.CpuSocket}" Foreground="{DynamicResource WhiteInk}" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource DetailItemBox}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="АРХИТЕКТУРА" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Config.CpuArchitecture}" Foreground="{DynamicResource WhiteInk}" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource DetailItemBox}" Margin="0,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="КЭШ-ПАМЯТЬ L2 / L3" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Config.CpuCache}" Foreground="{DynamicResource WhiteInk}" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CARD 2: ОПЕРАТИВНАЯ ПАМЯТЬ (RAM) -->
                <Border Grid.Column="2" Style="{StaticResource SpecCard}">
                    <StackPanel>
                        <!-- Card Header with Channel Badge -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="23" Height="23" Margin="0,0,8,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M 2,6 h 20 v 11 h -8 v 2 h -2 v -2 h -10 z M 4,8 h 3 v 5 h -3 z M 9,8 h 3 v 5 h -3 z M 14,8 h 3 v 5 h -3 z M 19,8 h 1 v 5 h -1 z M 3,18 h 6 M 13,18 h 7"
                                      Stroke="#F5F2EA" StrokeThickness="1.2" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="ОПЕРАТИВНАЯ ПАМЯТЬ" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Config.RamTotalCapacity, StringFormat='{}{0} Общий объем'}" Foreground="{DynamicResource WhiteInk}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <!-- Prominent Channel Mode Badge -->
                            <Border Grid.Column="2" Style="{StaticResource ChannelBadge}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡" FontSize="11" Foreground="{DynamicResource WhiteInk}" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding Config.RamChannelBadge}" Foreground="{DynamicResource WhiteInk}" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Details Grid -->
                        <Grid Margin="0,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource DetailItemBox}">
                                <StackPanel>
                                    <TextBlock Text="РЕЖИМ КАНАЛОВ" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Config.RamChannelMode}" Foreground="{DynamicResource WhiteInk}" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource DetailItemBox}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="ТИП И ПОКОЛЕНИЕ" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Config.RamType}" Foreground="{DynamicResource WhiteInk}" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource DetailItemBox}">
                                <StackPanel>
                                    <TextBlock Text="ЧАСТОТА ПАМЯТИ" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Config.RamSpeed}" Foreground="{DynamicResource WhiteInk}" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailItemBox}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="ИСПОЛЬЗУЕМЫЕ СЛОТЫ" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Config.RamSlotsUsed}" Foreground="{DynamicResource WhiteInk}" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource DetailItemBox}" Margin="0,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="КОНФИГУРАЦИЯ МОДУЛЕЙ" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Config.RamModules.Count, StringFormat='{}Установлено физических модулей: {0}'}" Foreground="{DynamicResource WhiteInk}" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============================================== -->
            <!-- 3. MOTHERBOARD & GPU CARDS (ROW 2)             -->
            <!-- ============================================== -->
            <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CARD 3: МАТЕРИНСКАЯ ПЛАТА -->
                <Border Grid.Column="0" Style="{StaticResource SpecCard}">
                    <StackPanel>
                        <!-- Card Header -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="23" Height="23" Margin="0,0,8,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M 3,3 h 18 v 18 h -18 z M 6,6 h 4 v 4 h -4 z M 14,6 h 4 v 2 h -4 z M 14,10 h 4 v 2 h -4 z M 6,14 h 6 v 4 h -6 z M 15,15 h 3 v 3 h -3 z"
                                      Stroke="#F5F2EA" StrokeThickness="1.2" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="МАТЕРИНСКАЯ ПЛАТА" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Config.MotherboardProduct}" Foreground="{DynamicResource WhiteInk}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Details Grid -->
                        <Grid Margin="0,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource DetailItemBox}">
                                <StackPanel>
                                    <TextBlock Text="ПРОИЗВОДИТЕЛЬ" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Config.MotherboardManufacturer}" Foreground="{DynamicResource WhiteInk}" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource DetailItemBox}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="РЕВИЗИЯ ПЛАТЫ" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Config.MotherboardVersion, StringFormat='{}Ревизия: {0}'}" Foreground="{DynamicResource WhiteInk}" FontSize="13" FontWeight="Bold" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource DetailItemBox}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="ВЕРСИЯ BIOS / UEFI" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Config.BiosVersion}" Foreground="{DynamicResource WhiteInk}" FontSize="13" FontWeight="Bold" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailItemBox}" Margin="0,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="ДАТА ВЫПУСКА BIOS" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Config.BiosDate}" Foreground="{DynamicResource WhiteInk}" FontSize="13" FontWeight="Bold" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CARD 4: ВИДЕОКАРТА (GPU) -->
                <Border Grid.Column="2" Style="{StaticResource SpecCard}">
                    <StackPanel>
                        <!-- Card Header -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="23" Height="23" Margin="0,0,8,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M 2,5 h 20 v 14 h -20 z M 2,2 v 18 M 8,9 a 3,3 0 1 0 0.1,0 M 16,9 a 3,3 0 1 0 0.1,0 M 8,12 h 0.01 M 16,12 h 0.01 M 5,19 v 3 h 7 v -3"
                                      Stroke="#F5F2EA" StrokeThickness="1.2" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="ВИДЕОКАРТА" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Config.PrimaryGpuName}" Foreground="{DynamicResource WhiteInk}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Details Grid -->
                        <Grid Margin="0,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource DetailItemBox}">
                                <StackPanel>
                                    <TextBlock Text="ВИДЕОПАМЯТЬ (VRAM)" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Config.PrimaryGpuVram}" Foreground="{DynamicResource WhiteInk}" FontSize="13" FontWeight="Bold" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource DetailItemBox}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="ВЕРСИЯ ДРАЙВЕРА" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Config.PrimaryGpuDriver}" Foreground="{DynamicResource WhiteInk}" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource DetailItemBox}" Margin="0,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="ВТОРИЧНЫЙ АДАПТЕР / ВСТРОЕННАЯ ГРАФИКА" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Config.SecondaryGpuName, TargetNullValue='Отсутствует / Отключена'}" Foreground="{DynamicResource WhiteInk}" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============================================== -->
            <!-- 4. STORAGE / DISKS CARD (ROW 3 - ENHANCED)     -->
            <!-- ============================================== -->
            <Border Style="{StaticResource SpecCard}">
                <StackPanel>
                    <!-- Card Header -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="23" Height="23" Margin="0,0,8,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M 3,4 h 18 v 6 h -18 z M 3,14 h 18 v 6 h -18 z M 17,7 h 2 M 17,17 h 2 M 14,7 h 1 M 14,17 h 1"
                                  Stroke="#F5F2EA" StrokeThickness="1.2" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="НАКОПИТЕЛИ И ДИСКИ" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Config.TotalStorageCapacity}" Foreground="{DynamicResource WhiteInk}" FontSize="14" FontWeight="Bold" Margin="0,2,0,0"/>
                        </StackPanel>
                        <!-- Physical Disks Count Badge -->
                        <Border Grid.Column="2" Style="{StaticResource ChannelBadge}">
                            <TextBlock Text="{Binding Config.PhysicalDisksSummary, TargetNullValue='Накопители'}" Foreground="{DynamicResource SoftInk}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <TextBlock Text="ФИЗИЧЕСКИЕ НАКОПИТЕЛИ" Style="{DynamicResource SectionLabel}" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="PhysicalDiskList" ItemsSource="{Binding Config.PhysicalDisks}" Margin="0,0,0,14">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayIndex}" Foreground="{StaticResource SoftInk}" FontSize="11"/>
                                        <TextBlock Text="{Binding InterfaceType}" Foreground="{StaticResource SoftInk}" FontSize="11" Margin="12,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Capacity}" Foreground="{StaticResource WhiteInk}" FontSize="12" Margin="12,0,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Model}" Foreground="{StaticResource WhiteInk}"
                                               FontSize="14" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Данные о моделях накопителей недоступны" Foreground="{StaticResource SoftInk}" FontSize="12" Margin="0,0,0,16"
                               Visibility="{Binding HasItems, ElementName=PhysicalDiskList, Converter={StaticResource InverseBoolToVis}}"/>

                    <TextBlock Text="РАЗДЕЛЫ И СВОБОДНОЕ МЕСТО" Style="{DynamicResource SectionLabel}" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="LogicalDiskList" ItemsSource="{Binding Config.Disks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5,0,19">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource WhiteInk}" FontSize="14"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding FreeSpace}" Foreground="{StaticResource WhiteInk}" FontSize="12"/>
                                        <TextBlock Text=" из " Foreground="{StaticResource SoftInk}" FontSize="12"/>
                                        <TextBlock Text="{Binding TotalSpace}" Foreground="{StaticResource SoftInk}" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="{Binding FileSystem}" Foreground="{StaticResource SoftInk}" FontSize="11" Margin="0,0,12,0"/>
                                        <TextBlock Text="{Binding DiskType}" Foreground="{StaticResource SoftInk}" FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UsedPercent, StringFormat={}{0:F0}% занято}"
                                               Foreground="{StaticResource SoftInk}" FontSize="11" HorizontalAlignment="Right" Margin="12,5,0,0"/>
                                    <ctrl:MiniBarGauge Grid.Row="2" Grid.ColumnSpan="2" Value="{Binding UsedPercent}" MaxValue="100" Height="4"
                                                       ToolTip="{Binding UsedSpace}" Margin="0,9,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Нет доступных локальных разделов" Foreground="{StaticResource SoftInk}" FontSize="12"
                               Visibility="{Binding HasItems, ElementName=LogicalDiskList, Converter={StaticResource InverseBoolToVis}}"/>
                </StackPanel>
            </Border>

            <!-- ============================================== -->
            <!-- 5. POWER SUBSYSTEM CARD (ROW 4 - SIMPLIFIED)   -->
            <!-- ============================================== -->
            <Border Style="{StaticResource SpecCard}">
                <StackPanel>
                    <!-- Card Header -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="23" Height="23" Margin="0,0,8,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M 11,2 L 3,13 h 7 l -2,9 l 10,-12 h -7 l 3,-8 z"
                                  Fill="#F5F2EA" Width="32" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="ПОДСИСТЕМА ПИТАНИЯ" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="Электропитание и рекомендации БП" Foreground="{DynamicResource WhiteInk}" FontSize="14" FontWeight="Bold" Margin="0,2,0,0"/>
                        </StackPanel>
                        <!-- Form Factor Badge -->
                        <Border Grid.Column="2" Style="{StaticResource ChannelBadge}">
                            <TextBlock Text="{Binding Config.SystemType}" Foreground="{DynamicResource WhiteInk}" FontSize="11" FontWeight="Bold" TextWrapping="Wrap"/>
                        </Border>
                    </Grid>

                    <!-- Only: 1) System Type, 2) Power Source, 3) Recommended PSU Capacity -->
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Box 1: Тип устройства (Стационарный ПК / Ноутбук) -->
                        <Border Grid.Column="0" Style="{StaticResource DetailItemBox}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="ТИП УСТРОЙСТВА" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Config.SystemType}" Foreground="{DynamicResource WhiteInk}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Box 2: Питание от электричества (Источник питания) -->
                        <Border Grid.Column="1" Style="{StaticResource DetailItemBox}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="ИСТОЧНИК ПИТАНИЯ" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding PowerSource}" Foreground="{DynamicResource WhiteInk}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Box 3: Рекомендуемый объем / мощность БП -->
                        <Border Grid.Column="2" Style="{StaticResource DetailItemBox}" Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock Text="РЕКОМЕНДУЕМЫЙ ОБЪЕМ БП" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Config.RecommendedPsu}" Foreground="{DynamicResource WhiteInk}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============================================== -->
            <!-- 6. RAM MODULES BREAKDOWN TABLE (ROW 5)         -->
            <!-- ============================================== -->
            <Border Style="{StaticResource SpecCard}" Margin="0,0,0,0">
                <StackPanel>
                    <TextBlock Text="УСТАНОВЛЕННЫЕ ПЛАНКИ ОПЕРАТИВНОЙ ПАМЯТИ" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,12"/>

                    <!-- Table Header -->
                    <Border Padding="12,8" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="СЛОТ" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="ОБЪЕМ" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Grid.Column="2" Text="ЧАСТОТА" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Grid.Column="3" Text="ТИП" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Grid.Column="4" Text="ПРОИЗВОДИТЕЛЬ" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Grid.Column="5" Text="АРТИКУЛ / КАНАЛ" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <!-- Modules ItemsControl -->
                    <ItemsControl ItemsSource="{Binding Config.RamModules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Slot}" Foreground="{DynamicResource WhiteInk}" FontWeight="SemiBold" FontSize="12" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Slot}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Capacity}" Foreground="{DynamicResource WhiteInk}" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Speed}" Foreground="#E0E0E0" FontSize="12"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Type}" Foreground="{DynamicResource SoftInk}" FontSize="12"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Manufacturer}" Foreground="#D8D5CF" FontSize="12"/>
                                        <StackPanel Grid.Column="5" Orientation="Horizontal">
                                            <TextBlock Text="{Binding PartNumber}" Foreground="{DynamicResource SoftInk}" FontSize="11" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                            <Border Padding="5,1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ChannelBank}" Foreground="#D8D5CF" FontSize="10"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
