<UserControl x:Class="RenderWatch.App.Views.DisplayConstructorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:RenderWatch.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border>
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsBlackStyle, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BlackCardFill}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BlackCardEdge}"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="CornerRadius" Value="8"/>
                            <Setter Property="Margin" Value="24,18,24,24"/>
                            <Setter Property="Padding" Value="22"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        <StackPanel>
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Margin" Value="37,17,37,25"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsBlackStyle, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Margin" Value="0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="Конструктор" Style="{DynamicResource PageTitle}" Margin="0,0,0,18"/>
            <Border Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="ПОРЯДОК ПОКАЗАТЕЛЕЙ" Style="{DynamicResource SectionLabel}" Margin="0,0,0,8"/>
                    <WrapPanel ctrl:MetricOrder.Value="{Binding MetricOrder}">
                        <StackPanel Tag="CPU" Orientation="Horizontal" Margin="0,0,10,6">
                            <TextBlock Text="CPU" Foreground="{DynamicResource WhiteInk}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Button Content="‹" Command="{Binding MoveMetricLeftCommand}" CommandParameter="CPU" Padding="6,2" ToolTip="Переместить влево"/>
                            <Button Content="›" Command="{Binding MoveMetricRightCommand}" CommandParameter="CPU" Padding="6,2" Margin="3,0,0,0" ToolTip="Переместить вправо"/>
                        </StackPanel>
                        <StackPanel Tag="GPU" Orientation="Horizontal" Margin="0,0,10,6">
                            <TextBlock Text="GPU" Foreground="{DynamicResource WhiteInk}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Button Content="‹" Command="{Binding MoveMetricLeftCommand}" CommandParameter="GPU" Padding="6,2" ToolTip="Переместить влево"/>
                            <Button Content="›" Command="{Binding MoveMetricRightCommand}" CommandParameter="GPU" Padding="6,2" Margin="3,0,0,0" ToolTip="Переместить вправо"/>
                        </StackPanel>
                        <StackPanel Tag="RAM" Orientation="Horizontal" Margin="0,0,10,6">
                            <TextBlock Text="RAM" Foreground="{DynamicResource WhiteInk}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Button Content="‹" Command="{Binding MoveMetricLeftCommand}" CommandParameter="RAM" Padding="6,2" ToolTip="Переместить влево"/>
                            <Button Content="›" Command="{Binding MoveMetricRightCommand}" CommandParameter="RAM" Padding="6,2" Margin="3,0,0,0" ToolTip="Переместить вправо"/>
                        </StackPanel>
                        <StackPanel Tag="VRAM" Orientation="Horizontal" Margin="0,0,10,6">
                            <TextBlock Text="VRAM" Foreground="{DynamicResource WhiteInk}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Button Content="‹" Command="{Binding MoveMetricLeftCommand}" CommandParameter="VRAM" Padding="6,2" ToolTip="Переместить влево"/>
                            <Button Content="›" Command="{Binding MoveMetricRightCommand}" CommandParameter="VRAM" Padding="6,2" Margin="3,0,0,0" ToolTip="Переместить вправо"/>
                        </StackPanel>
                        <StackPanel Tag="DISK" Orientation="Horizontal" Margin="0,0,10,6">
                            <TextBlock Text="Диски" Foreground="{DynamicResource WhiteInk}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Button Content="‹" Command="{Binding MoveMetricLeftCommand}" CommandParameter="DISK" Padding="6,2" ToolTip="Переместить влево"/>
                            <Button Content="›" Command="{Binding MoveMetricRightCommand}" CommandParameter="DISK" Padding="6,2" Margin="3,0,0,0" ToolTip="Переместить вправо"/>
                        </StackPanel>
                        <StackPanel Tag="NET" Orientation="Horizontal" Margin="0,0,10,6">
                            <TextBlock Text="Сеть" Foreground="{DynamicResource WhiteInk}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Button Content="‹" Command="{Binding MoveMetricLeftCommand}" CommandParameter="NET" Padding="6,2" ToolTip="Переместить влево"/>
                            <Button Content="›" Command="{Binding MoveMetricRightCommand}" CommandParameter="NET" Padding="6,2" Margin="3,0,0,0" ToolTip="Переместить вправо"/>
                        </StackPanel>
                        <StackPanel Tag="UPTIME" Orientation="Horizontal" Margin="0,0,10,6">
                            <TextBlock Text="Время работы" Foreground="{DynamicResource WhiteInk}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Button Content="‹" Command="{Binding MoveMetricLeftCommand}" CommandParameter="UPTIME" Padding="6,2" ToolTip="Переместить влево"/>
                            <Button Content="›" Command="{Binding MoveMetricRightCommand}" CommandParameter="UPTIME" Padding="6,2" Margin="3,0,0,0" ToolTip="Переместить вправо"/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Grid Margin="0,3,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="27"/>
                    <RowDefinition Height="27"/>
                    <RowDefinition Height="27"/>
                    <RowDefinition Height="27"/>
                    <RowDefinition Height="27"/>
                    <RowDefinition Height="27"/>
                    <RowDefinition Height="27"/>
                    <RowDefinition Height="27"/>
                    <RowDefinition Height="27"/>
                </Grid.RowDefinitions>
                <Border Grid.ColumnSpan="4" Background="{DynamicResource Hairline}" Height="1" VerticalAlignment="Bottom"/>
                <TextBlock Grid.Column="1" Text="Панель задач" Style="{DynamicResource SectionLabel}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="Микро" Style="{DynamicResource SectionLabel}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="Компактный" Style="{DynamicResource SectionLabel}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock Grid.Row="1" Text="Загрузка CPU" Foreground="{DynamicResource SoftInk}" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding ShowTaskbarCpu}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          AutomationProperties.Name="Панель задач · Загрузка CPU"/>
                <CheckBox Grid.Row="1" Grid.Column="2" IsChecked="{Binding ShowMicroCpu}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          AutomationProperties.Name="Микро · Загрузка CPU"/>
                <CheckBox Grid.Row="1" Grid.Column="3" IsChecked="{Binding ShowCompactCpu}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          AutomationProperties.Name="Компактный · Загрузка CPU"/>
                <TextBlock Grid.Row="2" Text="Температура CPU" Foreground="{DynamicResource SoftInk}" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding ShowTaskbarCpuTemp}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          AutomationProperties.Name="Панель задач · Температура CPU"/>
                <CheckBox Grid.Row="2" Grid.Column="2" IsChecked="{Binding ShowMicroCpuTemp}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          AutomationProperties.Name="Микро · Температура CPU"/>
                <CheckBox Grid.Row="2" Grid.Column="3" IsChecked="{Binding ShowCompactCpuTemp}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          AutomationProperties.Name="Компактный · Температура CPU"/>
                <TextBlock Grid.Row="3" Text="Загрузка GPU" Foreground="{DynamicResource SoftInk}" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding ShowTaskbarGpu}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          AutomationProperties.Name="Панель задач · Загрузка GPU"/>
                <CheckBox Grid.Row="3" Grid.Column="2" IsChecked="{Binding ShowMicroGpu}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          AutomationProperties.Name="Микро · Загрузка GPU"/>
                <CheckBox Grid.Row="3" Grid.Column="3" IsChecked="{Binding ShowCompactGpu}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          AutomationProperties.Name="Компактный · Загрузка GPU"/>
                <TextBlock Grid.Row="4" Text="Температура GPU" Foreground="{DynamicResource SoftInk}" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding ShowTaskbarGpuTemp}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          AutomationProperties.Name="Панель задач · Температура GPU"/>
                <CheckBox Grid.Row="4" Grid.Column="2" IsChecked="{Binding ShowMicroGpuTemp}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          AutomationProperties.Name="Микро · Температура GPU"/>
                <CheckBox Grid.Row="4" Grid.Column="3" IsChecked="{Binding ShowCompactGpuTemp}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          AutomationProperties.Name="Компактный · Температура GPU"/>
                <TextBlock Grid.Row="5" Text="Оперативная память" Foreground="{DynamicResource SoftInk}" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="5" Grid.Column="1" IsChecked="{Binding ShowTaskbarRam}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          AutomationProperties.Name="Панель задач · Оперативная память"/>
                <CheckBox Grid.Row="5" Grid.Column="2" IsChecked="{Binding ShowMicroRam}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          AutomationProperties.Name="Микро · Оперативная память"/>
                <CheckBox Grid.Row="5" Grid.Column="3" IsChecked="{Binding ShowCompactRam}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          AutomationProperties.Name="Компактный · Оперативная память"/>
                <TextBlock Grid.Row="6" Text="Видеопамять" Foreground="{DynamicResource SoftInk}" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding ShowTaskbarVram}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          AutomationProperties.Name="Панель задач · Видеопамять"/>
                <CheckBox Grid.Row="6" Grid.Column="2" IsChecked="{Binding ShowMicroVram}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          AutomationProperties.Name="Микро · Видеопамять"/>
                <CheckBox Grid.Row="6" Grid.Column="3" IsChecked="{Binding ShowCompactVram}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          AutomationProperties.Name="Компактный · Видеопамять"/>
                <TextBlock Grid.Row="7" Text="Диски" Foreground="{DynamicResource SoftInk}" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="7" Grid.Column="1" IsChecked="{Binding ShowTaskbarDisk}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          AutomationProperties.Name="Панель задач · Диски"/>
                <CheckBox Grid.Row="7" Grid.Column="2" IsChecked="{Binding ShowMicroDisk}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          AutomationProperties.Name="Микро · Диски"/>
                <CheckBox Grid.Row="7" Grid.Column="3" IsChecked="{Binding ShowCompactDisk}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          AutomationProperties.Name="Компактный · Диски"/>
                <TextBlock Grid.Row="8" Text="Сеть" Foreground="{DynamicResource SoftInk}" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="8" Grid.Column="1" IsChecked="{Binding ShowTaskbarNetwork}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          AutomationProperties.Name="Панель задач · Сеть"/>
                <CheckBox Grid.Row="8" Grid.Column="2" IsChecked="{Binding ShowMicroNetwork}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          AutomationProperties.Name="Микро · Сеть"/>
                <CheckBox Grid.Row="8" Grid.Column="3" IsChecked="{Binding ShowCompactNetwork}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          AutomationProperties.Name="Компактный · Сеть"/>
                <TextBlock Grid.Row="9" Text="Время работы" Foreground="{DynamicResource SoftInk}" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="9" Grid.Column="1" IsChecked="{Binding ShowTaskbarUptime}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          AutomationProperties.Name="Панель задач · Время работы"/>
                <CheckBox Grid.Row="9" Grid.Column="2" IsChecked="{Binding ShowMicroUptime}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          AutomationProperties.Name="Микро · Время работы"/>
                <CheckBox Grid.Row="9" Grid.Column="3" IsChecked="{Binding ShowCompactUptime}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          AutomationProperties.Name="Компактный · Время работы"/>
            </Grid>
            <TextBlock Text="ПРЕДПРОСМОТР" Style="{DynamicResource SectionLabel}" Margin="0,0,0,8"/>
            <UniformGrid Columns="3">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Панель задач" FontSize="11" Foreground="{DynamicResource SoftInk}" Margin="0,0,0,5"/>
                    <Border Background="#16000000" Padding="8">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal" ctrl:MetricOrder.Value="{Binding MetricOrder}">
                            <StackPanel Tag="CPU" Orientation="Horizontal" Margin="0,0,8,3">
                                <StackPanel.Visibility>
                                    <MultiBinding Converter="{StaticResource AnyVisible}">
                                        <Binding Path="ShowTaskbarCpu"/><Binding Path="ShowTaskbarCpuTemp"/>
                                    </MultiBinding>
                                </StackPanel.Visibility>
                                <Path Data="M 4,4 H 20 V 20 H 4 Z M 8,8 H 16 V 16 H 8 Z M 8,1 V 4 M 16,1 V 4 M 8,20 V 23 M 16,20 V 23 M 1,8 H 4 M 1,16 H 4 M 20,8 H 23 M 20,16 H 23" Stroke="#B8B8B8" StrokeThickness="1.15" Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,4,0" AutomationProperties.Name="CPU"/>
                                <TextBlock Text="{Binding DataContext.Dashboard.CpuTempMicro, RelativeSource={RelativeSource AncestorType=Window}}" Visibility="{Binding ShowTaskbarCpuTemp, Converter={StaticResource BoolToVis}}" Foreground="{DynamicResource WhiteInk}" FontSize="11" Margin="0,0,3,0"/>
                                <TextBlock Text="{Binding DataContext.Dashboard.CpuUsageMicro, RelativeSource={RelativeSource AncestorType=Window}}" Visibility="{Binding ShowTaskbarCpu, Converter={StaticResource BoolToVis}}" Foreground="{DynamicResource WhiteInk}" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Tag="GPU" Orientation="Horizontal" Margin="0,0,8,3">
                                <StackPanel.Visibility>
                                    <MultiBinding Converter="{StaticResource AnyVisible}">
                                        <Binding Path="ShowTaskbarGpu"/><Binding Path="ShowTaskbarGpuTemp"/>
                                    </MultiBinding>
                                </StackPanel.Visibility>
                                <Path Data="M 2,5 H 22 V 19 H 2 Z M 2,2 V 21 M 8,9 A 3,3 0 1 0 8.1,9 M 16,9 A 3,3 0 1 0 16.1,9 M 5,19 V 22 H 12 V 19" Stroke="#B8B8B8" StrokeThickness="1.15" Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,4,0" AutomationProperties.Name="GPU"/>
                                <TextBlock Text="{Binding DataContext.Dashboard.GpuTempMicro, RelativeSource={RelativeSource AncestorType=Window}}" Visibility="{Binding ShowTaskbarGpuTemp, Converter={StaticResource BoolToVis}}" Foreground="{DynamicResource WhiteInk}" FontSize="11" Margin="0,0,3,0"/>
                                <TextBlock Text="{Binding DataContext.Dashboard.GpuUsageMicro, RelativeSource={RelativeSource AncestorType=Window}}" Visibility="{Binding ShowTaskbarGpu, Converter={StaticResource BoolToVis}}" Foreground="{DynamicResource WhiteInk}" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Tag="RAM" Orientation="Horizontal" Margin="0,0,8,3">
                                <StackPanel.Visibility><Binding Path="ShowTaskbarRam" Converter="{StaticResource BoolToVis}"/></StackPanel.Visibility>
                                <Path Data="M 2,6 H 22 V 17 H 14 V 19 H 12 V 17 H 2 Z M 5,9 V 13 M 9,9 V 13 M 13,9 V 13 M 17,9 V 13" Stroke="#B8B8B8" StrokeThickness="1.15" Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,4,0" AutomationProperties.Name="RAM"/>
                                <TextBlock Text="{Binding DataContext.Dashboard.RamPercentDisplay, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource WhiteInk}" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Tag="VRAM" Orientation="Horizontal" Margin="0,0,8,3">
                                <StackPanel.Visibility><Binding Path="ShowTaskbarVram" Converter="{StaticResource BoolToVis}"/></StackPanel.Visibility>
                                <Path Data="M 2,4 H 22 V 20 H 2 Z M 7,8 L 12,16 L 17,8 M 7,1 V 4 M 17,1 V 4 M 7,20 V 23 M 17,20 V 23" Stroke="#B8B8B8" StrokeThickness="1.15" Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,4,0" AutomationProperties.Name="VRAM"/>
                                <TextBlock Text="{Binding DataContext.Dashboard.VramPercentValue, StringFormat={}{0:F0}%, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource WhiteInk}" FontSize="11" FontWeight="Bold"/>
                            </StackPanel><StackPanel Tag="DISK" Visibility="{Binding ShowTaskbarDisk, Converter={StaticResource BoolToVis}}" Orientation="Horizontal" Margin="0,0,8,3">
 <Path Data="M 4,3 H 20 V 21 H 4 Z M 4,15 H 20 M 7,18 H 9" Stroke="#B8B8B8" StrokeThickness="1.15" Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,4,0" AutomationProperties.Name="Диски"/><TextBlock Text="{Binding DataContext.Dashboard.DiskCompact, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="White" FontSize="11" FontWeight="Bold"/>
</StackPanel><StackPanel Tag="NET" Visibility="{Binding ShowTaskbarNetwork, Converter={StaticResource BoolToVis}}" Orientation="Horizontal" Margin="0,0,8,3">
 <Path Data="M 12,2 A 10,10 0 1 0 12.1,2 M 2,12 H 22 M 12,2 C 6,7 6,17 12,22 M 12,2 C 18,7 18,17 12,22" Stroke="#B8B8B8" StrokeThickness="1.15" Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,4,0" AutomationProperties.Name="NET"/><TextBlock Text="{Binding DataContext.Dashboard.NetworkCompact, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="White" FontSize="10" FontWeight="Normal"/>
</StackPanel><StackPanel Tag="UPTIME" Visibility="{Binding ShowTaskbarUptime, Converter={StaticResource BoolToVis}}" Orientation="Horizontal" Margin="0,0,8,3">
 <Path Data="M 12,2 A 10,10 0 1 0 12.1,2 M 12,6 V 12 L 16,14" Stroke="#B8B8B8" StrokeThickness="1.15" Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,4,0" AutomationProperties.Name="Время работы"/><TextBlock Text="{Binding DataContext.Dashboard.Uptime, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="White" FontSize="11" FontWeight="Bold"/>
</StackPanel>
                        </StackPanel></ScrollViewer>
                    </Border>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Микро" FontSize="11" Foreground="{DynamicResource SoftInk}" Margin="0,0,0,5"/>
                    <Border Background="#16000000" Padding="8">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal" ctrl:MetricOrder.Value="{Binding MetricOrder}">
                            <StackPanel Tag="CPU" Orientation="Horizontal" Margin="0,0,8,3">
                                <StackPanel.Visibility>
                                    <MultiBinding Converter="{StaticResource AnyVisible}">
                                        <Binding Path="ShowMicroCpu"/><Binding Path="ShowMicroCpuTemp"/>
                                    </MultiBinding>
                                </StackPanel.Visibility>
                                <TextBlock Text="CPU " Foreground="{DynamicResource SoftInk}" FontSize="10"/>
                                <TextBlock Text="{Binding DataContext.Dashboard.CpuTempMicro, RelativeSource={RelativeSource AncestorType=Window}}" Visibility="{Binding ShowMicroCpuTemp, Converter={StaticResource BoolToVis}}" Foreground="{DynamicResource WhiteInk}" FontSize="11" Margin="0,0,3,0"/>
                                <TextBlock Text="{Binding DataContext.Dashboard.CpuUsageMicro, RelativeSource={RelativeSource AncestorType=Window}}" Visibility="{Binding ShowMicroCpu, Converter={StaticResource BoolToVis}}" Foreground="{DynamicResource WhiteInk}" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Tag="GPU" Orientation="Horizontal" Margin="0,0,8,3">
                                <StackPanel.Visibility>
                                    <MultiBinding Converter="{StaticResource AnyVisible}">
                                        <Binding Path="ShowMicroGpu"/><Binding Path="ShowMicroGpuTemp"/>
                                    </MultiBinding>
                                </StackPanel.Visibility>
                                <TextBlock Text="GPU " Foreground="{DynamicResource SoftInk}" FontSize="10"/>
                                <TextBlock Text="{Binding DataContext.Dashboard.GpuTempMicro, RelativeSource={RelativeSource AncestorType=Window}}" Visibility="{Binding ShowMicroGpuTemp, Converter={StaticResource BoolToVis}}" Foreground="{DynamicResource WhiteInk}" FontSize="11" Margin="0,0,3,0"/>
                                <TextBlock Text="{Binding DataContext.Dashboard.GpuUsageMicro, RelativeSource={RelativeSource AncestorType=Window}}" Visibility="{Binding ShowMicroGpu, Converter={StaticResource BoolToVis}}" Foreground="{DynamicResource WhiteInk}" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Tag="RAM" Orientation="Horizontal" Margin="0,0,8,3">
                                <StackPanel.Visibility><Binding Path="ShowMicroRam" Converter="{StaticResource BoolToVis}"/></StackPanel.Visibility>
                                <TextBlock Text="RAM " Foreground="{DynamicResource SoftInk}" FontSize="10"/>
                                <TextBlock Text="{Binding DataContext.Dashboard.RamPercentDisplay, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource WhiteInk}" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Tag="VRAM" Orientation="Horizontal" Margin="0,0,8,3">
                                <StackPanel.Visibility><Binding Path="ShowMicroVram" Converter="{StaticResource BoolToVis}"/></StackPanel.Visibility>
                                <TextBlock Text="VRAM " Foreground="{DynamicResource SoftInk}" FontSize="10"/>
                                <TextBlock Text="{Binding DataContext.Dashboard.VramPercentValue, StringFormat={}{0:F0}%, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource WhiteInk}" FontSize="11" FontWeight="Bold"/>
                            </StackPanel><StackPanel Tag="DISK" Visibility="{Binding ShowMicroDisk, Converter={StaticResource BoolToVis}}" Orientation="Horizontal" Margin="0,0,8,3">
 <TextBlock Text="Диски " Foreground="{DynamicResource SoftInk}" FontSize="10"/><TextBlock Text="{Binding DataContext.Dashboard.DiskCompact, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="White" FontSize="11" FontWeight="Bold"/>
</StackPanel><StackPanel Tag="NET" Visibility="{Binding ShowMicroNetwork, Converter={StaticResource BoolToVis}}" Orientation="Horizontal" Margin="0,0,8,3">
 <TextBlock Text="Сеть " Foreground="{DynamicResource SoftInk}" FontSize="10"/><TextBlock Text="{Binding DataContext.Dashboard.NetworkCompact, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="White" FontSize="11" FontWeight="Bold"/>
</StackPanel><StackPanel Tag="UPTIME" Visibility="{Binding ShowMicroUptime, Converter={StaticResource BoolToVis}}" Orientation="Horizontal" Margin="0,0,8,3">
 <TextBlock Text="Время работы " Foreground="{DynamicResource SoftInk}" FontSize="10"/><TextBlock Text="{Binding DataContext.Dashboard.Uptime, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="White" FontSize="11" FontWeight="Bold"/>
</StackPanel>
                        </StackPanel></ScrollViewer>
                    </Border>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Компактный" FontSize="11" Foreground="{DynamicResource SoftInk}" Margin="0,0,0,5"/>
                    <Border Background="#16000000" Padding="8">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" ctrl:MetricOrder.Value="{Binding MetricOrder}">
                                <Border Tag="CPU" Padding="8,6" Margin="0,0,5,0" Width="100">
                                    <Border.Visibility>
                                        <MultiBinding Converter="{StaticResource AnyVisible}">
                                            <Binding Path="ShowCompactCpu"/><Binding Path="ShowCompactCpuTemp"/>
                                        </MultiBinding>
                                    </Border.Visibility>
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="CPU" Foreground="{DynamicResource SoftInk}" FontSize="10"/>
                                            <TextBlock Text="{Binding DataContext.Dashboard.CpuTempMicro, RelativeSource={RelativeSource AncestorType=Window}}" Visibility="{Binding ShowCompactCpuTemp, Converter={StaticResource BoolToVis}}" Foreground="White" HorizontalAlignment="Right" FontSize="10"/>
                                        </Grid>
                                        <TextBlock Text="{Binding DataContext.Dashboard.CpuUsageMicro, RelativeSource={RelativeSource AncestorType=Window}}" Visibility="{Binding ShowCompactCpu, Converter={StaticResource BoolToVis}}" Foreground="White" FontSize="18" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                                <Border Tag="GPU" Padding="8,6" Margin="0,0,5,0" Width="100">
                                    <Border.Visibility>
                                        <MultiBinding Converter="{StaticResource AnyVisible}">
                                            <Binding Path="ShowCompactGpu"/><Binding Path="ShowCompactGpuTemp"/>
                                        </MultiBinding>
                                    </Border.Visibility>
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="GPU" Foreground="{DynamicResource SoftInk}" FontSize="10"/>
                                            <TextBlock Text="{Binding DataContext.Dashboard.GpuTempMicro, RelativeSource={RelativeSource AncestorType=Window}}" Visibility="{Binding ShowCompactGpuTemp, Converter={StaticResource BoolToVis}}" Foreground="White" HorizontalAlignment="Right" FontSize="10"/>
                                        </Grid>
                                        <TextBlock Text="{Binding DataContext.Dashboard.GpuUsageMicro, RelativeSource={RelativeSource AncestorType=Window}}" Visibility="{Binding ShowCompactGpu, Converter={StaticResource BoolToVis}}" Foreground="White" FontSize="18" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                                <Border Tag="RAM" Padding="8,6" Margin="0,0,5,0" Width="100">
                                    <Border.Visibility><Binding Path="ShowCompactRam" Converter="{StaticResource BoolToVis}"/></Border.Visibility>
                                    <StackPanel>
                                        <TextBlock Text="RAM" Foreground="{DynamicResource SoftInk}" FontSize="10"/>
                                        <TextBlock Text="{Binding DataContext.Dashboard.RamPercentDisplay, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="White" FontSize="18" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                                <Border Tag="VRAM" Padding="8,6" Margin="0,0,5,0" Width="100">
                                    <Border.Visibility><Binding Path="ShowCompactVram" Converter="{StaticResource BoolToVis}"/></Border.Visibility>
                                    <StackPanel>
                                        <TextBlock Text="VRAM" Foreground="{DynamicResource SoftInk}" FontSize="10"/>
                                        <TextBlock Text="{Binding DataContext.Dashboard.VramPercentValue, StringFormat={}{0:F0}%, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="White" FontSize="18" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border><Border Tag="DISK" Visibility="{Binding ShowCompactDisk, Converter={StaticResource BoolToVis}}" Padding="8,6" Margin="0,0,5,0" MinWidth="100">
 <StackPanel><TextBlock Text="Диски" Foreground="{DynamicResource SoftInk}" FontSize="10"/><TextBlock Text="{Binding DataContext.Dashboard.DiskCompact, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="White" FontSize="11" FontWeight="Bold"/></StackPanel>
</Border><Border Tag="NET" Visibility="{Binding ShowCompactNetwork, Converter={StaticResource BoolToVis}}" Padding="8,6" Margin="0,0,5,0" MinWidth="100">
 <StackPanel><TextBlock Text="Сеть" Foreground="{DynamicResource SoftInk}" FontSize="10"/><TextBlock Text="{Binding DataContext.Dashboard.NetworkCompact, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="White" FontSize="11" FontWeight="Bold"/></StackPanel>
</Border><Border Tag="UPTIME" Visibility="{Binding ShowCompactUptime, Converter={StaticResource BoolToVis}}" Padding="8,6" Margin="0,0,5,0" MinWidth="100">
 <StackPanel><TextBlock Text="Время работы" Foreground="{DynamicResource SoftInk}" FontSize="10"/><TextBlock Text="{Binding DataContext.Dashboard.Uptime, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="White" FontSize="11" FontWeight="Bold"/></StackPanel>
</Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </UniformGrid>
        </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
