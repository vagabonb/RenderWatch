<UserControl x:Class="RenderWatch.App.Views.DisplayConstructorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:RenderWatch.App.Controls"
             xmlns:conv="clr-namespace:RenderWatch.App.Converters"
             xmlns:views="clr-namespace:RenderWatch.App.Views">
    <UserControl.Resources>
        <conv:TaskbarInkConverter x:Key="TaskbarInk"/>
        <Style x:Key="EditorButton" TargetType="Button" BasedOn="{StaticResource MinimalButton}">
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
        <Style x:Key="MetricCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,0,14,9"/>
            <Setter Property="BorderBrush" Value="#8AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="EditorScroll" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Padding" Value="0,2,8,6"/>
        </Style>
        <Style x:Key="EditorTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Surface" Padding="12,7" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#10FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#16FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource WhiteInk}"/>
                                <Setter TargetName="Surface" Property="Background" Value="#16FFFFFF"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource WhiteInk}"/>
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    <Condition Binding="{Binding DataContext.IsColorStyle, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{x:Static ctrl:TelemetryPalette.Cyan}"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditorList" TargetType="ListBox">
            <Setter Property="Background" Value="#14000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource WhiteInk}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style x:Key="EditorListItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource WhiteInk}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#10FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#20FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Конструктор" Style="{DynamicResource PageTitle}" Margin="0,0,0,12"/>
        <TabControl Grid.Row="1" ItemContainerStyle="{StaticResource EditorTab}" SelectedIndex="{Binding SelectedPage, Mode=TwoWay}">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Margin="0,0,0,16" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True"/>
                        </Border>
                        <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <TabItem Header="На панель">
                <ScrollViewer Style="{StaticResource EditorScroll}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Тёмная панель" Style="{StaticResource EditorButton}" Command="{Binding DataContext.SetTaskbarStripThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="dark"/>
                                <Button Content="Светлая панель" Style="{StaticResource EditorButton}" Command="{Binding DataContext.SetTaskbarStripThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="light"/>
                            </StackPanel>
                            <TextBlock Text="Предпросмотр" Style="{DynamicResource SectionLabel}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Border CornerRadius="5" Padding="8" Margin="0,0,0,18">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#111111"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsTaskbarStripLightMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Background" Value="#E5E5E5"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DataContext.IsGraphiteStyle, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <views:TaskbarStripContent DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" Height="30"/>
                            </ScrollViewer>
                        </Border>
                        <TextBlock Text="Отступы" Style="{DynamicResource SectionLabel}" Margin="0,0,0,8"/>
                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <StackPanel Margin="0,0,13,10">
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Taskbar.BlockGap, StringFormat={}{0} px}" Foreground="{DynamicResource WhiteInk}"/>
                                    <TextBlock Text="Между блоками" Foreground="{DynamicResource SoftInk}"/>
                                </DockPanel>
                                <Slider Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding Taskbar.BlockGap, Mode=TwoWay}" AutomationProperties.Name="Между блоками"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,13,10">
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Taskbar.LabelGap, StringFormat={}{0} px}" Foreground="{DynamicResource WhiteInk}"/>
                                    <TextBlock Text="Между значком и значением" Foreground="{DynamicResource SoftInk}"/>
                                </DockPanel>
                                <Slider Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding Taskbar.LabelGap, Mode=TwoWay}" AutomationProperties.Name="Между значком и значением"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,13,10">
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Taskbar.ValueGap, StringFormat={}{0} px}" Foreground="{DynamicResource WhiteInk}"/>
                                    <TextBlock Text="Между температурой и нагрузкой" Foreground="{DynamicResource SoftInk}"/>
                                </DockPanel>
                                <Slider Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding Taskbar.ValueGap, Mode=TwoWay}" AutomationProperties.Name="Между температурой и нагрузкой"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,13,10">
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Taskbar.SidePadding, StringFormat={}{0} px}" Foreground="{DynamicResource WhiteInk}"/>
                                    <TextBlock Text="По краям" Foreground="{DynamicResource SoftInk}"/>
                                </DockPanel>
                                <Slider Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding Taskbar.SidePadding, Mode=TwoWay}" AutomationProperties.Name="По краям"/>
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="Показатели" Style="{DynamicResource SectionLabel}" Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,0,0,14">
                        <CheckBox Content="CPU" IsChecked="{Binding ShowTaskbarCpu}" Style="{StaticResource MetricCheck}"/>
                        <CheckBox Content="CPU °C" IsChecked="{Binding ShowTaskbarCpuTemp}" Style="{StaticResource MetricCheck}"/>
                        <CheckBox Content="GPU" IsChecked="{Binding ShowTaskbarGpu}" Style="{StaticResource MetricCheck}"/>
                        <CheckBox Content="GPU °C" IsChecked="{Binding ShowTaskbarGpuTemp}" Style="{StaticResource MetricCheck}"/>
                        <CheckBox Content="RAM" IsChecked="{Binding ShowTaskbarRam}" Style="{StaticResource MetricCheck}"/>
                        <CheckBox Content="VRAM" IsChecked="{Binding ShowTaskbarVram}" Style="{StaticResource MetricCheck}"/>
                        <CheckBox Content="Диски" IsChecked="{Binding ShowTaskbarDisk}" Style="{StaticResource MetricCheck}"/>
                        <CheckBox Content="Сеть" IsChecked="{Binding ShowTaskbarNetwork}" Style="{StaticResource MetricCheck}"/>
                        <CheckBox Content="Время работы" IsChecked="{Binding ShowTaskbarUptime}" Style="{StaticResource MetricCheck}"/>
                        </WrapPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Порядок блоков" Style="{DynamicResource SectionLabel}" Margin="0,0,0,8"/>
                                <ListBox ItemsSource="{Binding Taskbar.Options}" SelectedItem="{Binding Taskbar.SelectedMetric, Mode=TwoWay}"
                                         DisplayMemberPath="Name" Style="{StaticResource EditorList}" ItemContainerStyle="{StaticResource EditorListItem}"
                                         AutomationProperties.Name="Блок панели"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="←" Style="{StaticResource EditorButton}" Command="{Binding Taskbar.MoveLeftCommand}" ToolTip="Сдвинуть влево"/>
                                <Button Content="→" Style="{StaticResource EditorButton}" Command="{Binding Taskbar.MoveRightCommand}" ToolTip="Сдвинуть вправо"/>
                            </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" DataContext="{Binding Taskbar.SelectedMetric}" Margin="0,0,0,8"
                                        Width="440" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource WhiteInk}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,9"/>
                                <CheckBox Content="Английская подпись вместо значка" IsChecked="{Binding UseText}" Style="{StaticResource MetricCheck}"/>
                                <DockPanel Margin="0,0,0,7">
                                    <Button DockPanel.Dock="Right" Tag="LabelColor" Click="OnPickColor" Style="{StaticResource EditorButton}"
                                            ToolTip="Выбрать цвет" AutomationProperties.Name="Цвет · Значок или подпись">
                                        <Border Width="18" Height="14" CornerRadius="2" BorderBrush="#66FFFFFF" BorderThickness="1">
                                            <Border.Background>
                                                <MultiBinding Converter="{StaticResource TaskbarInk}" ConverterParameter="Label">
                                                    <Binding Path="LabelBrush"/>
                                                    <Binding Path="DataContext.IsTaskbarStripLightMode" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                </MultiBinding>
                                            </Border.Background>
                                        </Border>
                                    </Button>
                                    <TextBox DockPanel.Dock="Right" Width="85" MaxLength="7" Margin="5,0,7,0"
                                             Text="{Binding LabelColor, Mode=TwoWay, ValidatesOnExceptions=True}" AutomationProperties.Name="Значок или подпись · HEX"/>
                                    <TextBlock Text="Значок или подпись" Foreground="{DynamicResource SoftInk}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,7">
                                    <Button DockPanel.Dock="Right" Tag="ValueColor" Click="OnPickColor" Style="{StaticResource EditorButton}"
                                            ToolTip="Выбрать цвет" AutomationProperties.Name="Цвет · Значение">
                                        <Border Width="18" Height="14" CornerRadius="2" BorderBrush="#66FFFFFF" BorderThickness="1">
                                            <Border.Background>
                                                <MultiBinding Converter="{StaticResource TaskbarInk}">
                                                    <Binding Path="ValueBrush"/>
                                                    <Binding Path="DataContext.IsTaskbarStripLightMode" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                </MultiBinding>
                                            </Border.Background>
                                        </Border>
                                    </Button>
                                    <TextBox DockPanel.Dock="Right" Width="85" MaxLength="7" Margin="5,0,7,0"
                                             Text="{Binding ValueColor, Mode=TwoWay, ValidatesOnExceptions=True}" AutomationProperties.Name="Значение · HEX"/>
                                    <TextBlock Text="Значение" Foreground="{DynamicResource SoftInk}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,7" Visibility="{Binding HasTemperature, Converter={StaticResource BoolToVis}}">
                                    <Button DockPanel.Dock="Right" Tag="TemperatureColor" Click="OnPickColor" Style="{StaticResource EditorButton}"
                                            ToolTip="Выбрать цвет" AutomationProperties.Name="Цвет · Температура">
                                        <Border Width="18" Height="14" CornerRadius="2" BorderBrush="#66FFFFFF" BorderThickness="1">
                                            <Border.Background>
                                                <MultiBinding Converter="{StaticResource TaskbarInk}">
                                                    <Binding Path="TemperatureBrush"/>
                                                    <Binding Path="DataContext.IsTaskbarStripLightMode" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                </MultiBinding>
                                            </Border.Background>
                                        </Border>
                                    </Button>
                                    <TextBox DockPanel.Dock="Right" Width="85" MaxLength="7" Margin="5,0,7,0"
                                             Text="{Binding TemperatureColor, Mode=TwoWay, ValidatesOnExceptions=True}" AutomationProperties.Name="Температура · HEX"/>
                                    <TextBlock Text="Температура" Foreground="{DynamicResource SoftInk}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DockPanel Margin="0,2,0,0">
                                    <Button DockPanel.Dock="Right" Content="Сбросить цвета" Style="{StaticResource EditorButton}" Command="{Binding ResetColorsCommand}"/>
                                    <TextBlock Text="HEX · пустое поле использует цвет по умолчанию" Foreground="{DynamicResource SoftInk}"
                                               FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Микро">
                <ScrollViewer Style="{StaticResource EditorScroll}">
                    <StackPanel>
                        <TextBlock Text="Предпросмотр" Style="{DynamicResource SectionLabel}" Margin="0,0,0,8"/>
                        <Border Padding="10,8" Background="#28000000" CornerRadius="4" Margin="0,0,0,18">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" ctrl:MetricOrder.Value="{Binding MetricOrder}">
                                <StackPanel Tag="CPU" Orientation="Horizontal" Margin="0,0,9,0">
                                    <StackPanel.Visibility>
                                        <MultiBinding Converter="{StaticResource AnyVisible}">
                                            <Binding Path="ShowMicroCpu"/><Binding Path="ShowMicroCpuTemp"/>
                                        </MultiBinding>
                                    </StackPanel.Visibility>
                                    <TextBlock Text="CPU" Foreground="{DynamicResource SoftInk}" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding DataContext.Dashboard.CpuTempMicro, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource WhiteInk}" Margin="0,0,4,0"
                                               Visibility="{Binding ShowMicroCpuTemp, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding DataContext.Dashboard.CpuUsageMicro, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource WhiteInk}" Visibility="{Binding ShowMicroCpu, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <StackPanel Tag="GPU" Orientation="Horizontal" Margin="0,0,9,0">
                                    <StackPanel.Visibility>
                                        <MultiBinding Converter="{StaticResource AnyVisible}">
                                            <Binding Path="ShowMicroGpu"/><Binding Path="ShowMicroGpuTemp"/>
                                        </MultiBinding>
                                    </StackPanel.Visibility>
                                    <TextBlock Text="GPU" Foreground="{DynamicResource SoftInk}" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding DataContext.Dashboard.GpuTempMicro, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource WhiteInk}" Margin="0,0,4,0"
                                               Visibility="{Binding ShowMicroGpuTemp, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding DataContext.Dashboard.GpuUsageMicro, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource WhiteInk}" Visibility="{Binding ShowMicroGpu, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <StackPanel Tag="RAM" Orientation="Horizontal" Margin="0,0,9,0" Visibility="{Binding ShowMicroRam, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="RAM" Foreground="{DynamicResource SoftInk}" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding DataContext.Dashboard.RamPercentDisplay, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource WhiteInk}"/>
                                </StackPanel>
                                <StackPanel Tag="VRAM" Orientation="Horizontal" Margin="0,0,9,0" Visibility="{Binding ShowMicroVram, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="VRAM" Foreground="{DynamicResource SoftInk}" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding DataContext.Dashboard.VramPercentValue, StringFormat={}{0:F0}%, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource WhiteInk}"/>
                                </StackPanel>
                                <StackPanel Tag="DISK" Orientation="Horizontal" Margin="0,0,9,0" Visibility="{Binding ShowMicroDisk, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Диски" Foreground="{DynamicResource SoftInk}" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding DataContext.Dashboard.DiskCompact, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource WhiteInk}"/>
                                </StackPanel>
                                <StackPanel Tag="NET" Orientation="Horizontal" Margin="0,0,9,0" Visibility="{Binding ShowMicroNetwork, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Сеть" Foreground="{DynamicResource SoftInk}" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding DataContext.Dashboard.NetworkCompact, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource WhiteInk}"/>
                                </StackPanel>
                                <StackPanel Tag="UPTIME" Orientation="Horizontal" Margin="0,0,9,0" Visibility="{Binding ShowMicroUptime, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Время работы" Foreground="{DynamicResource SoftInk}" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding DataContext.Dashboard.Uptime, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource WhiteInk}"/>
                                </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <TextBlock Text="Показатели" Style="{DynamicResource SectionLabel}" Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,0,0,16">
                        <CheckBox Content="CPU" IsChecked="{Binding ShowMicroCpu}" Style="{StaticResource MetricCheck}"/>
                        <CheckBox Content="CPU °C" IsChecked="{Binding ShowMicroCpuTemp}" Style="{StaticResource MetricCheck}"/>
                        <CheckBox Content="GPU" IsChecked="{Binding ShowMicroGpu}" Style="{StaticResource MetricCheck}"/>
                        <CheckBox Content="GPU °C" IsChecked="{Binding ShowMicroGpuTemp}" Style="{StaticResource MetricCheck}"/>
                        <CheckBox Content="RAM" IsChecked="{Binding ShowMicroRam}" Style="{StaticResource MetricCheck}"/>
                        <CheckBox Content="VRAM" IsChecked="{Binding ShowMicroVram}" Style="{StaticResource MetricCheck}"/>
                        <CheckBox Content="Диски" IsChecked="{Binding ShowMicroDisk}" Style="{StaticResource MetricCheck}"/>
                        <CheckBox Content="Сеть" IsChecked="{Binding ShowMicroNetwork}" Style="{StaticResource MetricCheck}"/>
                        <CheckBox Content="Время работы" IsChecked="{Binding ShowMicroUptime}" Style="{StaticResource MetricCheck}"/>
                        </WrapPanel>
                        <TextBlock Text="Порядок блоков" Style="{DynamicResource SectionLabel}" Margin="0,0,0,8"/>
                        <WrapPanel ctrl:MetricOrder.Value="{Binding MetricOrder}">
                            <StackPanel Tag="CPU" Orientation="Horizontal" Margin="0,0,12,6">
                                <TextBlock Text="CPU" Foreground="{DynamicResource WhiteInk}" VerticalAlignment="Center" Margin="0,5,6,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="←" Style="{StaticResource EditorButton}" Command="{Binding MoveMetricLeftCommand}" CommandParameter="CPU" ToolTip="Сдвинуть влево"/>
                                <Button Content="→" Style="{StaticResource EditorButton}" Command="{Binding MoveMetricRightCommand}" CommandParameter="CPU" ToolTip="Сдвинуть вправо"/>
                            </StackPanel>
                            </StackPanel>
                            <StackPanel Tag="GPU" Orientation="Horizontal" Margin="0,0,12,6">
                                <TextBlock Text="GPU" Foreground="{DynamicResource WhiteInk}" VerticalAlignment="Center" Margin="0,5,6,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="←" Style="{StaticResource EditorButton}" Command="{Binding MoveMetricLeftCommand}" CommandParameter="GPU" ToolTip="Сдвинуть влево"/>
                                <Button Content="→" Style="{StaticResource EditorButton}" Command="{Binding MoveMetricRightCommand}" CommandParameter="GPU" ToolTip="Сдвинуть вправо"/>
                            </StackPanel>
                            </StackPanel>
                            <StackPanel Tag="RAM" Orientation="Horizontal" Margin="0,0,12,6">
                                <TextBlock Text="RAM" Foreground="{DynamicResource WhiteInk}" VerticalAlignment="Center" Margin="0,5,6,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="←" Style="{StaticResource EditorButton}" Command="{Binding MoveMetricLeftCommand}" CommandParameter="RAM" ToolTip="Сдвинуть влево"/>
                                <Button Content="→" Style="{StaticResource EditorButton}" Command="{Binding MoveMetricRightCommand}" CommandParameter="RAM" ToolTip="Сдвинуть вправо"/>
                            </StackPanel>
                            </StackPanel>
                            <StackPanel Tag="VRAM" Orientation="Horizontal" Margin="0,0,12,6">
                                <TextBlock Text="VRAM" Foreground="{DynamicResource WhiteInk}" VerticalAlignment="Center" Margin="0,5,6,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="←" Style="{StaticResource EditorButton}" Command="{Binding MoveMetricLeftCommand}" CommandParameter="VRAM" ToolTip="Сдвинуть влево"/>
                                <Button Content="→" Style="{StaticResource EditorButton}" Command="{Binding MoveMetricRightCommand}" CommandParameter="VRAM" ToolTip="Сдвинуть вправо"/>
                            </StackPanel>
                            </StackPanel>
                            <StackPanel Tag="DISK" Orientation="Horizontal" Margin="0,0,12,6">
                                <TextBlock Text="Диски" Foreground="{DynamicResource WhiteInk}" VerticalAlignment="Center" Margin="0,5,6,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="←" Style="{StaticResource EditorButton}" Command="{Binding MoveMetricLeftCommand}" CommandParameter="DISK" ToolTip="Сдвинуть влево"/>
                                <Button Content="→" Style="{StaticResource EditorButton}" Command="{Binding MoveMetricRightCommand}" CommandParameter="DISK" ToolTip="Сдвинуть вправо"/>
                            </StackPanel>
                            </StackPanel>
                            <StackPanel Tag="NET" Orientation="Horizontal" Margin="0,0,12,6">
                                <TextBlock Text="Сеть" Foreground="{DynamicResource WhiteInk}" VerticalAlignment="Center" Margin="0,5,6,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="←" Style="{StaticResource EditorButton}" Command="{Binding MoveMetricLeftCommand}" CommandParameter="NET" ToolTip="Сдвинуть влево"/>
                                <Button Content="→" Style="{StaticResource EditorButton}" Command="{Binding MoveMetricRightCommand}" CommandParameter="NET" ToolTip="Сдвинуть вправо"/>
                            </StackPanel>
                            </StackPanel>
                            <StackPanel Tag="UPTIME" Orientation="Horizontal" Margin="0,0,12,6">
                                <TextBlock Text="Время работы" Foreground="{DynamicResource WhiteInk}" VerticalAlignment="Center" Margin="0,5,6,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="←" Style="{StaticResource EditorButton}" Command="{Binding MoveMetricLeftCommand}" CommandParameter="UPTIME" ToolTip="Сдвинуть влево"/>
                                <Button Content="→" Style="{StaticResource EditorButton}" Command="{Binding MoveMetricRightCommand}" CommandParameter="UPTIME" ToolTip="Сдвинуть вправо"/>
                            </StackPanel>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Компактный">
                <ScrollViewer Style="{StaticResource EditorScroll}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="Предпросмотр" Style="{DynamicResource SectionLabel}" Margin="0,0,0,8"/>
                            <Border Padding="6" Background="#28000000" CornerRadius="5">
                                <views:CompactChartStrip Height="422" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <DockPanel Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="↑" Style="{StaticResource EditorButton}" Command="{Binding MoveCompactUpCommand}" ToolTip="Поднять выбранный график"/>
                                    <Button Content="↓" Style="{StaticResource EditorButton}" Command="{Binding MoveCompactDownCommand}" ToolTip="Опустить выбранный график"/>
                                </StackPanel>
                                <TextBlock Text="Состав и порядок графиков" Style="{DynamicResource SectionLabel}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </DockPanel>
                            <ListBox ItemsSource="{Binding CompactOptions}" SelectedItem="{Binding SelectedCompactGraph, Mode=TwoWay}"
                                     Style="{StaticResource EditorList}" ItemContainerStyle="{StaticResource EditorListItem}"
                                     AutomationProperties.Name="Графики компактного режима">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" IsChecked="{Binding IsEnabled}" Style="{StaticResource MetricCheck}"
                                                      Margin="0" AutomationProperties.Name="{Binding Title}" ToolTip="Показать график"/>
                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource WhiteInk}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
