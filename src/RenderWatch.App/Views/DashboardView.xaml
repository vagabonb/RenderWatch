<UserControl x:Class="RenderWatch.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:RenderWatch.App.Controls">

    <UserControl.Resources>
        <!-- White Miniature Hardware Icons -->
        <Geometry x:Key="IconCpu">M 4,4 h 16 v 16 h -16 z M 8,8 h 8 v 8 h -8 z M 7,1 v 3 M 12,1 v 3 M 17,1 v 3 M 7,20 v 3 M 12,20 v 3 M 17,20 v 3 M 1,7 h 3 M 1,12 h 3 M 1,17 h 3 M 20,7 h 3 M 20,12 h 3 M 20,17 h 3</Geometry>
        <Geometry x:Key="IconGpu">M 2,5 h 20 v 14 h -20 z M 2,2 v 18 M 8,9 a 3,3 0 1 0 0.1,0 M 16,9 a 3,3 0 1 0 0.1,0 M 8,12 h 0.01 M 16,12 h 0.01 M 5,19 v 3 h 7 v -3</Geometry>
        <Geometry x:Key="IconRam">M 2,6 h 20 v 11 h -8 v 2 h -2 v -2 h -10 z M 4,8 h 3 v 5 h -3 z M 9,8 h 3 v 5 h -3 z M 14,8 h 3 v 5 h -3 z M 19,8 h 1 v 5 h -1 z M 3,18 h 6 M 13,18 h 7</Geometry>
        <Geometry x:Key="IconVram">M 2,4 h 20 v 16 h -20 z M 7,8 L 12,16 L 17,8 M 5,1 h 3 v 3 h -3 z M 11,1 h 3 v 3 h -3 z M 17,1 h 3 v 3 h -3 z M 5,20 h 3 v 3 h -3 z M 11,20 h 3 v 3 h -3 z M 17,20 h 3 v 3 h -3 z</Geometry>
        <Geometry x:Key="IconFan">M 12,12 m -10,0 a 10,10 0 1 0 20,0 a 10,10 0 1 0 -20,0 M 12,9.5 C 12,6 14,4 17,4 C 15.5,6.5 14.5,8 14.5,9.5 M 14.5,12 C 18,12 20,14 20,17 C 17.5,15.5 16,14.5 14.5,14.5 M 12,14.5 C 12,18 10,20 7,20 C 8.5,17.5 9.5,16 9.5,14.5 M 9.5,12 C 6,12 4,10 4,7 C 6.5,8.5 8,9.5 9.5,9.5 M 12,12 m -2.5,0 a 2.5,2.5 0 1 0 5,0 a 2.5,2.5 0 1 0 -5,0</Geometry>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,18,24,24">

            <!-- 1. Top Control Bar (Polling Interval Switcher & Session Controls) -->
            <Border Background="{StaticResource BrushSurfaceCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="16,10" Margin="0,0,0,16">
                <Grid>
                    <!-- Left: Polling Interval Switcher (1s, 3s, 5s) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Интервал опроса:" Foreground="{StaticResource BrushTextMuted}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>

                        <!-- 0.1s Button -->
                        <Button Content="0.1 сек"
                                Command="{Binding DataContext.SetIntervalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="0.1">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MinimalButton}">
                                    <Setter Property="Padding" Value="12,5"/>
                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsIntervalTenthSec, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                            <Setter Property="Foreground" Value="#0A0A0A"/>
                                            <Setter Property="BorderBrush" Value="#FFFFFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- 0.5s Button -->
                        <Button Content="0.5 сек"
                                Command="{Binding DataContext.SetIntervalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="0.5">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MinimalButton}">
                                    <Setter Property="Padding" Value="12,5"/>
                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsIntervalHalfSec, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                            <Setter Property="Foreground" Value="#0A0A0A"/>
                                            <Setter Property="BorderBrush" Value="#FFFFFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- 1s Button -->
                        <Button Content="1 сек"
                                Command="{Binding DataContext.SetIntervalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="1">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MinimalButton}">
                                    <Setter Property="Padding" Value="14,5"/>
                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsInterval1Sec, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                            <Setter Property="Foreground" Value="#0A0A0A"/>
                                            <Setter Property="BorderBrush" Value="#FFFFFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- 3s Button -->
                        <Button Content="3 сек"
                                Command="{Binding DataContext.SetIntervalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="3">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MinimalButton}">
                                    <Setter Property="Padding" Value="14,5"/>
                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsInterval3Sec, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                            <Setter Property="Foreground" Value="#0A0A0A"/>
                                            <Setter Property="BorderBrush" Value="#FFFFFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- 5s Button -->
                        <Button Content="5 сек"
                                Command="{Binding DataContext.SetIntervalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="5">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MinimalButton}">
                                    <Setter Property="Padding" Value="14,5"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsInterval5Sec, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                            <Setter Property="Foreground" Value="#0A0A0A"/>
                                            <Setter Property="BorderBrush" Value="#FFFFFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- 3. Equipment Cards Grid (CPU, GPU, RAM, VRAM) with White Miniature Icons & Larger Digits -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CPU Card -->
                <Border Grid.Column="0" Background="{StaticResource BrushSurfaceCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,8,0">
                    <StackPanel>
                        <!-- Header with White Miniature Icon -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" Background="#181818" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0">
                                <Path Data="{StaticResource IconCpu}" Stroke="#FFFFFF" StrokeThickness="1.5" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="ПРОЦЕССОР" Foreground="#707070" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource FontDisplay}"/>
                                <TextBlock Text="CPU" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>

                        <!-- Usage -->
                        <TextBlock Text="{Binding CpuUsageDisplay}" Foreground="#FFFFFF" FontSize="36" FontWeight="Bold" FontFamily="{StaticResource FontDisplay}" Margin="0,0,0,6"/>
                        <ctrl:MiniBarGauge Value="{Binding CpuPercentValue}" MaxValue="100" Height="6" HorizontalAlignment="Stretch" Margin="0,0,0,16"/>

                        <!-- Temperature -->
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Температура" Foreground="#A0A0A0" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CpuTempDisplay}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="17" FontFamily="{StaticResource FontDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Clock Frequency -->
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Частота" Foreground="#A0A0A0" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CpuClockDisplay}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="17" FontFamily="{StaticResource FontDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Power Watts -->
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="Мощность" Foreground="#A0A0A0" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CpuPowerDisplay}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="17" FontFamily="{StaticResource FontDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- GPU Card -->
                <Border Grid.Column="1" Background="{StaticResource BrushSurfaceCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="4,0,4,0">
                    <StackPanel>
                        <!-- Header with White Miniature Icon -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" Background="#181818" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0">
                                <Path Data="{StaticResource IconGpu}" Stroke="#FFFFFF" StrokeThickness="1.5" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding GpuName}" TextTrimming="CharacterEllipsis" Foreground="#707070" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource FontDisplay}"/>
                                <TextBlock Text="GPU" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>

                        <!-- Usage -->
                        <TextBlock Text="{Binding GpuUsageDisplay}" Foreground="#FFFFFF" FontSize="36" FontWeight="Bold" FontFamily="{StaticResource FontDisplay}" Margin="0,0,0,6"/>
                        <ctrl:MiniBarGauge Value="{Binding GpuPercentValue}" MaxValue="100" Height="6" HorizontalAlignment="Stretch" Margin="0,0,0,16"/>

                        <!-- Temperature -->
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Температура" Foreground="#A0A0A0" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding GpuTempDisplay}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="17" FontFamily="{StaticResource FontDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Clock Frequency -->
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Частота" Foreground="#A0A0A0" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding GpuClockDisplay}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="17" FontFamily="{StaticResource FontDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Power Watts -->
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="Мощность" Foreground="#A0A0A0" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding GpuPowerDisplay}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="17" FontFamily="{StaticResource FontDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- RAM Card -->
                <Border Grid.Column="2" Background="{StaticResource BrushSurfaceCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="4,0,4,0">
                    <StackPanel>
                        <!-- Header with White Miniature Icon -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" Background="#181818" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0">
                                <Path Data="{StaticResource IconRam}" Stroke="#FFFFFF" StrokeThickness="1.5" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="ПАМЯТЬ" Foreground="#707070" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource FontDisplay}"/>
                                <TextBlock Text="RAM" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>

                        <!-- Usage Percent -->
                        <TextBlock Text="{Binding RamPercentValue, StringFormat={}{0:F0}%}" Foreground="#FFFFFF" FontSize="36" FontWeight="Bold" FontFamily="{StaticResource FontDisplay}" Margin="0,0,0,6"/>
                        <ctrl:MiniBarGauge Value="{Binding RamPercentValue}" MaxValue="100" Height="6" HorizontalAlignment="Stretch" Margin="0,0,0,16"/>

                        <!-- Volume -->
                        <TextBlock Text="Занято / Всего:" Foreground="#A0A0A0" FontSize="13" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding RamDisplay}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="17" FontFamily="{StaticResource FontDisplay}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- VRAM Card -->
                <Border Grid.Column="3" Background="{StaticResource BrushSurfaceCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="8,0,0,0">
                    <StackPanel>
                        <!-- Header with White Miniature Icon -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" Background="#181818" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0">
                                <Path Data="{StaticResource IconVram}" Stroke="#FFFFFF" StrokeThickness="1.5" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="ВИДЕОПАМЯТЬ" Foreground="#707070" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource FontDisplay}"/>
                                <TextBlock Text="VRAM" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>

                        <!-- Usage Percent -->
                        <TextBlock Text="{Binding VramPercentValue, StringFormat={}{0:F0}%}" Foreground="#FFFFFF" FontSize="36" FontWeight="Bold" FontFamily="{StaticResource FontDisplay}" Margin="0,0,0,6"/>
                        <ctrl:MiniBarGauge Value="{Binding VramPercentValue}" MaxValue="100" Height="6" HorizontalAlignment="Stretch" Margin="0,0,0,16"/>

                        <!-- Volume -->
                        <TextBlock Text="Занято / Всего:" Foreground="#A0A0A0" FontSize="13" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding VramDisplay}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="17" FontFamily="{StaticResource FontDisplay}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 4. Cooling System Card (Fans, RPM & Roles) - Compact & Laconic -->
            <Border Background="{StaticResource BrushSurfaceCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,16">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon Badge -->
                        <Border Grid.Column="0" Width="30" Height="30" Background="#181818" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0">
                            <Path Data="{StaticResource IconFan}" Stroke="#FFFFFF" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Title -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="СИСТЕМА ОХЛАЖДЕНИЯ" Foreground="#707070" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource FontDisplay}"/>
                            <TextBlock Text="Вентиляторы и активные контуры" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>

                        <!-- Fans Count Badge -->
                        <Border Grid.Column="2" Background="#181818" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="6" Padding="12,5" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Вентиляторы: " Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding FansSummaryText}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Fans Grid Categorized by Hardware (AIO Pump/Rad, GPU, Chassis, PSU, etc.) -->
                    <ItemsControl ItemsSource="{Binding FanGroups}" Visibility="{Binding HasFans, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,6">
                                    <!-- Group Category Header -->
                                    <Border Margin="0,4,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding GroupName}" Foreground="#8A8A8A" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource FontDisplay}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <Rectangle Grid.Column="1" Height="1" Fill="#202020" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding CountText}" Foreground="#555555" FontSize="10" FontWeight="SemiBold" Margin="10,0,12,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Fans in Group -->
                                    <ItemsControl ItemsSource="{Binding Fans}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="376" Background="#141414" BorderBrush="#242424" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,12,10">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Top Row: Role, Name & RPM Display -->
                                                        <Grid Grid.Row="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Border Background="#1E1E1E" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="0,0,8,0">
                                                                    <TextBlock Text="{Binding Role}" Foreground="#AAAAAA" FontSize="10" FontWeight="Bold"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding DisplayName}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>

                                                            <!-- Speed / RPM (Pure white, bold) -->
                                                            <TextBlock Grid.Column="1" Text="{Binding RpmDisplay}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" FontFamily="{StaticResource FontDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                        </Grid>

                                                        <!-- Bottom Row: Speed MiniBarGauge (Subtle and Clean) -->
                                                        <ctrl:MiniBarGauge Grid.Row="1" Value="{Binding PercentValue}" MaxValue="100" Height="3" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Fallback Banner (Visible when HasFans == False) -->
                    <Border Visibility="{Binding HasFans, Converter={StaticResource InverseBoolToVis}}" Background="#141414" BorderBrush="#242424" BorderThickness="1" CornerRadius="6" Padding="14,10">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="26" Height="26" Background="#1A1A1A" CornerRadius="4" Margin="0,0,10,0">
                                <Path Data="{StaticResource IconFan}" Stroke="#707070" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Инициализация контуров охлаждения..." Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="Опрос аппаратных датчиков и профилей охлаждения системы" Foreground="#707070" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 5. Taskbar Strip Theme Switcher Card (Below Fans) -->
            <Border Background="{StaticResource BrushSurfaceCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="20,16" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Description -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="ЦВЕТОВАЯ ТЕМА ПАНЕЛИ ЗАДАЧ" Foreground="#707070" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource FontDisplay}" Margin="0,0,0,3"/>
                        <TextBlock Text="Цвет цифр виджета для тёмной или светлой темы Windows" Foreground="#D0D0D0" FontSize="12"/>
                    </StackPanel>

                    <!-- Right: Minimalist Segmented Switcher -->
                    <Border Grid.Column="1" Background="#1C1C1C" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="6" Padding="3" VerticalAlignment="Center" Margin="16,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <!-- Dark Theme Button -->
                            <Button Content="Тёмная"
                                    Command="{Binding SetTaskbarStripThemeCommand}"
                                    CommandParameter="dark"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#888888"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="14,6"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTaskbarStripDarkMode}" Value="True">
                                                <Setter Property="Background" Value="#2E2E2E"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Light Theme Button -->
                            <Button Content="Светлая"
                                    Command="{Binding SetTaskbarStripThemeCommand}"
                                    CommandParameter="light"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#888888"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="14,6"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTaskbarStripLightMode}" Value="True">
                                                <Setter Property="Background" Value="#E0E0E0"/>
                                                <Setter Property="Foreground" Value="#111111"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 6. Bottom Sensor Details Badge -->
            <Border Background="#121212" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="16,12">
                <Grid>
                    <TextBlock Text="Активные датчики телеметрии:" Foreground="{StaticResource BrushTextMuted}" FontSize="12"/>
                    <TextBlock Text="{Binding SensorSources}" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>