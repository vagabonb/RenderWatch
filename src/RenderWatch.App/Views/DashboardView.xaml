<UserControl x:Class="RenderWatch.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RenderWatch.App.Views"
             xmlns:ctrl="clr-namespace:RenderWatch.App.Controls">
    <UserControl.Resources>
        <Style x:Key="OverviewValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource WhiteInk}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
            <Setter Property="FontSize" Value="40"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>
        <Style x:Key="OverviewDetail" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SoftInk}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>
        <Style x:Key="OverviewTemperature" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource WhiteInk}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="37,0,37,30">
            <Grid Height="{StaticResource GraphiteOverviewHeaderHeight}">
                <DockPanel Margin="0,17,0,40">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SystemPowerReadout" Text="{Binding SystemPowerText}" Foreground="{StaticResource WhiteInk}" FontSize="17"
                                   MinWidth="86" Margin="16,0,28,0" TextAlignment="Right" Typography.NumeralAlignment="Tabular"
                                   ToolTip="{Binding SystemPowerHint}" AutomationProperties.HelpText="{Binding SystemPowerHint}"/>
                        <TextBlock x:Name="UptimeReadout" Text="{Binding Uptime}" Foreground="{StaticResource WhiteInk}" FontSize="17"
                                   Typography.NumeralAlignment="Tabular" ToolTip="Время работы компьютера"/>
                    </StackPanel>
                    <TextBlock Text="Обзор" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
                </DockPanel>
            </Grid>

            <Grid x:Name="HardwareCards" Margin="0,0,0,34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" AutomationProperties.Name="CPU">
                    <TextBlock Text="CPU" Style="{StaticResource SectionLabel}" ToolTip="Процессор"/>
                    <TextBlock Text="{Binding CpuUsageDisplay}" Style="{StaticResource OverviewValue}"/>
                    <Grid Width="112" HorizontalAlignment="Left" Margin="0,7,0,10" Height="32" ClipToBounds="True" IsHitTestVisible="False">
                        <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource Hairline}"/>
                        <ctrl:MetricSparkline Capacity="40" Points="{Binding DataContext.SessionMetrics.CpuLoad, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6" ToolTip="Температура">
                        <Path Data="{StaticResource IconTemperature}"
                              Stroke="{StaticResource WhiteInk}" StrokeThickness="1.2" Width="10" Height="17"
                              Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CpuTempDisplay}" Style="{StaticResource OverviewTemperature}"/>
                    </StackPanel>
                    <WrapPanel>
                        <TextBlock Text="{Binding CpuClockDisplay}" ToolTip="Частота" Margin="0,0,10,2" Style="{StaticResource OverviewDetail}"/>
                        <TextBlock Text="{Binding CpuPowerDisplay}" ToolTip="Мощность" Style="{StaticResource OverviewDetail}"/>
                    </WrapPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" AutomationProperties.Name="GPU">
                    <TextBlock Text="GPU" Style="{StaticResource SectionLabel}" ToolTip="{Binding GpuName}"/>
                    <TextBlock Text="{Binding GpuUsageDisplay}" Style="{StaticResource OverviewValue}"/>
                    <Grid Width="112" HorizontalAlignment="Left" Margin="0,7,0,10" Height="32" ClipToBounds="True" IsHitTestVisible="False">
                        <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource Hairline}"/>
                        <ctrl:MetricSparkline Capacity="40" Points="{Binding DataContext.SessionMetrics.GpuLoad, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6" ToolTip="Температура">
                        <Path Data="{StaticResource IconTemperature}"
                              Stroke="{StaticResource WhiteInk}" StrokeThickness="1.2" Width="10" Height="17"
                              Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding GpuTempDisplay}" Style="{StaticResource OverviewTemperature}"/>
                    </StackPanel>
                    <WrapPanel>
                        <TextBlock Text="{Binding GpuClockDisplay}" ToolTip="Частота" Margin="0,0,10,2" Style="{StaticResource OverviewDetail}"/>
                        <TextBlock Text="{Binding GpuPowerDisplay}" ToolTip="Мощность" Style="{StaticResource OverviewDetail}"/>
                    </WrapPanel>
                </StackPanel>

                <StackPanel Grid.Column="4" AutomationProperties.Name="RAM">
                    <TextBlock Text="RAM" Style="{StaticResource SectionLabel}" ToolTip="Оперативная память"/>
                    <TextBlock Text="{Binding RamPercentValue, StringFormat={}{0:F0}%}" Style="{StaticResource OverviewValue}"/>
                    <Grid Width="112" HorizontalAlignment="Left" Margin="0,7,0,10" Height="32" ClipToBounds="True" IsHitTestVisible="False">
                        <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource Hairline}"/>
                        <ctrl:MetricSparkline Capacity="40" Points="{Binding DataContext.SessionMetrics.Ram, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </Grid>
                    <WrapPanel>
                        <TextBlock Text="{Binding RamCapacityDisplay}" ToolTip="Занято / всего" Style="{StaticResource OverviewDetail}"/>
                    </WrapPanel>
                </StackPanel>

                <StackPanel Grid.Column="6" AutomationProperties.Name="VRAM">
                    <TextBlock Text="VRAM" Style="{StaticResource SectionLabel}" ToolTip="Видеопамять"/>
                    <TextBlock Text="{Binding VramPercentValue, StringFormat={}{0:F0}%}" Style="{StaticResource OverviewValue}"/>
                    <Grid Width="112" HorizontalAlignment="Left" Margin="0,7,0,10" Height="32" ClipToBounds="True" IsHitTestVisible="False">
                        <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource Hairline}"/>
                        <ctrl:MetricSparkline Capacity="40" Points="{Binding DataContext.SessionMetrics.Vram, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </Grid>
                    <WrapPanel>
                        <TextBlock Text="{Binding VramCapacityDisplay}" ToolTip="Занято / всего" Style="{StaticResource OverviewDetail}"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>

            <Border Height="1" Background="{StaticResource Hairline}" Margin="0,0,0,17"/>
            <Grid Margin="0,0,0,27" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="103"/>
                            <ColumnDefinition Width="103"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ДИСКИ" Style="{StaticResource SectionLabel}" Margin="0"/>
                        <TextBlock Grid.Column="1" Text="Чтение" Style="{StaticResource ActivityColumnHeader}" Margin="6,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="Запись" Style="{StaticResource ActivityColumnHeader}" Margin="6,0,0,0"/>
                    </Grid>
                    <ItemsControl x:Name="DiskEntries" ItemsSource="{Binding PhysicalDisks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="103"/>
                                        <ColumnDefinition Width="103"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource WhiteInk}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Read}" Style="{StaticResource ActivityRate}" Margin="6,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Write}" Style="{StaticResource ActivityRate}" Margin="6,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Нет данных" Style="{StaticResource OverviewDetail}">
                        <TextBlock.Visibility>
                            <Binding Path="HasItems" ElementName="DiskEntries" Converter="{StaticResource InverseBoolToVis}"/>
                        </TextBlock.Visibility>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="СЕТЬ" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Получение" Foreground="{StaticResource SoftInk}" FontSize="12" VerticalAlignment="Center"/>
                            <ctrl:MetricSparkline Grid.Column="1" Height="30" MaxValue="{Binding DataContext.SessionMetrics.NetworkReceiveScale, RelativeSource={RelativeSource AncestorType=Window}}" Capacity="40" Margin="4,0,9,0"
                                ToolTip="{Binding DataContext.SessionMetrics.NetworkReceiveScaleDisplay, RelativeSource={RelativeSource AncestorType=Window}}"
                                Points="{Binding DataContext.SessionMetrics.NetworkReceive, RelativeSource={RelativeSource AncestorType=Window}}"
                                AutomationProperties.Name="Сеть · Получение"/>
                            <TextBlock Grid.Column="2" Text="{Binding NetworkReceive}" Style="{StaticResource ActivityRate}"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Отправка" Foreground="{StaticResource SoftInk}" FontSize="12" VerticalAlignment="Center"/>
                            <ctrl:MetricSparkline Grid.Column="1" Height="30" MaxValue="{Binding DataContext.SessionMetrics.NetworkSendScale, RelativeSource={RelativeSource AncestorType=Window}}" Capacity="40" Margin="4,0,9,0"
                                ToolTip="{Binding DataContext.SessionMetrics.NetworkSendScaleDisplay, RelativeSource={RelativeSource AncestorType=Window}}"
                                Points="{Binding DataContext.SessionMetrics.NetworkSend, RelativeSource={RelativeSource AncestorType=Window}}"
                                AutomationProperties.Name="Сеть · Отправка"/>
                            <TextBlock Grid.Column="2" Text="{Binding NetworkSend}" Style="{StaticResource ActivityRate}"/>
                        </Grid>
                </StackPanel>
            </Grid>

            <Border Height="1" Background="{StaticResource Hairline}" Margin="0,0,0,17"/>
            <views:BatteryCard Background="Transparent" IsMonochrome="True" Margin="0,0,0,20"/>
            <DockPanel Margin="0,0,0,12">
                <TextBlock Text="ОХЛАЖДЕНИЕ" Style="{StaticResource SectionLabel}" Margin="0"/>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding FanGroups}" Visibility="{Binding HasFans, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding GroupName}" Style="{StaticResource OverviewDetail}" Margin="0,0,0,3"/>
                            <ItemsControl ItemsSource="{Binding Fans}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="0.56*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource WhiteInk}" TextTrimming="CharacterEllipsis"/>
                                            <ctrl:MiniBarGauge Grid.Column="1" Value="{Binding PercentValue}" MaxValue="100" Height="2" Margin="12,0,0,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding RpmDisplay}" Foreground="{StaticResource WhiteInk}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Нет данных о вентиляторах" Style="{StaticResource OverviewDetail}"
                       Visibility="{Binding HasFans, Converter={StaticResource InverseBoolToVis}}"/>

            <Border Height="1" Background="{StaticResource Hairline}" Margin="0,23,0,10"/>
            <DockPanel Margin="0,3">
                <TextBlock Text="Частота опроса" Style="{StaticResource OverviewDetail}" VerticalAlignment="Center"/>
                <WrapPanel HorizontalAlignment="Right">
                    <Button Content="0,1 с" Command="{Binding DataContext.SetIntervalCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0.1">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource InlineOption}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsIntervalTenthSec, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource WhiteInk}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource WhiteInk}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="0,5 с" Command="{Binding DataContext.SetIntervalCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="0.5">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource InlineOption}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsIntervalHalfSec, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource WhiteInk}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource WhiteInk}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="1 с" Command="{Binding DataContext.SetIntervalCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="1">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource InlineOption}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsInterval1Sec, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource WhiteInk}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource WhiteInk}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="3 с" Command="{Binding DataContext.SetIntervalCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="3">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource InlineOption}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsInterval3Sec, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource WhiteInk}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource WhiteInk}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="5 с" Command="{Binding DataContext.SetIntervalCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="5">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource InlineOption}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsInterval5Sec, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource WhiteInk}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource WhiteInk}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </WrapPanel>
            </DockPanel>
            <DockPanel Margin="0,3" ToolTip="Запуск на панели задач при входе в Windows">
                <TextBlock Text="Автозапуск" Style="{StaticResource OverviewDetail}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Вкл." Command="{Binding SetAutostartCommand}" CommandParameter="true">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource InlineOption}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StartWithWindows}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource WhiteInk}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource WhiteInk}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Выкл." Command="{Binding SetAutostartCommand}" CommandParameter="false">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource InlineOption}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StartWithWindows}" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource WhiteInk}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource WhiteInk}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </DockPanel>
            <DockPanel Margin="0,3" ToolTip="Цвет цифр виджета на панели задач">
                <TextBlock Text="Виджет на панели задач" Style="{StaticResource OverviewDetail}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Тёмный" Command="{Binding SetTaskbarStripThemeCommand}" CommandParameter="dark">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource InlineOption}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTaskbarStripDarkMode}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource WhiteInk}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource WhiteInk}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Светлый" Command="{Binding SetTaskbarStripThemeCommand}" CommandParameter="light">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource InlineOption}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTaskbarStripLightMode}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource WhiteInk}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource WhiteInk}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </DockPanel>
            <TextBlock Text="{Binding SensorSources}" Style="{StaticResource OverviewDetail}" HorizontalAlignment="Right"
                       ToolTip="Источники данных" Margin="0,7,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
