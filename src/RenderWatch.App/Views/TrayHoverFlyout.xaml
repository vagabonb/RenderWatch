<Window x:Class="RenderWatch.App.Views.TrayHoverFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RENDER WATCH Mini"
        Width="310" Height="225"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Border Background="#0D0D0D" BorderBrush="#282828" BorderThickness="1" CornerRadius="10" Padding="14,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.8"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Divider -->
                <RowDefinition Height="*"/>    <!-- 4 miniature metrics -->
                <RowDefinition Height="Auto"/> <!-- Divider -->
                <RowDefinition Height="Auto"/> <!-- "Вернуть" Button -->
            </Grid.RowDefinitions>

            <!-- 1. Header: Logo, Title & Status -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/app.png" Width="13" Height="13" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="RENDER WATCH" Foreground="#A0A0A0" FontWeight="Bold" FontSize="11" FontFamily="{StaticResource FontDisplay}"/>
                </StackPanel>

                <!-- Status pill -->
                <Border Grid.Column="2" Background="#181818" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Dashboard.StatusText}" Foreground="{Binding Dashboard.StatusBrush}" FontWeight="Bold" FontSize="10"/>
                </Border>
            </Grid>

            <!-- Line -->
            <Rectangle Grid.Row="1" Height="1" Fill="#222222" Margin="0,0,0,10"/>

            <!-- 2. Miniature 4 Metrics Grid (CPU, GPU, RAM, VRAM) -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CPU Mini -->
                <Border Grid.Row="0" Grid.Column="0" Background="#141414" CornerRadius="5" Padding="8,6" Margin="0,0,0,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Text="CPU" Foreground="#707070" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Dashboard.CpuUsageDisplay}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right"/>
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding Dashboard.CpuTempDisplay}" Foreground="#A0A0A0" FontSize="10" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Dashboard.CpuPowerDisplay}" Foreground="#A0A0A0" FontSize="10"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- GPU Mini -->
                <Border Grid.Row="0" Grid.Column="2" Background="#141414" CornerRadius="5" Padding="8,6" Margin="0,0,0,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Text="GPU" Foreground="#707070" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Dashboard.GpuUsageDisplay}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right"/>
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding Dashboard.GpuTempDisplay}" Foreground="#A0A0A0" FontSize="10" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Dashboard.GpuPowerDisplay}" Foreground="#A0A0A0" FontSize="10"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- RAM Mini -->
                <Border Grid.Row="1" Grid.Column="0" Background="#141414" CornerRadius="5" Padding="8,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Text="RAM" Foreground="#707070" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Dashboard.RamPercentValue, StringFormat={}{0:F0}%}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding Dashboard.RamDisplay}" Foreground="#A0A0A0" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </Grid>
                </Border>

                <!-- VRAM Mini -->
                <Border Grid.Row="1" Grid.Column="2" Background="#141414" CornerRadius="5" Padding="8,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Text="VRAM" Foreground="#707070" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Dashboard.VramPercentValue, StringFormat={}{0:F0}%}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding Dashboard.VramDisplay}" Foreground="#A0A0A0" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Line -->
            <Rectangle Grid.Row="3" Height="1" Fill="#222222" Margin="0,0,0,8"/>

            <!-- 3. Prominent "Вернуть" Button -->
            <Button Grid.Row="4"
                    Click="OnRestoreClicked"
                    Style="{StaticResource MinimalButton}"
                    Background="#1E1E1E"
                    BorderBrush="#383838"
                    Foreground="#FFFFFF"
                    FontWeight="Bold"
                    FontSize="12"
                    Height="32"
                    HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="🗖" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Вернуть" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</Window>