<UserControl x:Class="RenderWatch.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16,24,24" MaxWidth="760" HorizontalAlignment="Left">

            <!-- Title -->
            <TextBlock Text="НАСТРОЙКИ СИСТЕМЫ" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,16"/>

            <!-- 1. Polling Intervals -->
            <Border Background="{StaticResource BrushSurfaceCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Интервалы адаптивного опроса оборудования" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="В режиме простоя (сек):" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding PollingIntervalIdleSec}" Width="80" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="При активном рендере (сек):" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding PollingIntervalRenderingSec}" Width="80" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid>
                        <TextBlock Text="В свёрнутом / фоновом режиме (сек):" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding PollingIntervalBackgroundSec}" Width="80" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2. Notification Thresholds -->
            <Border Background="{StaticResource BrushSurfaceCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Пороги предупреждений и детекция зависания" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Макс. температура CPU (°C):" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding CpuTempThresholdC}" Width="80" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Макс. температура GPU (°C):" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding GpuTempThresholdC}" Width="80" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Порог памяти RAM (%):" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding RamThresholdPercent}" Width="80" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Порог видеопамяти VRAM (%):" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding VramThresholdPercent}" Width="80" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid>
                        <TextBlock Text="Время ожидания отклика до подозрения на зависание (сек):" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding HangTimeoutSec}" Width="80" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. Notification Toggles -->
            <Border Background="{StaticResource BrushSurfaceCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Уведомления" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,14"/>

                    <CheckBox Content="Включить всплывающие уведомления" IsChecked="{Binding EnableNotifications}" Margin="0,0,0,10" Foreground="{StaticResource BrushTextSecondary}"/>
                    <CheckBox Content="Уведомлять о завершении рендера" IsChecked="{Binding NotifyOnCompleted}" Margin="0,0,0,10" Foreground="{StaticResource BrushTextSecondary}"/>
                    <CheckBox Content="Уведомлять о подозрении на зависание" IsChecked="{Binding NotifyOnHang}" Margin="0,0,0,10" Foreground="{StaticResource BrushTextSecondary}"/>
                    <CheckBox Content="Уведомлять о неожиданном падении процесса" IsChecked="{Binding NotifyOnCrash}" Foreground="{StaticResource BrushTextSecondary}"/>
                </StackPanel>
            </Border>

            <!-- 4. Window & Startup Behavior -->
            <Border Background="{StaticResource BrushSurfaceCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Поведение приложения и трей" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,14"/>

                    <CheckBox Content="Сворачивать в системный трей" IsChecked="{Binding MinimizeToTray}" Margin="0,0,0,10" Foreground="{StaticResource BrushTextSecondary}"/>
                    <CheckBox Content="Закрывать окно в системный трей вместо выхода" IsChecked="{Binding CloseToTray}" Margin="0,0,0,10" Foreground="{StaticResource BrushTextSecondary}"/>
                    <CheckBox Content="Запускать RENDER WATCH вместе с Windows" IsChecked="{Binding StartWithWindows}" Foreground="{StaticResource BrushTextSecondary}"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal">
                <Button Content="Сохранить настройки" Command="{Binding SaveCommand}" Style="{StaticResource AccentButton}" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BrushAccentLime}" VerticalAlignment="Center" FontSize="13"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>