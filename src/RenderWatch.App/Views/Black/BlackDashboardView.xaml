<UserControl x:Class="RenderWatch.App.Views.Black.BlackDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RenderWatch.App.Views"
             xmlns:ctrl="clr-namespace:RenderWatch.App.Controls">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PCWatch;component/Styles/BlackTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>


        <Style x:Key="ColorDial" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsColorStyle, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BlackReadout" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsColorStyle, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HardwareUsage" TargetType="TextBlock" BasedOn="{StaticResource BlackReadout}">
            <Setter Property="FontSize" Value="36"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="TemperatureValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsColorStyle, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="FontSize" Value="21"/>
                    <Setter Property="HorizontalAlignment" Value="Left"/>
                    <Setter Property="Margin" Value="18,0,0,0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ColorTemperatureIcon" TargetType="Path">
            <Setter Property="Data" Value="{StaticResource IconTemperature}"/>
            <Setter Property="Stroke" Value="{x:Static ctrl:TelemetryPalette.Orange}"/>
            <Setter Property="StrokeThickness" Value="1.2"/>
            <Setter Property="Width" Value="11"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsColorStyle, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DialReading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F2F5F7"/>
            <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
            <Setter Property="FontSize" Value="27"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DialLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A8AFB8"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>


        <!-- White Miniature Hardware Icons -->
        <Geometry x:Key="IconFan">M 12,12 m -10,0 a 10,10 0 1 0 20,0 a 10,10 0 1 0 -20,0 M 12,9.5 C 12,6 14,4 17,4 C 15.5,6.5 14.5,8 14.5,9.5 M 14.5,12 C 18,12 20,14 20,17 C 17.5,15.5 16,14.5 14.5,14.5 M 12,14.5 C 12,18 10,20 7,20 C 8.5,17.5 9.5,16 9.5,14.5 M 9.5,12 C 6,12 4,10 4,7 C 6.5,8.5 8,9.5 9.5,9.5 M 12,12 m -2.5,0 a 2.5,2.5 0 1 0 5,0 a 2.5,2.5 0 1 0 -5,0</Geometry>

        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,0,24,24">

            <Grid Height="{StaticResource BlackOverviewHeaderHeight}">
                <DockPanel Margin="0,18,8,22">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SystemPowerReadout" Text="{Binding SystemPowerText}" Foreground="#F2F2F2" FontSize="16"
                                   MinWidth="86" Margin="16,0,28,0" TextAlignment="Right" Typography.NumeralAlignment="Tabular"
                                   ToolTip="{Binding SystemPowerHint}" AutomationProperties.HelpText="{Binding SystemPowerHint}"/>
                        <TextBlock x:Name="UptimeReadout" Text="{Binding Uptime}" Foreground="#F2F2F2" FontSize="16"
                                   Typography.NumeralAlignment="Tabular" ToolTip="Время работы компьютера"/>
                    </StackPanel>
                    <TextBlock Text="Обзор системы" Style="{DynamicResource PageTitle}" VerticalAlignment="Center"/>
                </DockPanel>
            </Grid>

            <!-- 3. Equipment Cards Grid (CPU, GPU, RAM, VRAM) with White Miniature Icons & Larger Digits -->
            <UniformGrid x:Name="HardwareCards" Columns="4" SizeChanged="OnHardwareCardsSizeChanged" Margin="0,0,0,6">
                <!-- CPU Card -->
                <Border Style="{StaticResource BlackCard}" Padding="18" Margin="0,0,8,10">
                    <StackPanel>
                        <!-- Header with White Miniature Icon -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" Background="#181818" BorderBrush="#2C2C2C" BorderThickness="0" CornerRadius="5" Margin="0,0,10,0">
                                <Path Data="{StaticResource IconCpu}" Stroke="#FFFFFF" StrokeThickness="1.4" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="ПРОЦЕССОР" Foreground="#707070" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource FontDisplay}"/>
                                <TextBlock Text="CPU" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>

                        <!-- Usage -->
                        <Grid Style="{StaticResource ColorDial}" Width="112" Height="112" HorizontalAlignment="Center" Margin="0,2,0,10">
                            <ctrl:UsageRing Value="{Binding CpuPercentValue}" AutomationProperties.Name="Нагрузка CPU"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding CpuUsageMicro}" Style="{StaticResource DialReading}"/>
                                <TextBlock Text="Загрузка" Style="{StaticResource DialLabel}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding CpuUsageDisplay}" Foreground="#FFFFFF" FontWeight="Normal" FontFamily="{StaticResource FontDisplay}" Style="{StaticResource HardwareUsage}"/>
                        <ctrl:MiniBarGauge Style="{StaticResource BlackReadout}" Value="{Binding CpuPercentValue}" MaxValue="100" Height="3" HorizontalAlignment="Stretch" Margin="0,0,0,16"/>

                        <!-- Temperature -->
                        <Grid Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource BlackReadout}" Text="Температура" Foreground="#A0A0A0" FontSize="13" VerticalAlignment="Center"/>
                            <Path Style="{StaticResource ColorTemperatureIcon}" ToolTip="Температура CPU"/>
                            <TextBlock Text="{Binding CpuTempDisplay}" Style="{StaticResource TemperatureValue}"/>
                        </Grid>

                        <!-- Clock Frequency -->
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Частота" Foreground="#A0A0A0" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CpuClockDisplay}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="14" FontFamily="{StaticResource FontDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Power Watts -->
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="Мощность" Foreground="#A0A0A0" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CpuPowerDisplay}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="14" FontFamily="{StaticResource FontDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- GPU Card -->
                <Border Style="{StaticResource BlackCard}" Padding="18" Margin="0,0,8,10">
                    <StackPanel>
                        <!-- Header with White Miniature Icon -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" Background="#181818" BorderBrush="#2C2C2C" BorderThickness="0" CornerRadius="5" Margin="0,0,10,0">
                                <Path Data="{StaticResource IconGpu}" Stroke="#FFFFFF" StrokeThickness="1.4" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding GpuName}" TextTrimming="CharacterEllipsis" Foreground="#707070" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource FontDisplay}"/>
                                <TextBlock Text="GPU" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>

                        <!-- Usage -->
                        <Grid Style="{StaticResource ColorDial}" Width="112" Height="112" HorizontalAlignment="Center" Margin="0,2,0,10">
                            <ctrl:UsageRing Value="{Binding GpuPercentValue}" AutomationProperties.Name="Нагрузка GPU"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding GpuUsageMicro}" Style="{StaticResource DialReading}"/>
                                <TextBlock Text="Загрузка" Style="{StaticResource DialLabel}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding GpuUsageDisplay}" Foreground="#FFFFFF" FontWeight="Normal" FontFamily="{StaticResource FontDisplay}" Style="{StaticResource HardwareUsage}"/>
                        <ctrl:MiniBarGauge Style="{StaticResource BlackReadout}" Value="{Binding GpuPercentValue}" MaxValue="100" Height="3" HorizontalAlignment="Stretch" Margin="0,0,0,16"/>

                        <!-- Temperature -->
                        <Grid Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource BlackReadout}" Text="Температура" Foreground="#A0A0A0" FontSize="13" VerticalAlignment="Center"/>
                            <Path Style="{StaticResource ColorTemperatureIcon}" ToolTip="Температура GPU"/>
                            <TextBlock Text="{Binding GpuTempDisplay}" Style="{StaticResource TemperatureValue}"/>
                        </Grid>

                        <!-- Clock Frequency -->
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Частота" Foreground="#A0A0A0" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding GpuClockDisplay}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="14" FontFamily="{StaticResource FontDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Power Watts -->
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="Мощность" Foreground="#A0A0A0" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding GpuPowerDisplay}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="14" FontFamily="{StaticResource FontDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- RAM Card -->
                <Border Style="{StaticResource BlackCard}" Padding="18" Margin="0,0,8,10">
                    <StackPanel>
                        <!-- Header with White Miniature Icon -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" Background="#181818" BorderBrush="#2C2C2C" BorderThickness="0" CornerRadius="5" Margin="0,0,10,0">
                                <Path Data="{StaticResource IconRam}" Stroke="#FFFFFF" StrokeThickness="1.4" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="ПАМЯТЬ" Foreground="#707070" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource FontDisplay}"/>
                                <TextBlock Text="RAM" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>

                        <!-- Usage Percent -->
                        <Grid Style="{StaticResource ColorDial}" Width="112" Height="112" HorizontalAlignment="Center" Margin="0,2,0,10">
                            <ctrl:UsageRing Value="{Binding RamPercentValue}" AutomationProperties.Name="Использование RAM"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding RamPercentValue, StringFormat={}{0:F0}%}" Style="{StaticResource DialReading}"/>
                                <TextBlock Text="Занято" Style="{StaticResource DialLabel}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding RamPercentValue, StringFormat={}{0:F0}%}" Foreground="#FFFFFF" FontWeight="Normal" FontFamily="{StaticResource FontDisplay}" Style="{StaticResource HardwareUsage}"/>
                        <ctrl:MiniBarGauge Style="{StaticResource BlackReadout}" Value="{Binding RamPercentValue}" MaxValue="100" Height="3" HorizontalAlignment="Stretch" Margin="0,0,0,16"/>

                        <!-- Volume -->
                        <TextBlock Text="Занято / Всего:" Foreground="#A0A0A0" FontSize="13" Margin="0,0,0,6"/>
                        <TextBlock Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="14" FontFamily="{StaticResource FontDisplay}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding RamDisplay}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsColorStyle, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Text" Value="{Binding RamCapacityDisplay}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- VRAM Card -->
                <Border Style="{StaticResource BlackCard}" Padding="18" Margin="0,0,8,10">
                    <StackPanel>
                        <!-- Header with White Miniature Icon -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" Background="#181818" BorderBrush="#2C2C2C" BorderThickness="0" CornerRadius="5" Margin="0,0,10,0">
                                <Path Data="{StaticResource IconVram}" Stroke="#FFFFFF" StrokeThickness="1.4" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="ВИДЕОПАМЯТЬ" Foreground="#707070" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource FontDisplay}"/>
                                <TextBlock Text="VRAM" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>

                        <!-- Usage Percent -->
                        <Grid Style="{StaticResource ColorDial}" Width="112" Height="112" HorizontalAlignment="Center" Margin="0,2,0,10">
                            <ctrl:UsageRing Value="{Binding VramPercentValue}" AutomationProperties.Name="Использование VRAM"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding VramPercentValue, StringFormat={}{0:F0}%}" Style="{StaticResource DialReading}"/>
                                <TextBlock Text="Занято" Style="{StaticResource DialLabel}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding VramPercentValue, StringFormat={}{0:F0}%}" Foreground="#FFFFFF" FontWeight="Normal" FontFamily="{StaticResource FontDisplay}" Style="{StaticResource HardwareUsage}"/>
                        <ctrl:MiniBarGauge Style="{StaticResource BlackReadout}" Value="{Binding VramPercentValue}" MaxValue="100" Height="3" HorizontalAlignment="Stretch" Margin="0,0,0,16"/>

                        <!-- Volume -->
                        <TextBlock Text="Занято / Всего:" Foreground="#A0A0A0" FontSize="13" Margin="0,0,0,6"/>
                        <TextBlock Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="14" FontFamily="{StaticResource FontDisplay}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding VramDisplay}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsColorStyle, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Text" Value="{Binding VramCapacityDisplay}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <views:BatteryCard Margin="0,0,0,12">
                <views:BatteryCard.Style>
                    <Style TargetType="views:BatteryCard">
                        <Setter Property="Background" Value="{StaticResource BrushSurfaceCard}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsColorStyle, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ColorCardFill}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:BatteryCard.Style>
            </views:BatteryCard>

            <Grid Margin="0,0,0,16" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource BlackCard}" Padding="16,12" Margin="0,0,6,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="103"/>
                                <ColumnDefinition Width="103"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ДИСКИ" Foreground="#909090" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource FontDisplay}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Чтение" Style="{StaticResource ActivityColumnHeader}" Margin="6,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="Запись" Style="{StaticResource ActivityColumnHeader}" Margin="6,0,0,0"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding PhysicalDisks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="103"/>
                                            <ColumnDefinition Width="103"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Foreground="#F0F0F0" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Read}" Style="{StaticResource ActivityRate}" FontWeight="SemiBold" Margin="6,0,0,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Write}" Style="{StaticResource ActivityRate}" FontWeight="SemiBold" Margin="6,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Нет данных по дискам" Foreground="#909090" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PhysicalDisks.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource BlackCard}" Padding="16,12" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="СЕТЬ" Foreground="#909090" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource FontDisplay}"/>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Получение" Foreground="#A0A0A0" FontSize="12" VerticalAlignment="Center"/>
                            <ctrl:MetricSparkline Grid.Column="1" Height="30" MaxValue="{Binding DataContext.SessionMetrics.NetworkReceiveScale, RelativeSource={RelativeSource AncestorType=Window}}" Capacity="40" Margin="4,0,9,0"
                                ToolTip="{Binding DataContext.SessionMetrics.NetworkReceiveScaleDisplay, RelativeSource={RelativeSource AncestorType=Window}}"
                                Points="{Binding DataContext.SessionMetrics.NetworkReceive, RelativeSource={RelativeSource AncestorType=Window}}"
                                AutomationProperties.Name="Сеть · Получение"/>
                            <TextBlock Grid.Column="2" Text="{Binding NetworkReceive}" Style="{StaticResource ActivityRate}" FontSize="14" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Отправка" Foreground="#A0A0A0" FontSize="12" VerticalAlignment="Center"/>
                            <ctrl:MetricSparkline Grid.Column="1" Height="30" MaxValue="{Binding DataContext.SessionMetrics.NetworkSendScale, RelativeSource={RelativeSource AncestorType=Window}}" Capacity="40" Margin="4,0,9,0"
                                ToolTip="{Binding DataContext.SessionMetrics.NetworkSendScaleDisplay, RelativeSource={RelativeSource AncestorType=Window}}"
                                Points="{Binding DataContext.SessionMetrics.NetworkSend, RelativeSource={RelativeSource AncestorType=Window}}"
                                AutomationProperties.Name="Сеть · Отправка"/>
                            <TextBlock Grid.Column="2" Text="{Binding NetworkSend}" Style="{StaticResource ActivityRate}" FontSize="14" FontWeight="SemiBold"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
            <!-- 4. Cooling System Card (Fans, RPM & Roles) - Compact & Laconic -->
            <Border Style="{StaticResource BlackCard}" Padding="16,14" Margin="0,0,0,16">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon Badge -->
                        <Border Grid.Column="0" Width="30" Height="30" Background="#181818" BorderBrush="#2C2C2C" BorderThickness="0" CornerRadius="5" Margin="0,0,10,0">
                            <Path Data="{StaticResource IconFan}" Stroke="#FFFFFF" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Title -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Охлаждение" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource FontDisplay}"/>
                        </StackPanel>

                    </Grid>

                    <!-- Fans Grid Categorized by Hardware (AIO Pump/Rad, GPU, Chassis, PSU, etc.) -->
                    <ItemsControl ItemsSource="{Binding FanGroups}" Visibility="{Binding HasFans, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,6">
                                    <!-- Group Category Header -->
                                    <Border Margin="0,4,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding GroupName}" Foreground="#8A8A8A" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource FontDisplay}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <Rectangle Grid.Column="1" Height="1" Fill="#202020" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Fans in Group -->
                                    <ItemsControl ItemsSource="{Binding Fans}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="376" Background="#111111" BorderBrush="#252525" BorderThickness="0" CornerRadius="5" Padding="12,10" Margin="0,0,12,10">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Top Row: Role, Name & RPM Display -->
                                                        <Grid Grid.Row="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayName}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>

                                                            <!-- Speed / RPM (Pure white, bold) -->
                                                            <TextBlock Grid.Column="1" Text="{Binding RpmDisplay}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" FontFamily="{StaticResource FontDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                        </Grid>

                                                        <!-- Bottom Row: Speed MiniBarGauge (Subtle and Clean) -->
                                                        <ctrl:MiniBarGauge Grid.Row="1" Value="{Binding PercentValue}" MaxValue="100" Height="3" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Fallback Banner (Visible when HasFans == False) -->
                    <Border Visibility="{Binding HasFans, Converter={StaticResource InverseBoolToVis}}" Background="#111111" BorderBrush="#252525" BorderThickness="0" CornerRadius="5" Padding="14,10">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="26" Height="26" Background="#1A1A1A" CornerRadius="4" Margin="0,0,10,0">
                                <Path Data="{StaticResource IconFan}" Stroke="#707070" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Нет данных о вентиляторах" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 5. Settings & Preferences Grid (Autostart + Taskbar Theme) -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 1: Автозапуск с Windows -->
                <Border Grid.Column="0" Style="{StaticResource BlackCard}" Padding="18,16" Margin="0,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Description -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="АВТОЗАПУСК С WINDOWS" Foreground="#707070" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource FontDisplay}" Margin="0,0,0,3"/>
                            <TextBlock Text="Запуск на панель задач при входе в систему (без окна UAC)" Foreground="#D0D0D0" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Segmented Switcher [Включен] [Отключен] -->
                        <Border Grid.Column="1" Background="#1C1C1C" BorderBrush="#2C2C2C" BorderThickness="0" CornerRadius="5" Padding="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <!-- Enable Button -->
                                <Button Content="Включен"
                                        Command="{Binding SetAutostartCommand}"
                                        CommandParameter="true"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="#888888"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="14,6"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StartWithWindows}" Value="True">
                                                    <Setter Property="Background" Value="#2E2E2E"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Disable Button -->
                                <Button Content="Отключен"
                                        Command="{Binding SetAutostartCommand}"
                                        CommandParameter="false"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="#888888"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="14,6"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StartWithWindows}" Value="False">
                                                    <Setter Property="Background" Value="#2E2E2E"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 2: Цветовая тема панели задач -->
                <Border Grid.Column="1" Style="{StaticResource BlackCard}" Padding="18,16" Margin="8,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Description -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="ЦВЕТОВАЯ ТЕМА ПАНЕЛИ ЗАДАЧ" Foreground="#707070" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource FontDisplay}" Margin="0,0,0,3"/>
                            <TextBlock Text="Цвет цифр виджета для тёмной или светлой темы" Foreground="#D0D0D0" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Right: Minimalist Segmented Switcher -->
                        <Border Grid.Column="1" Background="#1C1C1C" BorderBrush="#2C2C2C" BorderThickness="0" CornerRadius="5" Padding="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <!-- Dark Theme Button -->
                                <Button Content="Тёмная"
                                        Command="{Binding SetTaskbarStripThemeCommand}"
                                        CommandParameter="dark"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="#888888"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="14,6"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTaskbarStripDarkMode}" Value="True">
                                                    <Setter Property="Background" Value="#2E2E2E"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Light Theme Button -->
                                <Button Content="Светлая"
                                        Command="{Binding SetTaskbarStripThemeCommand}"
                                        CommandParameter="light"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="#888888"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="14,6"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTaskbarStripLightMode}" Value="True">
                                                    <Setter Property="Background" Value="#E0E0E0"/>
                                                    <Setter Property="Foreground" Value="#111111"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 6. Bottom Sensor Details Badge -->
            <Border Background="#121212" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0" CornerRadius="5" Padding="16,12">
                <Grid>
                    <TextBlock Text="Активные датчики телеметрии:" Foreground="{StaticResource BrushTextMuted}" FontSize="12"/>
                    <TextBlock Text="{Binding SensorSources}" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <!-- 1. Top Control Bar (Polling Interval Switcher & Session Controls) -->
            <Border Style="{StaticResource BlackCard}" Padding="16,10" Margin="0,4,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Left: Polling Interval Switcher (1s, 3s, 5s) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Интервал опроса:" Foreground="{StaticResource BrushTextMuted}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>

                        <!-- 0.1s Button -->
                        <Button Content="0.1 сек"
                                Command="{Binding DataContext.SetIntervalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="0.1">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MinimalButton}">
                                    <Setter Property="Padding" Value="12,5"/>
                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsIntervalTenthSec, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                            <Setter Property="Foreground" Value="#0A0A0A"/>
                                            <Setter Property="BorderBrush" Value="#FFFFFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- 0.5s Button -->
                        <Button Content="0.5 сек"
                                Command="{Binding DataContext.SetIntervalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="0.5">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MinimalButton}">
                                    <Setter Property="Padding" Value="12,5"/>
                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsIntervalHalfSec, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                            <Setter Property="Foreground" Value="#0A0A0A"/>
                                            <Setter Property="BorderBrush" Value="#FFFFFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- 1s Button -->
                        <Button Content="1 сек"
                                Command="{Binding DataContext.SetIntervalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="1">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MinimalButton}">
                                    <Setter Property="Padding" Value="14,5"/>
                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsInterval1Sec, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                            <Setter Property="Foreground" Value="#0A0A0A"/>
                                            <Setter Property="BorderBrush" Value="#FFFFFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- 3s Button -->
                        <Button Content="3 сек"
                                Command="{Binding DataContext.SetIntervalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="3">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MinimalButton}">
                                    <Setter Property="Padding" Value="14,5"/>
                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsInterval3Sec, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                            <Setter Property="Foreground" Value="#0A0A0A"/>
                                            <Setter Property="BorderBrush" Value="#FFFFFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- 5s Button -->
                        <Button Content="5 сек"
                                Command="{Binding DataContext.SetIntervalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="5">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MinimalButton}">
                                    <Setter Property="Padding" Value="14,5"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsInterval5Sec, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                            <Setter Property="Foreground" Value="#0A0A0A"/>
                                            <Setter Property="BorderBrush" Value="#FFFFFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
