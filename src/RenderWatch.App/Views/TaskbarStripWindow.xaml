<Window x:Class="RenderWatch.App.Views.TaskbarStripWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RENDER WATCH Micro"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Taskbar Strip Text & Separator Styles (Dynamic Light / Dark Taskbar support) -->
        <Style x:Key="StripLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8AFFFFFF"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTaskbarStripLightMode}" Value="True">
                    <Setter Property="Foreground" Value="#555555"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StripTempStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DCDCDC"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTaskbarStripLightMode}" Value="True">
                    <Setter Property="Foreground" Value="#222222"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StripBoldStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTaskbarStripLightMode}" Value="True">
                    <Setter Property="Foreground" Value="#0A0A0A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StripSeparatorStyle" TargetType="Rectangle">
            <Setter Property="Fill" Value="#28FFFFFF"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTaskbarStripLightMode}" Value="True">
                    <Setter Property="Fill" Value="#25000000"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Transparent native-style Taskbar Micro Button / Pill -->
    <Border x:Name="MicroPill"
            CornerRadius="5"
            Padding="0"
            Height="36"
            Margin="0"
            Cursor="Hand"
            Background="#01000000"
            BorderBrush="Transparent"
            BorderThickness="0"
            MouseLeftButtonDown="OnPillMouseLeftButtonDown"
            MouseMove="OnPillMouseMove"
            MouseLeftButtonUp="OnPillMouseLeftButtonUp">

        <Border.ContextMenu>
            <ContextMenu Background="#101010" BorderBrush="#262626" BorderThickness="1">
                <MenuItem Header="Открыть RENDER WATCH" FontWeight="Bold" Foreground="#FFFFFF" Click="OnContextMenuRestoreClicked"/>
                <Separator Background="#222222"/>
                <MenuItem Header="Тема: Тёмная (белый текст)" Command="{Binding SetTaskbarStripThemeCommand}" CommandParameter="dark" Foreground="#D0D0D0"/>
                <MenuItem Header="Тема: Светлая (чёрный текст)" Command="{Binding SetTaskbarStripThemeCommand}" CommandParameter="light" Foreground="#D0D0D0"/>
                <Separator Background="#222222"/>
                <MenuItem Header="Свернуть в трей" Foreground="#D0D0D0" Click="OnContextMenuTrayClicked"/>
                <MenuItem Header="Сбросить позицию к трею" Foreground="#999999" Click="OnContextMenuResetPosClicked"/>
                <Separator Background="#222222"/>
                <MenuItem Header="Закрыть RENDER WATCH" Foreground="#FF6B6B" Click="OnContextMenuExitClicked"/>
            </ContextMenu>
        </Border.ContextMenu>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch">

            <!-- 1. CPU SEGMENT (Icon + CPU + Temp + Load) -->
            <Border x:Name="CpuSegment"
                    CornerRadius="5,0,0,5"
                    Padding="10,0,9,0"
                    VerticalAlignment="Stretch"
                    Cursor="Hand"
                    ToolTipService.InitialShowDelay="60"
                    ToolTipService.BetweenShowDelay="30"
                    ToolTipService.ShowDuration="30000"
                    ToolTipService.Placement="Top"
                    ToolTipService.VerticalOffset="-6">

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#01000000"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsTaskbarStripLightMode}" Value="True"/>
                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="#1A000000"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Border.ToolTip>
                    <ToolTip Background="Transparent" BorderThickness="0" Padding="0" HasDropShadow="True">
                        <Border Background="#0E0E0E"
                                BorderBrush="#2A2A2A"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12"
                                Width="285"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.85"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- Header -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Source="/Assets/app.png" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="ПРОЦЕССОР (CPU)" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#1C1C1C" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                                        <TextBlock Text="ИНФО" Foreground="#A0A0A0" FontSize="9" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>

                                <!-- Full CPU Name -->
                                <TextBlock Text="{Binding Configuration.Config.CpuName}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,9"/>

                                <Rectangle Height="1" Fill="#202020" Margin="0,0,0,8"/>

                                <!-- Specs & Metrics -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Температура:" Foreground="#8A8A8A" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Dashboard.CpuTempDisplay}" Foreground="#DCDCDC" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Загрузка ядер:" Foreground="#8A8A8A" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Dashboard.CpuUsageDisplay}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Текущая частота:" Foreground="#8A8A8A" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Dashboard.CpuClockDisplay}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Энергопотребление:" Foreground="#8A8A8A" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Dashboard.CpuPowerDisplay}" Foreground="#DCDCDC" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Ядра и потоки:" Foreground="#8A8A8A" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Configuration.Config.CpuCoresThreads}" Foreground="#FFFFFF" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Сокет платформы:" Foreground="#8A8A8A" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Configuration.Config.CpuSocket}" Foreground="#DCDCDC" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>

                                <Rectangle Height="1" Fill="#202020" Margin="0,6,0,7"/>
                                <TextBlock Text="Клик — развернуть • Зажать — переместить" Foreground="#5A5A5A" FontSize="9" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ToolTip>
                </Border.ToolTip>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/app.png" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="CPU" Style="{StaticResource StripLabelStyle}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding Dashboard.CpuTempMicro}" Style="{StaticResource StripTempStyle}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <TextBlock Text="{Binding Dashboard.CpuUsageMicro}" Style="{StaticResource StripBoldStyle}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Separator -->
            <Rectangle Width="1" Height="14" Style="{StaticResource StripSeparatorStyle}" Margin="0" VerticalAlignment="Center"/>

            <!-- 2. GPU SEGMENT (GPU + Temp + Load) -->
            <Border x:Name="GpuSegment"
                    CornerRadius="0"
                    Padding="9,0,9,0"
                    VerticalAlignment="Stretch"
                    Cursor="Hand"
                    ToolTipService.InitialShowDelay="60"
                    ToolTipService.BetweenShowDelay="30"
                    ToolTipService.ShowDuration="30000"
                    ToolTipService.Placement="Top"
                    ToolTipService.VerticalOffset="-6">

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#01000000"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsTaskbarStripLightMode}" Value="True"/>
                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="#1A000000"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Border.ToolTip>
                    <ToolTip Background="Transparent" BorderThickness="0" Padding="0" HasDropShadow="True">
                        <Border Background="#0E0E0E"
                                BorderBrush="#2A2A2A"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12"
                                Width="285"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.85"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- Header -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Source="/Assets/app.png" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="ВИДЕОКАРТА (GPU)" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#1C1C1C" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                                        <TextBlock Text="ИНФО" Foreground="#A0A0A0" FontSize="9" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>

                                <!-- Full GPU Name -->
                                <TextBlock Text="{Binding Dashboard.GpuName}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,9"/>

                                <Rectangle Height="1" Fill="#202020" Margin="0,0,0,8"/>

                                <!-- Specs & Metrics -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Температура GPU:" Foreground="#8A8A8A" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Dashboard.GpuTempDisplay}" Foreground="#DCDCDC" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Загрузка чипа:" Foreground="#8A8A8A" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Dashboard.GpuUsageDisplay}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Частота ядра:" Foreground="#8A8A8A" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Dashboard.GpuClockDisplay}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Энергопотребление:" Foreground="#8A8A8A" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Dashboard.GpuPowerDisplay}" Foreground="#DCDCDC" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Видеопамять (VRAM):" Foreground="#8A8A8A" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Dashboard.VramDisplay}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Версия драйвера:" Foreground="#8A8A8A" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Configuration.Config.PrimaryGpuDriver}" Foreground="#DCDCDC" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>

                                <Rectangle Height="1" Fill="#202020" Margin="0,6,0,7"/>
                                <TextBlock Text="Клик — развернуть • Зажать — переместить" Foreground="#5A5A5A" FontSize="9" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ToolTip>
                </Border.ToolTip>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="GPU" Style="{StaticResource StripLabelStyle}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding Dashboard.GpuTempMicro}" Style="{StaticResource StripTempStyle}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <TextBlock Text="{Binding Dashboard.GpuUsageMicro}" Style="{StaticResource StripBoldStyle}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Separator -->
            <Rectangle Width="1" Height="14" Style="{StaticResource StripSeparatorStyle}" Margin="0" VerticalAlignment="Center"/>

            <!-- 3. RAM SEGMENT (RAM + Percent) -->
            <Border x:Name="RamSegment"
                    CornerRadius="0,5,5,0"
                    Padding="9,0,10,0"
                    VerticalAlignment="Stretch"
                    Cursor="Hand"
                    ToolTipService.InitialShowDelay="60"
                    ToolTipService.BetweenShowDelay="30"
                    ToolTipService.ShowDuration="30000"
                    ToolTipService.Placement="Top"
                    ToolTipService.VerticalOffset="-6">

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#01000000"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsTaskbarStripLightMode}" Value="True"/>
                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="#1A000000"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Border.ToolTip>
                    <ToolTip Background="Transparent" BorderThickness="0" Padding="0" HasDropShadow="True">
                        <Border Background="#0E0E0E"
                                BorderBrush="#2A2A2A"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12"
                                Width="285"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.85"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- Header -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Source="/Assets/app.png" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="ОПЕРАТИВНАЯ ПАМЯТЬ" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#1C1C1C" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Configuration.Config.RamChannelBadge}" Foreground="#A0A0A0" FontSize="9" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>

                                <!-- Total Capacity & Summary -->
                                <TextBlock Text="{Binding Dashboard.RamDisplay}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,9"/>

                                <Rectangle Height="1" Fill="#202020" Margin="0,0,0,8"/>

                                <!-- Specs & Metrics -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Занято памяти:" Foreground="#8A8A8A" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Dashboard.RamUsedDisplay}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Свободно памяти:" Foreground="#8A8A8A" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Dashboard.RamAvailableDisplay}" Foreground="#DCDCDC" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Всего в системе:" Foreground="#8A8A8A" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Dashboard.RamTotalDisplay}" Foreground="#DCDCDC" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Процент нагрузки:" Foreground="#8A8A8A" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Dashboard.RamPercentDisplay}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Тип и частота:" Foreground="#8A8A8A" FontSize="11"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Configuration.Config.RamType}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding Configuration.Config.RamSpeed}" Foreground="#DCDCDC" FontSize="11"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Слоты памяти:" Foreground="#8A8A8A" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Configuration.Config.RamSlotsUsed}" Foreground="#DCDCDC" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>

                                <Rectangle Height="1" Fill="#202020" Margin="0,6,0,7"/>
                                <TextBlock Text="Клик — развернуть • Зажать — переместить" Foreground="#5A5A5A" FontSize="9" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ToolTip>
                </Border.ToolTip>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="RAM" Style="{StaticResource StripLabelStyle}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding Dashboard.RamPercentDisplay}" Style="{StaticResource StripBoldStyle}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </Border>
</Window>
