<Window x:Class="RenderWatch.App.Views.TaskbarStripWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RenderWatch.App.Views"
        Title="PC Watch · Панель задач" Icon="/PCWatch;component/Assets/app.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PCWatch;component/Styles/BlackSurfaces.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="TaskbarContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="#2A2B2C"/>
            <Setter Property="BorderBrush" Value="#434445"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding UsesBlackLayout}" Value="True">
                    <Setter Property="Background" Value="#101010"/>
                    <Setter Property="BorderBrush" Value="#262626"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Transparent native-style Taskbar Micro Button / Pill -->
    <Border x:Name="MicroPill"
            Height="30"
            Margin="0"
            Cursor="Hand"
            MouseLeftButtonUp="OnPillMouseLeftButtonUp">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="#01000000"/>
                <Setter Property="CornerRadius" Value="5"/>
            </Style>
        </Border.Style>

        <Border.ContextMenu>
            <ContextMenu Style="{StaticResource TaskbarContextMenu}">
                <MenuItem Header="Открыть PC Watch" FontWeight="Bold" Foreground="#F5F2EA" Click="OnContextMenuRestoreClicked"/>
                <Separator Background="#404142"/>
                <MenuItem Header="Тема: Тёмная (белый текст)" Command="{Binding SetTaskbarStripThemeCommand}" CommandParameter="dark" Foreground="#D8D5CF"/>
                <MenuItem Header="Тема: Светлая (чёрный текст)" Command="{Binding SetTaskbarStripThemeCommand}" CommandParameter="light" Foreground="#D8D5CF"/>
                <Separator Background="#404142"/>
                <MenuItem Header="Автозапуск с Windows" Command="{Binding SetAutostartCommand}" Foreground="#D8D5CF"/>
                <MenuItem Header="Свернуть в трей" Foreground="#D8D5CF" Click="OnContextMenuTrayClicked"/>
                <MenuItem Header="Сбросить позицию к трею" Foreground="#BCBAB5" Click="OnContextMenuResetPosClicked"/>
                <Separator Background="#404142"/>
                <MenuItem Header="Закрыть PC Watch" Foreground="#BCBAB5" Click="OnContextMenuExitClicked"/>
            </ContextMenu>
        </Border.ContextMenu>

        <views:TaskbarStripContent/>
    </Border>
</Window>
